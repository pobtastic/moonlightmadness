 $F3C1 DEFB $DE,$1F,$14   ; PRINT AT: #N(#PEEK(#PC+$01)), #N(#PEEK(#PC+$02)).
 $F3C4 DEFM "COMBINATION" ; "#STR(#PC,$04,$0B)".
