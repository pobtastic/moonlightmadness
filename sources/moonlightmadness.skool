@label=Messaging_Event
t$F3A5 DEFB $DE,$1F,$16   ; PRINT AT: #N(#PEEK(#PC+$01)), #N(#PEEK(#PC+$02)).
 $F3A8 DEFM "THIS BUTTON" ; "#STR(#PC,$04,$0B)".
 $F3B3 DEFB $DE,$1F,$15   ; PRINT AT: #N(#PEEK(#PC+$01)), #N(#PEEK(#PC+$02)).
