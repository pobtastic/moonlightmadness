 $F20B SET 7,(IX+$00) ; Set bit 7 of the decoration record.
@label=Event_RevealThreeDecorations_Continue
*$F20F POP BC         ; Restore the count from the stack.
 $F210 LD DE,$0006    ; {Advance to the next decoration.
