 $F24C JR $F256      ; Jump to #R$F256.

; Event: Bump Digit Two
;
; Used by the routine at #R$EDD9.
; .
; Event #N$23: increment combination digit 2.
@label=Event_DigitTwo
c$F24E LD HL,$64C2   ; #REGhl=#R$64C2.
 $F251 JR $F256      ; Jump to #R$F256.

; Event: Bump Digit One
;
; Used by the routine at #R$EDD9.
; .
; Event #N$25: increment combination digit 1.
@label=Event_DigitOne
c$F253 LD HL,$64C1   ; #REGhl=#R$64C1.
; Continue on to #R$F256.

; Event: Bump Digit
;
; Used by the routines at #R$F244, #R$F249 and #R$F24E.
; .
; Increases *(#REGhl) and wraps at #N$0A.
@label=Event_BumpDigit
c$F256 LD BC,$2614   ; {Write #N$2614 to *#R$649F.
 $F259 LD ($649F),BC ; }
 $F25D LD A,(HL)     ; {Increase #REGa from *(#REGhl).
 $F25E INC A         ; }
 $F25F CP $0A        ; Compare it with #N$0A.
 $F261 LD (HL),A     ; Write it back.
 $F262 JP NZ,$ECF2   ; Jump to #R$ECF2 if it did not wrap.
 $F265 XOR A         ; {Write #N$00.
 $F266 LD (HL),A     ; }
 $F267 JP $ECF2      ; Jump to #R$ECF2.

; Event: Hide Later Actor
;
; Used by the routine at #R$EDD9.
; .
; Event #N$0D: hide a later actor.
@label=Event_HideLaterActor
c$F26A LD IX,($6430) ; {#REGix=*#R$6430+#N($0027,$04,$04).
 $F26E LD DE,$0027   ;
 $F271 ADD IX,DE     ; }
 $F273 LD A,(IX+$00) ; {Return if this actor is already hidden.
 $F276 BIT 7,A       ;
 $F278 RET NZ        ; }
 $F279 CALL $F45D    ; Call #R$F45D.
 $F27C LD A,(IX+$00) ; #REGa=the actor record.
 $F27F OR %10000000  ; Set bit 7.
 $F281 LD (IX+$00),A ; Hide the actor.
; Continue on to #R$F284.

; Clear Collision
;
; Used by the routine at #R$F28F.
; .
; Clears *#R$6434 after a collision.
