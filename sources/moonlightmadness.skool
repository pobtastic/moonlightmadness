@label=Event_TestHeader
c$F1B6 LD IX,($641E)  ; #REGix=*#R$641E.
 $F1BA LD DE,$0006    ; {Return if bit 7 of the next header record is
 $F1BD ADD IX,DE      ; clear.
 $F1BF BIT 7,(IX+$00) ;
 $F1C3 RET Z          ; }
; Continue on to #R$F1C4.

