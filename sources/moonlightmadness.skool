 $E958 DEFB $00,$00,$00,$00,$00,$00,$00,$00
 $E960 DEFB $00,$00,$00,$00,$00,$00,$00,$00
 $E968 DEFB $00,$00,$00,$00,$00,$00,$00,$00
 $E970 DEFB $00,$00,$00,$00,$00,$00,$00,$00
 $E978 DEFB $00,$00,$00,$00,$00,$00,$00,$00
 $E980 DEFB $00,$00,$00,$00,$00,$00,$00,$00
 $E988 DEFB $00,$00,$00,$00,$00,$00,$00,$00
 $E990 DEFB $00,$00,$00,$00,$00,$00,$00,$00
 $E998 DEFB $00,$00,$00,$00,$00,$00,$00,$00
 $E9A0 DEFB $00,$00,$00,$00,$00,$00,$00,$00
 $E9A8 DEFB $00,$00,$00,$00,$00,$00,$00,$00
 $E9B0 DEFB $00,$00,$00,$00,$00,$00,$00,$00
 $E9B8 DEFB $00,$00,$00,$00,$00,$00,$00,$00
 $E9C0 DEFB $00,$00,$00,$00,$00,$00,$00,$00
 $E9C8 DEFB $00,$00,$00,$00,$00,$00,$00,$00
 $E9D0 DEFB $00,$00,$00,$00,$00,$00,$00,$00
 $E9D8 DEFB $00,$00,$00,$00,$00,$00,$00,$00
 $E9E0 DEFB $00,$00,$00,$00,$00,$00,$00,$00
 $E9E8 DEFB $00,$00,$00,$00,$00,$00,$00,$00
 $E9F0 DEFB $00,$00,$00,$00,$00,$00,$00,$00
 $E9F8 DEFB $00,$00,$00,$00

; Initialise Rooms
;
; Used by the routine at #R$D738.
; .
; Jumps to #R$EA02 to unpack the #N$17 rooms from #R$BC11.
@label=Initialise_Rooms
c$E9FC JP $EA02      ; Jump to #R$EA02.
; View the equivalent code in #BOOTY$AA97.

; Dispatch Events
;
; Used by the routines at #R$D738, #R$D7D2, #R$DC26, #R$DD92 and #R$DE19.
; .
; Jumps to #R$EDD9 with the event ID in #REGa.
@label=Dispatch_Events
c$E9FF JP $EDD9      ; Jump to #R$EDD9.

; Unpack Rooms
;
; Used by the routine at #R$E9FC.
; .
; Builds #R$64C5 and copies each packed room into #R$64F7. #REGa=#N$FF
; initialises every room, otherwise it loads that room.
@label=Unpack_Rooms
c$EA02 CP $1E        ; {Return if #REGa is #N$1E.
 $EA04 RET Z         ; }
 $EA05 CP $FF        ; {Jump to #R$EAA6 unless #REGa is #N$FF.
 $EA07 JP NZ,$EAA6   ; }
 $EA0A CALL $ED51    ; Call #R$ED51.
 $EA0D LD HL,$7C70   ; {Write #R$7C70 to *#R$640E.
 $EA10 LD ($640E),HL ; }
 $EA13 CALL $ED71    ; Call #R$ED71.
 $EA16 LD HL,$0000   ; {Clear the collection and score words.
 $EA19 LD ($64BB),HL ;
 $EA1C LD ($64BD),HL ;
 $EA1F LD ($64BF),HL ;
 $EA22 LD ($64C1),HL ;
 $EA25 LD ($64C3),HL ; }
 $EA28 LD A,$04      ; {Write #N$04 to *#R$64B4.
 $EA2A LD ($64B4),A  ; }
 $EA2D LD ($6417),HL ; {Write #N$00 to *#R$64A1 and *#R$647D.
 $EA30 XOR A         ;
 $EA31 LD ($64A1),A  ;
 $EA34 LD ($647D),A  ; }
; Point at the packed rooms and the unpack buffers.
 $EA37 LD HL,$BC11   ; #REGhl=#R$BC11.
 $EA3A LD IX,$64C5   ; #REGix=#R$64C5.
 $EA3E LD DE,$64F7   ; #REGde=#R$64F7.
 $EA41 LD B,$17      ; #REGb=#N$17.
@label=Unpack_Rooms_Loop
*$EA43 PUSH BC       ; Stash the room count on the stack.
 $EA44 LD (IX+$00),E ; {Write the destination address into the next
 $EA47 INC IX        ; #R$64C5 slot.
 $EA49 LD (IX+$00),D ;
 $EA4C INC IX        ; }
 $EA4E LD A,(HL)     ; {Copy the room header byte.
 $EA4F LD (DE),A     ;
 $EA50 INC HL        ;
 $EA51 INC DE        ; }
 $EA52 LD BC,$0005   ; {Copy each header-furniture record.
 $EA55 CALL $EA9A    ; }
 $EA58 LD BC,$0004   ; {Copy each furniture record.
 $EA5B CALL $EA9A    ; }
 $EA5E LD BC,$0004   ; {Copy each door record.
 $EA61 CALL $EA9A    ; }
 $EA64 LD BC,$0002   ; {Copy each collectible record.
 $EA67 CALL $EA9A    ; }
 $EA6A LD BC,$0001   ; {Copy each inventory record.
 $EA6D CALL $EA9A    ; }
 $EA70 LD BC,$0002   ; {Copy each ladder record.
 $EA73 CALL $EA9A    ; }
 $EA76 LD BC,$0005   ; {Copy each decoration record.
 $EA79 CALL $EA9A    ; }
 $EA7C LD BC,$000C   ; {Copy each actor record.
 $EA7F CALL $EA9A    ; }
 $EA82 LD BC,$000D   ; {Copy each enemy record.
 $EA85 CALL $EA9A    ; }
 $EA88 LD BC,$0012   ; {Copy each moving-object record.
 $EA8B CALL $EA9A    ; }
 $EA8E POP BC        ; {Restore the room count and loop back to #R$EA43.
 $EA8F DJNZ $EA43    ; }
 $EA91 LD (IX+$00),E ; {Store the final pointer.
 $EA94 LD (IX+$01),D ; }
 $EA97 XOR A         ; #REGa=#N$00.
 $EA98 JR $EAA6      ; Jump to #R$EAA6.
@label=Copy_TerminatedField
*$EA9A LD A,(HL)     ; {Copy the next byte and advance both pointers.
 $EA9B LD (DE),A     ;
 $EA9C INC HL        ;
 $EA9D INC DE        ; }
 $EA9E INC A         ; {Return if that byte was #N$FF.
 $EA9F RET Z         ; }
; Copy the remaining bytes of this field.
 $EAA0 PUSH BC       ; Stash the count on the stack.
 $EAA1 LDIR          ; Copy the remaining #REGbc bytes.
 $EAA3 POP BC        ; Restore the count from the stack.
 $EAA4 JR $EA9A      ; Jump to #R$EA9A.
; Load the room in #REGa.
@label=Load_Room
*$EAA6 LD ($64A2),A  ; Write #REGa to *#R$64A2.
 $EAA9 AND %01111111 ; Keep only bits 0-6.
 $EAAB LD E,A        ; {Look up that room's pointer from #R$64C5.
 $EAAC LD D,$00      ;
 $EAAE LD HL,$64C5   ;
 $EAB1 ADD HL,DE     ;
 $EAB2 ADD HL,DE     ;
 $EAB3 LD E,(HL)     ;
 $EAB4 INC HL        ;
 $EAB5 LD D,(HL)     ;
 $EAB6 PUSH DE       ; }
 $EAB7 LD A,($64A2)  ; #REGa=*#R$64A2.
; Refresh the working copy when this room is not already
; current.
 $EABA BIT 7,A       ; {Jump to #R$EADD if bit 7 of *#R$64A2 is set.
 $EABC JR NZ,$EADD   ; }
 $EABE LD A,(DE)     ; #REGa=*#REGde.
 $EABF AND %10000000 ; Keep only bit 7.
 $EAC1 JR Z,$EADD    ; Jump to #R$EADD if the working copy is already
                     ; current.
 $EAC3 INC HL        ; {Fetch the next pointer and copy it to #REGhl.
 $EAC4 LD C,(HL)     ;
 $EAC5 INC HL        ;
 $EAC6 LD B,(HL)     ;
 $EAC7 LD L,C        ;
 $EAC8 LD H,B        ; }
 $EAC9 XOR A         ; {#REGbc=#REGhl-#REGde (length of this room).
 $EACA SBC HL,DE     ;
 $EACC LD C,L        ;
 $EACD LD B,H        ; }
 $EACE LD HL,$64F7   ; {Point #REGhl at #R$64F7 relative to the packed
 $EAD1 PUSH DE       ; source.
 $EAD2 XOR A         ;
 $EAD3 EX DE,HL      ;
 $EAD4 SBC HL,DE     ; }
 $EAD6 LD DE,$BC11   ; {Add #R$BC11 and copy the packed room into the
 $EAD9 ADD HL,DE     ; working buffer.
 $EADA POP DE        ;
 $EADB LDIR          ; }
@label=Load_Room_Draw
*$EADD LD A,($64A2)  ; {Clear bit 7 of *#R$64A2.
 $EAE0 RES 7,A       ;
 $EAE2 LD ($64A2),A  ; }
 $EAE5 POP IX        ; Restore the room pointer from the stack into
                     ; #REGix.
 $EAE7 LD HL,$7C70   ; {Write #R$7C70 to *#SKOOLKID$5C36(CHARS).
 $EAEA LD ($5C36),HL ; }
 $EAED CALL $ED51    ; Call #R$ED51.
 $EAF0 LD A,$01      ; {Write #INK$01 to *#R$641D and the border.
 $EAF2 LD ($641D),A  ;
 $EAF5 OUT ($FE),A   ; }
; Copy the matching font bank for this room.
 $EAF7 LD A,(IX+$00) ; #REGa=the room header.
 $EAFA AND %00110000 ; Keep only bits 4-5.
 $EAFC CALL Z,$ED2D  ; Call #R$ED2D if the font bank is #N$00.
 $EAFF CP $10        ; {Call #R$ED39 if the font bank is #N$10.
 $EB01 CALL Z,$ED39  ; }
 $EB04 CP $20        ; {Call #R$ED45 if the font bank is #N$20.
 $EB06 CALL Z,$ED45  ; }
 $EB09 INC IX        ; {Write #REGix to *#R$641E.
 $EB0B LD ($641E),IX ; }
; Draw each visible header-furniture record.
@label=Load_Room_Header
*$EB0F LD A,(IX+$00) ; {Jump to #R$EB22 if the terminator #N$FF is reached.
 $EB12 CP $FF        ;
 $EB14 JR Z,$EB22    ; }
 $EB16 BIT 7,A       ; {Call #R$EDB1 if this record is visible.
 $EB18 CALL Z,$EDB1  ; }
 $EB1B LD BC,$0006   ; {#REGix+=#N($0006,$04,$04).
 $EB1E ADD IX,BC     ; }
 $EB20 JR $EB0F      ; Jump to #R$EB0F.
; Draw each visible furniture record into *#R$6420.
@label=Load_Room_Furniture
*$EB22 INC IX        ; {Write #REGix to *#R$6420.
 $EB24 LD ($6420),IX ; }
@label=Load_Room_Furniture_Target
*$EB28 LD A,(IX+$00) ; {Jump to #R$EB3D if the terminator #N$FF is reached.
 $EB2B CP $FF        ;
 $EB2D JR Z,$EB3D    ; }
 $EB2F BIT 7,A       ; {Jump to #R$EB36 if this record is hidden.
 $EB31 JR NZ,$EB36   ; }
 $EB33 CALL $ED82    ; Call #R$ED82.
@label=Load_Room_Furniture_Continue
*$EB36 LD DE,$0005   ; {#REGix+=#N($0005,$04,$04).
 $EB39 ADD IX,DE     ; }
 $EB3B JR $EB28      ; Jump to #R$EB28.
; Draw each visible door record into *#R$6422.
@label=Load_Room_Doors
*$EB3D INC IX        ; {Write #REGix to *#R$6422.
 $EB3F LD ($6422),IX ; }
@label=Load_Room_Doors_Target
*$EB43 LD A,(IX+$00) ; {Jump to #R$EB58 if the terminator #N$FF is reached.
 $EB46 CP $FF        ;
 $EB48 JR Z,$EB58    ; }
 $EB4A BIT 7,A       ; {Jump to #R$EB51 if this record is hidden.
 $EB4C JR NZ,$EB51   ; }
 $EB4E CALL $ED9A    ; Call #R$ED9A.
@label=Load_Room_Doors_Continue
*$EB51 LD DE,$0005   ; {#REGix+=#N($0005,$04,$04).
 $EB54 ADD IX,DE     ; }
 $EB56 JR $EB43      ; Jump to #R$EB43.
; Skip each collectible record into *#R$6424.
@label=Load_Room_Collectibles
*$EB58 INC IX        ; {Write #REGix to *#R$6424.
 $EB5A LD ($6424),IX ; }
@label=Load_Room_Collectibles_Target
*$EB5E LD A,(IX+$00) ; {Jump to #R$EB6C if the terminator #N$FF is reached.
 $EB61 CP $FF        ;
 $EB63 JR Z,$EB6C    ; }
 $EB65 LD DE,$0003   ; {#REGix+=#N($0003,$04,$04).
 $EB68 ADD IX,DE     ; }
 $EB6A JR $EB5E      ; Jump to #R$EB5E.
; Draw each visible key into *#R$6426.
@label=Load_Room_Inventory
*$EB6C INC IX        ; {Write #REGix to *#R$6426.
 $EB6E LD ($6426),IX ; }
@label=Load_Room_Inventory_Target
*$EB72 LD A,(IX+$00) ; {Jump to #R$EB97 if the terminator #N$FF is reached.
 $EB75 CP $FF        ;
 $EB77 JR Z,$EB97    ; }
 $EB79 BIT 7,A       ; {Jump to #R$EB91 if this record is hidden.
 $EB7B JR NZ,$EB91   ; }
 $EB7D LD C,A        ; {Call #R$F42D at the item's column and row.
 $EB7E LD B,(IX+$01) ;
 $EB81 CALL $F42D    ; }
 $EB84 LD A,$07      ; {Write #INK$07 to *#SKOOLKID$5C8F(ATTR_T).
 $EB86 LD ($5C8F),A  ; }
 $EB89 LD A,$80      ; {Call #R$F445 with the key glyph #N$80 and size
 $EB8B LD DE,$0202   ; #N$02 by #N$02.
 $EB8E CALL $F445    ; }
@label=Load_Room_Inventory_Continue
*$EB91 INC IX        ; {Advance #REGix by two.
 $EB93 INC IX        ; }
 $EB95 JR $EB72      ; Jump to #R$EB72.
; Draw each visible ladder into *#R$6428.
@label=Load_Room_Ladders
*$EB97 INC IX        ; {Write #REGix to *#R$6428.
 $EB99 LD ($6428),IX ; }
@label=Load_Room_Ladders_Target
*$EB9D LD A,(IX+$00) ; {Jump to #R$EBD3 if the terminator #N$FF is reached.
 $EBA0 CP $FF        ;
 $EBA2 JR Z,$EBD3    ; }
 $EBA4 BIT 7,A       ; {Jump to #R$EBCB if this record is hidden.
 $EBA6 JR NZ,$EBCB   ; }
 $EBA8 LD C,A        ; {Call #R$F42D at the ladder's column and row.
 $EBA9 LD B,(IX+$01) ;
 $EBAC PUSH BC       ;
 $EBAD CALL $F42D    ; }
 $EBB0 LD A,(IX+$02) ; {Write the ladder colour to *#SKOOLKID$5C8F(ATTR_T).
 $EBB3 LD ($5C8F),A  ; }
 $EBB6 LD A,$0E      ; {Call #R$F445 with glyph #N$0E and size #N$01 by
 $EBB8 LD DE,$0102   ; #N$02.
 $EBBB CALL $F445    ; }
 $EBBE POP BC        ; {Call #R$F42D one row higher.
 $EBBF DEC B         ;
 $EBC0 CALL $F42D    ; }
 $EBC3 LD A,$DB      ; {Call #R$F445 with glyph #N$DB and size #N$04 by
 $EBC5 LD DE,$0402   ; #N$02.
 $EBC8 CALL $F445    ; }
@label=Load_Room_Ladders_Continue
*$EBCB INC IX        ; {Advance #REGix by three.
 $EBCD INC IX        ;
 $EBCF INC IX        ; }
 $EBD1 JR $EB9D      ; Jump to #R$EB9D.
; Draw each visible decoration into *#R$642E.
@label=Load_Room_Decorations
*$EBD3 INC IX        ; {Write #REGix to *#R$642E.
 $EBD5 LD ($642E),IX ; }
@label=Load_Room_Decorations_Target
*$EBD9 LD A,(IX+$00) ; {Jump to #R$EC04 if the terminator #N$FF is reached.
 $EBDC CP $FF        ;
 $EBDE JR Z,$EC04    ; }
 $EBE0 BIT 7,A       ; {Jump to #R$EBFD if this record is hidden.
 $EBE2 JR NZ,$EBFD   ; }
 $EBE4 LD C,A        ; {Call #R$F42D at the decoration's column and row.
 $EBE5 LD B,(IX+$01) ;
 $EBE8 CALL $F42D    ; }
 $EBEB LD A,(IX+$02) ; {Write the decoration colour to
 $EBEE LD ($5C8F),A  ; *#SKOOLKID$5C8F(ATTR_T).}
 $EBF1 LD A,(IX+$03) ; {Call #R$F445 with the stored glyph and size.
 $EBF4 LD E,(IX+$04) ;
 $EBF7 LD D,(IX+$05) ;
 $EBFA CALL $F445    ; }
@label=Load_Room_Decorations_Continue
*$EBFD LD DE,$0006   ; {#REGix+=#N($0006,$04,$04).
 $EC00 ADD IX,DE     ; }
 $EC02 JR $EBD9      ; Jump to #R$EBD9.
; Draw each visible actor into *#R$6430.
@label=Load_Room_Actors
*$EC04 INC IX        ; {Write #REGix to *#R$6430.
 $EC06 LD ($6430),IX ; }
@label=Load_Room_Actors_Target
*$EC0A LD A,(IX+$00) ; {Jump to #R$EC1F if the terminator #N$FF is reached.
 $EC0D CP $FF        ;
 $EC0F JR Z,$EC1F    ; }
 $EC11 BIT 7,A       ; {Jump to #R$EC18 if this record is hidden.
 $EC13 JR NZ,$EC18   ; }
 $EC15 CALL $F45A    ; Call #R$F45A.
@label=Load_Room_Actors_Continue
*$EC18 LD DE,$000D   ; {#REGix+=#N($000D,$04,$04).
 $EC1B ADD IX,DE     ; }
 $EC1D JR $EC0A      ; Jump to #R$EC0A.
; Draw each visible enemy into *#R$6432.
@label=Load_Room_Enemies
*$EC1F LD HL,$9070   ; {Write #R$9070 to *#SKOOLKID$5C36(CHARS).
 $EC22 LD ($5C36),HL ; }
 $EC25 INC IX        ; {Write #REGix to *#R$6432.
 $EC27 LD ($6432),IX ; }
@label=Load_Room_Enemies_Target
*$EC2B LD A,(IX+$00) ; {Jump to #R$EC40 if the terminator #N$FF is reached.
 $EC2E CP $FF        ;
 $EC30 JR Z,$EC40    ; }
 $EC32 BIT 7,A       ; {Jump to #R$EC39 if this record is hidden.
 $EC34 JR NZ,$EC39   ; }
 $EC36 CALL $F44B    ; Call #R$F44B.
@label=Load_Room_Enemies_Continue
*$EC39 LD DE,$000E   ; {#REGix+=#N($000E,$04,$04).
 $EC3C ADD IX,DE     ; }
 $EC3E JR $EC2B      ; Jump to #R$EC2B.
; Draw each visible moving object into *#R$642A.
@label=Load_Room_Movers
*$EC40 INC IX        ; {Write #REGix to *#R$642A.
 $EC42 LD ($642A),IX ; }
@label=Load_Room_Movers_Target
*$EC46 LD A,(IX+$00) ; {Jump to #R$EC65 if the terminator #N$FF is reached.
 $EC49 CP $FF        ;
 $EC4B JR Z,$EC65    ; }
 $EC4D BIT 7,A       ; {Jump to #R$EC5E if this record is hidden.
 $EC4F JR NZ,$EC5E   ; }
 $EC51 LD C,(IX+$10) ; {Write the object's clip window to *#R$6419.
 $EC54 LD B,(IX+$11) ;
 $EC57 LD ($6419),BC ; }
 $EC5B CALL $F44B    ; Call #R$F44B.
@label=Load_Room_Movers_Continue
*$EC5E LD DE,$0013   ; {#REGix+=#N($0013,$04,$04).
 $EC61 ADD IX,DE     ; }
 $EC63 JR $EC46      ; Jump to #R$EC46.
; Draw the status bar and reset the per-room flags.
@label=Load_Room_Status
*$EC65 INC IX        ; Advance past the terminator.
 $EC67 LD BC,$0221   ; {Convert column #N$21, row #N$02 into a #R$5DCE
 $EC6A CALL $F43C    ; offset.}
 $EC6D LD DE,$5800   ; {Point #REGhl at the matching attribute cell.
 $EC70 ADD HL,DE     ; }
 $EC71 LD DE,$0220   ; {Fill #N$0220 attribute cells with #INK$08.
 $EC74 LD A,$08      ;
 $EC76 CALL $F454    ; }
 $EC79 CALL $ECF2    ; Call #R$ECF2.
; Draw the status icons.
 $EC7C LD BC,$011F   ; #REGbc=#N$011F.
 $EC7F LD HL,$7C70   ; {Write #R$7C70 to *#SKOOLKID$5C36(CHARS).
 $EC82 LD ($5C36),HL ; }
 $EC85 CALL $F427    ; Call #R$F427.
 $EC88 LD A,($6411)  ; {Call #R$ED71 when *#R$6411 is set.
 $EC8B OR A          ;
 $EC8C CALL NZ,$ED71 ; }
 $EC8F LD BC,$0218   ; {Write the default clip window to *#R$6419.
 $EC92 LD ($6419),BC ;
 $EC96 LD BC,$0121   ;
 $EC99 LD ($641B),BC ; }
 $EC9D XOR A         ; #REGa=#N$00.
 $EC9E LD DE,$6473   ; {Clear #N$0A bytes from *#R$6472.
 $ECA1 LD HL,$6472   ;
 $ECA4 LD (HL),A     ;
 $ECA5 LD BC,$0009   ;
 $ECA8 LDIR          ; }
 $ECAA LD HL,$0102   ; {Write #N$0102 to *#R$6486.
 $ECAD LD ($6486),HL ; }
 $ECB0 LD HL,($6484) ; {Copy *#R$6484 back to *#R$647F.
 $ECB3 LD ($647F),HL ; }
 $ECB6 LD ($6489),A  ; {Clear *#R$6489 and *#R$648A.
 $ECB9 LD ($648A),A  ; }
 $ECBC LD ($644B),A  ; {Clear *#R$644B.
 $ECBF LD ($644C),A  ; }
 $ECC2 LD ($649F),A  ; {Clear *#R$649F, *#R$6410 and *#R$6411.
 $ECC5 LD ($6410),A  ;
 $ECC8 LD ($6411),A  ; }
 $ECCB LD ($6435),A  ; {Clear *#R$6435 and the stand timers.
 $ECCE LD ($6436),A  ;
 $ECD1 LD ($6437),A  ;
 $ECD4 LD ($6438),A  ;
 $ECD7 LD ($6439),A  ; }
 $ECDA LD ($64A3),A  ; {Clear *#R$64A3 and *#R$6434.
 $ECDD LD ($6434),A  ; }
 $ECE0 DEC A         ; {Write #N$FF to #R$644D and #R$645B.
 $ECE1 LD ($644D),A  ;
 $ECE4 LD ($645B),A  ; }
 $ECE7 LD A,$60      ; {Write #N$60 to *#R$64AA.
 $ECE9 LD ($64AA),A  ; }
 $ECEC LD A,$80      ; {Write #N$80 to *#R$648B.
 $ECEE LD ($648B),A  ; }
 $ECF1 RET           ; Return.

; Print Inventory
;
; Used by the routines at #R$EA02, #R$F256 and #R$F2B2.
; .
; Prints the four #R$64C1 digits and flashes them when every slot is
; #N$09.
@label=Print_Inventory
c$ECF2 LD A,$0F      ; {Write #INK$0F to *#SKOOLKID$5C8F(ATTR_T).
 $ECF4 LD ($5C8F),A  ; }
 $ECF7 LD HL,$3C00   ; {Write #N$3C00 to *#SKOOLKID$5C36(CHARS).
 $ECFA LD ($5C36),HL ; }
 $ECFD LD BC,$0107   ; {Call #R$F42D at column #N$07, row #N$01.
 $ED00 CALL $F42D    ; }
; Print the four combination digits.
 $ED03 LD BC,$0400   ; #REGbc=#N$0400.
 $ED06 LD HL,$64C1   ; #REGhl=#R$64C1.
@label=Print_Inventory_Target
*$ED09 LD A,(HL)     ; {Jump to #R$ED0F unless this digit is #N$09.
 $ED0A CP $09        ;
 $ED0C JR NZ,$ED0F   ; }
 $ED0E INC C         ; Increase the "#N$09" count.
@label=Print_Inventory_Continue
*$ED0F ADD A,$30     ; Convert the digit into ASCII.
 $ED11 CALL $F436    ; Call #R$F436.
 $ED14 INC HL        ; {Advance the digit pointer and loop back to #R$ED09.
 $ED15 DJNZ $ED09    ; }
; Flash the four cells when every digit is #N$09.
 $ED17 LD A,C        ; {Return unless all four digits were #N$09.
 $ED18 CP $04        ;
 $ED1A RET NZ        ; }
 $ED1B LD BC,$0107   ; {Convert column #N$07, row #N$01 into a #R$5DCE
 $ED1E CALL $F43C    ; offset.}
 $ED21 LD DE,$5800   ; {Point #REGhl at the matching attribute cells.
 $ED24 ADD HL,DE     ;
 $ED25 LD B,$04      ; }
@label=Print_Inventory_Target2
*$ED27 SET 7,(HL)    ; {Set FLASH on each of the four cells.
 $ED29 INC HL        ;
 $ED2A DJNZ $ED27    ; }
 $ED2C RET           ; Return.

; Copy Font Bank 1
;
; Used by the routine at #R$EA02.
@label=Copy_FontBank1
c$ED2D LD HL,$8470   ; {Copy #N$0400 bytes from #R$8470 to #R$7C70.
 $ED30 LD DE,$7C70   ;
 $ED33 LD BC,$0400   ;
 $ED36 LDIR          ; }
 $ED38 RET           ; Return.

; Copy Font Bank 2
;
; Used by the routine at #R$EA02.
@label=Copy_FontBank2
c$ED39 LD HL,$8870   ; {Copy #N$0400 bytes from #R$8870 to #R$7C70.
 $ED3C LD DE,$7C70   ;
 $ED3F LD BC,$0400   ;
 $ED42 LDIR          ; }
 $ED44 RET           ; Return.

; Copy Font Bank 3
;
; Used by the routine at #R$EA02.
@label=Copy_FontBank3
c$ED45 LD HL,$8C70   ; {Copy #N$0400 bytes from #R$8C70 to #R$7C70.
 $ED48 LD DE,$7C70   ;
 $ED4B LD BC,$0400   ;
 $ED4E LDIR          ; }
 $ED50 RET           ; Return.

; Clear Room Buffers
;
; Used by the routine at #R$EA02.
@label=Clear_RoomBuffers
c$ED51 PUSH AF       ; Stash #REGaf on the stack.
 $ED52 XOR A         ; {Write #N$00 to *#SKOOLKID$5C8D(ATTR_P).
 $ED53 LD ($5C8D),A  ; }
 $ED56 LD B,$18      ; {Clear the bottom #N$18 lines using
 $ED58 CALL $0E44    ; #SKOOLKID$0E44(CL_LINE).}
 $ED5B LD HL,$5DCE   ; {Fill #R$5DCE with #N$C8.
 $ED5E LD DE,$5DCF   ;
 $ED61 LD (HL),$C8   ;
 $ED63 LD BC,$0320   ;
 $ED66 LDIR          ; }
 $ED68 LD (HL),$00   ; {Fill #R$60EE with #N$00.
 $ED6A LD BC,$031F   ;
 $ED6D LDIR          ; }
 $ED6F POP AF        ; Restore #REGaf from the stack.
 $ED70 RET           ; Return.

; Reset Player
;
; Used by the routine at #R$EA02.
@label=Reset_Player
c$ED71 LD BC,$1212   ; {Place the player at column #N$12, row #N$12.
 $ED74 LD DE,$0302   ; }
; Use sprite #N$60.
 $ED77 LD A,$60      ; #REGa=#N$60.
 $ED79 LD L,$45      ; #REGl=#INK$45.
 $ED7B LD IX,$64A4   ; #REGix=#R$64A4.
 $ED7F JP $F457      ; Jump to #R$F457.

; Draw Furniture
;
; Used by the routine at #R$EA02.
;
; .
;
; Call #R$F42D at the furniture column and row.
@label=Draw_FurnitureItem
c$ED82 LD C,(IX+$00) ; {#REGbc=the furniture column and row.
 $ED85 LD B,(IX+$01) ; }
 $ED88 CALL $F42D    ; Call #R$F42D.
 $ED8B LD A,(IX+$02) ; {Write the furniture colour to
 $ED8E LD ($5C8F),A  ; *#SKOOLKID$5C8F(ATTR_T).}
; Use the stored glyph.
 $ED91 LD A,(IX+$03) ; #REGa=the stored glyph.
 $ED94 LD DE,$0403   ; #REGde=#N$0403.
 $ED97 JP $F445      ; Jump to #R$F445.

; Draw Door
;
; Used by the routine at #R$EA02.
;
; .
;
; Call #R$F42D at the door column and row.
@label=Draw_Door
c$ED9A LD C,(IX+$00) ; {#REGbc=the door column and row.
 $ED9D LD B,(IX+$01) ; }
 $EDA0 CALL $F42D    ; Call #R$F42D.
 $EDA3 LD A,(IX+$02) ; {Write the door colour to *#SKOOLKID$5C8F(ATTR_T).
 $EDA6 LD ($5C8F),A  ; }
; Use glyph #N$84.
 $EDA9 LD A,$84      ; #REGa=#N$84.
 $EDAB LD DE,$0202   ; #REGde=#N$0202.
 $EDAE JP $F445      ; Jump to #R$F445.

; Draw Header Furniture
;
; Used by the routines at #R$EA02 and #R$EFE6.
@label=Draw_HeaderFurniture
c$EDB1 LD B,(IX+$01) ; {Fetch the print row and the stored column.
 $EDB4 LD A,(IX+$00) ; }
 $EDB7 AND %01111111 ; Keep only bits 0-6.
 $EDB9 LD C,A        ; #REGc=the column.
 $EDBA CALL $F42D    ; Call #R$F42D.
 $EDBD LD A,(IX+$02) ; {Write the furniture colour to
 $EDC0 LD ($5C8F),A  ; *#SKOOLKID$5C8F(ATTR_T).}
 $EDC3 LD B,(IX+$05) ; #REGb=the remaining height.
@label=Draw_HeaderFurniture_Target
*$EDC6 LD A,(IX+$03) ; {Fetch the starting glyph and the remaining width.
 $EDC9 LD C,(IX+$04) ; }
@label=Draw_HeaderFurniture_Continue
*$EDCC CALL $F436    ; Call #R$F436.
 $EDCF CALL $F43F    ; Call #R$F43F.
 $EDD2 INC A         ; {Increase the glyph and loop back to #R$EDCC
 $EDD3 DEC C         ; until this row is drawn.
 $EDD4 JR NZ,$EDCC   ; }
 $EDD6 DJNZ $EDC6    ; Decrease the height and loop back to #R$EDC6.
 $EDD8 RET           ; Return.

; Handler: Events
;
; Used by the routine at #R$E9FF.
; .
; Dispatches the event ID in #REGa to a room
; action. Bit 7 marks a collectible pickup.
;
; A Event ID (bit 7 set for a collectible)
; IX Player entity (unused)
;
; Stash the caller context.
@label=Handler_Events
c$EDD9 PUSH IX       ; {Stash #REGix and *#SKOOLKID$5C36(CHARS) on the
 $EDDB LD HL,($5C36) ; stack.
 $EDDE PUSH HL       ; }
 $EDDF LD HL,$EECB   ; {Push #R$EECB as the return address.
 $EDE2 PUSH HL       ; }
; Use the in-game font.
 $EDE3 LD HL,$7C70   ; {Write #R$7C70 to *#SKOOLKID$5C36(CHARS).
 $EDE6 LD ($5C36),HL ; }
; Ignore event #N$26.
 $EDE9 CP $26        ; {Return through #R$EECB if the event is #N$26.
 $EDEB RET Z         ; }
; Return if a timer is already running.
 $EDEC LD L,A        ; Copy the event ID into #REGl.
 $EDED LD A,($649F)  ; {Return through #R$EECB if *#R$649F is already
 $EDF0 OR A          ; running.
 $EDF1 RET NZ        ; }
; Collectibles skip the event sound.
 $EDF2 BIT 7,L       ; {Jump to #R$EDFB if this is a collectible event.
 $EDF4 JR NZ,$EDFB   ; }
 $EDF6 LD A,$10      ; {Write #N$10 to *#R$6472.
 $EDF8 LD ($6472),A  ; }
; Keep only the event ID.
@label=Handler_Events_Dispatch
*$EDFB LD A,L        ; Copy the event ID into #REGa.
 $EDFC AND %01111111 ; Keep only bits 0-6.
; Jump to the handler for this event ID.
 $EDFE OR A          ; {Jump to #R$EFE6 if the event is #N$00
 $EDFF JP Z,$EFE6    ; (draw the first header item).}
 $EE02 CP $01        ; {Jump to #R$EFF5 if the event is #N$01
 $EE04 JP Z,$EFF5    ; (draw the next header item).}
 $EE07 CP $03        ; {Jump to #R$F000 if the event is #N$03
 $EE09 JP Z,$F000    ; (draw the first two header items).}
 $EE0C CP $02        ; {Jump to #R$F011 if the event is #N$02
 $EE0E JP Z,$F011    ; (nudge the first actor).}
 $EE11 CP $04        ; {Jump to #R$F350 if the event is #N$04
 $EE13 JP Z,$F350    ; (print the event message).}
 $EE16 CP $05        ; {Jump to #R$F03E if the event is #N$05
 $EE18 JP Z,$F03E    ; (start the first enemy).}
 $EE1B CP $06        ; {Jump to #R$EEFA if the event is #N$06
 $EE1D JP Z,$EEFA    ; (reveal the room-header item).}
 $EE20 CP $07        ; {Jump to #R$F0C0 if the event is #N$07
 $EE22 JP Z,$F0C0    ; (reveal three header items).}
 $EE25 CP $08        ; {Jump to #R$EF8A if the event is #N$08
 $EE27 JP Z,$EF8A    ; (start an actor walking).}
 $EE2A CP $09        ; {Jump to #R$F395 if the event is #N$09
 $EE2C JP Z,$F395    ; (toggle the silent-tune flag).}
 $EE2F CP $0A        ; {Jump to #R$F06A if the event is #N$0A
 $EE31 JP Z,$F06A    ; (start a short event timer).}
 $EE34 CP $0B        ; {Jump to #R$F1C4 if the event is #N$0B
 $EE36 JP Z,$F1C4    ; (reveal a decoration and a mover).}
 $EE39 CP $0C        ; {Jump to #R$F1D4 if the event is #N$0C
 $EE3B JP Z,$F1D4    ; (reveal the next decoration and mover).}
 $EE3E CP $0D        ; {Jump to #R$F26A if the event is #N$0D
 $EE40 JP Z,$F26A    ; (hide a later actor).}
 $EE43 CP $0E        ; {Jump to #R$EFD3 if the event is #N$0E
 $EE45 JP Z,$EFD3    ; (swap the left/right keys).}
 $EE48 CP $0F        ; {Jump to #R$F28F if the event is #N$0F
 $EE4A JP Z,$F28F    ; (hide the first active actor).}
 $EE4D CP $11        ; {Jump to #R$F22C if the event is #N$11
 $EE4F JP Z,$F22C    ; (hide the first furniture item).}
 $EE52 CP $12        ; {Jump to #R$F2E0 if the event is #N$12
 $EE54 JP Z,$F2E0    ; (reveal the first door).}
 $EE57 CP $13        ; {Jump to #R$F31D if the event is #N$13
 $EE59 JP Z,$F31D    ; (reveal the next door).}
 $EE5C CP $14        ; {Jump to #R$EEE5 if the event is #N$14
 $EE5E JP Z,$EEE5    ; (reveal two decorations).}
 $EE61 CP $15        ; {Jump to #R$F328 if the event is #N$15
 $EE63 JP Z,$F328    ; (reveal the third door).}
 $EE66 CP $16        ; {Jump to #R$F2B2 if the event is #N$16
 $EE68 JP Z,$F2B2    ; (randomise the combination).}
 $EE6B CP $17        ; {Jump to #R$F072 if the event is #N$17
 $EE6D JP Z,$F072    ; (draw two header items and start a timer).}
 $EE70 CP $18        ; {Jump to #R$F164 if the event is #N$18
 $EE72 JP Z,$F164    ; (show the first hidden enemy).}
 $EE75 CP $19        ; {Jump to #R$F0E4 if the event is #N$19
 $EE77 JP Z,$F0E4    ; (reveal the first furniture item).}
 $EE7A CP $1A        ; {Jump to #R$EF3A if the event is #N$1A
 $EE7C JP Z,$EF3A    ; (reveal two decorations and a mover).}
 $EE7F CP $1B        ; {Jump to #R$F125 if the event is #N$1B
 $EE81 JP Z,$F125    ; (reveal the first ladder).}
 $EE84 CP $1C        ; {Jump to #R$EF5C if the event is #N$1C
 $EE86 JP Z,$EF5C    ; (reveal three decorations and three movers).}
 $EE89 CP $1D        ; {Jump to #R$F361 if the event is #N$1D
 $EE8B JP Z,$F361    ; (reveal every decoration).}
 $EE8E CP $1E        ; {Jump to #R$F1EE if the event is #N$1E
 $EE90 JP Z,$F1EE    ; (reveal three decorations).}
 $EE93 CP $1F        ; {Jump to #R$F217 if the event is #N$1F
 $EE95 JP Z,$F217    ; (show every moving object).}
 $EE98 CP $20        ; {Jump to #R$F249 if the event is #N$20
 $EE9A JP Z,$F249    ; (increment combination digit 4).}
 $EE9D CP $21        ; {Jump to #R$F244 if the event is #N$21
 $EE9F JP Z,$F244    ; (increment combination digit 3).}
 $EEA2 CP $22        ; {Jump to #R$F188 if the event is #N$22
 $EEA4 JP Z,$F188    ; (award a combination digit).}
 $EEA7 CP $23        ; {Jump to #R$F24E if the event is #N$23
 $EEA9 JP Z,$F24E    ; (increment combination digit 2).}
 $EEAC CP $24        ; {Jump to #R$F07D if the event is #N$24
 $EEAE JP Z,$F07D    ; (hide two header items).}
 $EEB1 CP $25        ; {Jump to #R$F253 if the event is #N$25
 $EEB3 JP Z,$F253    ; (increment combination digit 1).}
 $EEB6 CP $27        ; {Jump to #R$F006 if the event is #N$27
 $EEB8 JP Z,$F006    ; (draw the fourth header item).}
 $EEBB CP $28        ; {Jump to #R$F0B4 if the event is #N$28
 $EEBD JP Z,$F0B4    ; (hide the fourth header item).}
 $EEC0 CP $29        ; {Jump to #R$F1B6 if the event is #N$29
 $EEC2 JP Z,$F1B6    ; (test the second header item).}
 $EEC5 CP $2A        ; {Jump to #R$EED2 if the event is #N$2A
 $EEC7 JP Z,$EED2    ; (hide the first two enemies).}
; Ignore an unhandled event ID.
@label=Handler_Events_Done
 $EECA POP HL        ; Drop the unused return address.
; Restore the font and #REGix.
@label=Handler_Events_Restore
 $EECB POP HL        ; {Restore *#SKOOLKID$5C36(CHARS) from the stack.
 $EECC LD ($5C36),HL ; }
 $EECF POP IX        ; Restore #REGix from the stack.
; Return.
 $EED1 RET           ; Return.

; Event: Hide Enemies
;
; Used by the routine at #R$EDD9.
; .
; Event #N$2A: hide the first two enemies.
@label=Event_HideEnemies
c$EED2 CALL $F006     ; Call #R$F006.
 $EED5 CALL $F164     ; Call #R$F164.
 $EED8 LD IX,($6432)  ; #REGix=*#R$6432.
 $EEDC SET 7,(IX+$00) ; {Set bit 7 on the first two enemy records.
 $EEE0 SET 7,(IX+$0E) ; }
 $EEE4 RET            ; Return.

; Event: Reveal Decorations
;
; Used by the routine at #R$EDD9.
; .
; Event #N$14: reveal two decorations.
@label=Event_RevealDecorations
c$EEE5 LD IX,($642E) ; #REGix=*#R$642E.
 $EEE9 LD B,$02      ; #REGb=#N$02.
@label=Event_RevealDecorations_Target
*$EEEB PUSH BC       ; Stash the count on the stack.
 $EEEC CALL $F193    ; Call #R$F193.
 $EEEF LD DE,$0006   ; {Advance to the next decoration.
 $EEF2 ADD IX,DE     ; }
 $EEF4 POP BC        ; Restore the count from the stack.
 $EEF5 DJNZ $EEEB    ; Decrease the count and loop back to #R$EEEB.
 $EEF7 JP $F164      ; Jump to #R$F164.

; Event: Reveal Header
;
; Used by the routine at #R$EDD9.
; .
; Event #N$06: reveal the room-header item.
@label=Event_RevealHeader
c$EEFA LD IX,($641E)   ; #REGix=*#R$641E.
 $EEFE BIT 7,(IX+$00)  ; {Return if this header item is already visible.
 $EF02 RET Z           ; }
 $EF03 LD BC,$2020     ; {Write #N$2020 to *#R$6472.
 $EF06 LD ($6472),BC   ; }
 $EF0A RES 7,(IX+$00)  ; Clear bit 7 of the header record.
 $EF0E LD C,(IX+$00)   ; {Fetch the column, row, width and colour.
 $EF11 LD B,(IX+$01)   ;
 $EF14 LD E,(IX+$04)   ;
 $EF17 LD D,$01        ;
 $EF19 LD L,(IX+$02)   ;
 $EF1C LD A,(IX+$03)   ; }
 $EF1F LD IX,$648B     ; #REGix=#R$648B.
 $EF23 CALL $F457      ; Call #R$F457.
 $EF26 CALL $F333      ; Call #R$F333.
 $EF29 LD (IX+$08),$01 ; Write #N$01 as the horizontal delta.
 $EF2D LD A,(IX+$00)   ; {Subtract the width from the column and store it.
 $EF30 SUB (IX+$04)    ;
 $EF33 LD (IX+$00),A   ;
 $EF36 LD (IX+$13),A   ; }
 $EF39 RET             ; Return.

; Event: Reveal Pair
;
; Used by the routine at #R$EDD9.
; .
; Event #N$1A: reveal two decorations and a mover.
@label=Event_RevealPair
c$EF3A LD IX,($642E)  ; {#REGix=*#R$642E+#N($000C,$04,$04).
 $EF3E LD DE,$000C    ;
 $EF41 ADD IX,DE      ; }
 $EF43 CALL $F193     ; Call #R$F193.
 $EF46 LD DE,$0006    ; {Advance one decoration.
 $EF49 ADD IX,DE      ; }
 $EF4B CALL $F193     ; Call #R$F193.
 $EF4E LD IX,($642A)  ; {Clear bit 7 of *#R$642A+#N($0026,$04,$04).
 $EF52 LD DE,$0026    ;
 $EF55 ADD IX,DE      ;
 $EF57 RES 7,(IX+$00) ; }
 $EF5B RET            ; Return.

; Event: Reveal Triple
;
; Used by the routine at #R$EDD9.
; .
; Event #N$1C: reveal three decorations and three movers.
@label=Event_RevealTriple
c$EF5C LD IX,($642E)  ; {#REGix=*#R$642E+#N($0018,$04,$04).
 $EF60 LD DE,$0018    ;
 $EF63 ADD IX,DE      ; }
 $EF65 LD B,$03       ; #REGb=#N$03.
; Reveal three decorations.
@label=Event_RevealTriple_Target
*$EF67 PUSH BC        ; Stash the count on the stack.
 $EF68 CALL $F193     ; Call #R$F193.
 $EF6B POP BC         ; Restore the count from the stack.
 $EF6C LD DE,$0006    ; {Advance to the next decoration.
 $EF6F ADD IX,DE      ; }
 $EF71 DJNZ $EF67     ; Decrease the count and loop back to #R$EF67.
; Reveal three movers.
 $EF73 LD IX,($642A)  ; {#REGix=*#R$642A+#N($0039,$04,$04).
 $EF77 LD DE,$0039    ;
 $EF7A ADD IX,DE      ; }
 $EF7C LD B,$03       ; #REGb=#N$03.
 $EF7E LD DE,$0013    ; #REGde=#N($0013,$04,$04).
@label=Event_RevealTriple_Target2
*$EF81 RES 7,(IX+$00) ; Clear bit 7 of this mover.
 $EF85 ADD IX,DE      ; #REGix+=#REGde.
 $EF87 DJNZ $EF81     ; Decrease the count and loop back to #R$EF81.
 $EF89 RET            ; Return.

; Event: Start Actor
;
; Used by the routine at #R$EDD9.
; .
; Event #N$08: start an actor walking.
@label=Event_StartActor
c$EF8A LD IX,($6430)   ; #REGix=*#R$6430.
@label=Event_StartActor_Target
*$EF8E LD A,(IX+$00)   ; {Return if the terminator #N$FF is reached.
 $EF91 CP $FF          ;
 $EF93 RET Z           ; }
 $EF94 BIT 7,A         ; {Jump to #R$EFCC if this actor is hidden.
 $EF96 JR NZ,$EFCC     ; }
 $EF98 LD A,(IX+$08)   ; {Jump to #R$EFCC if the actor already has a delta.
 $EF9B OR (IX+$09)     ;
 $EF9E JR NZ,$EFCC     ; }
 $EFA0 LD A,(IX+$05)   ; {Jump to #R$EFB7 if there is no horizontal
 $EFA3 OR A            ; destination.
 $EFA4 JR Z,$EFB7      ; }
 $EFA6 CP (IX+$00)     ; {Jump to #R$EFB1 if the actor is left of the
 $EFA9 JR NC,$EFB1     ; destination.}
 $EFAB LD (IX+$08),$FE ; Write #N$FE as the horizontal delta.
 $EFAF JR $EFCC        ; Jump to #R$EFCC.
@label=Event_StartActor_Branch
*$EFB1 LD (IX+$08),$02 ; Write #N$02 as the horizontal delta.
 $EFB5 JR $EFCC        ; Jump to #R$EFCC.
@label=Event_StartActor_Skip
*$EFB7 LD A,(IX+$06)   ; {Jump to #R$EFCC if there is no vertical
 $EFBA OR A            ; destination.
 $EFBB JR Z,$EFCC      ; }
 $EFBD CP (IX+$01)     ; {Jump to #R$EFC8 if the actor is above the
 $EFC0 JR NC,$EFC8     ; destination.}
 $EFC2 LD (IX+$09),$FE ; Write #N$FE as the vertical delta.
 $EFC6 JR $EFCC        ; Jump to #R$EFCC.
@label=Event_StartActor_Branch2
*$EFC8 LD (IX+$09),$02 ; Write #N$02 as the vertical delta.
@label=Event_StartActor_Continue
*$EFCC LD DE,$000D     ; {#REGix+=#N($000D,$04,$04).
 $EFCF ADD IX,DE       ; }
 $EFD1 JR $EF8E        ; Jump to #R$EF8E.

; Event: Swap Keys
;
; Used by the routine at #R$EDD9.
; .
; Event #N$0E: swap the left/right keys.
@label=Event_SwapKeys
c$EFD3 LD BC,($647F) ; {Swap *#R$647F with *#R$6480.
 $EFD7 LD H,C        ;
 $EFD8 LD L,B        ;
 $EFD9 LD ($647F),HL ; }
 $EFDC LD BC,($6486) ; {Swap the two bytes at *#R$6486.
 $EFE0 LD H,C        ;
 $EFE1 LD L,B        ;
 $EFE2 LD ($6486),HL ; }
 $EFE5 RET           ; Return.

; Event: Draw Header
;
; Used by the routines at #R$EDD9 and #R$F000.
; .
; Event #N$00: draw the first header item.
@label=Event_DrawHeader
c$EFE6 LD IX,($641E) ; #REGix=*#R$641E.
; This entry point is used by the routines at #R$EFF5, #R$F006 and #R$F0C0.
@label=Event_DrawHeader_Body
*$EFEA LD A,(IX+$00) ; #REGa=the header record.
 $EFED AND %01111111 ; Keep only bits 0-6.
 $EFEF LD (IX+$00),A ; Write it back.
 $EFF2 JP $EDB1      ; Jump to #R$EDB1.

; Event: Draw Next Header
;
; Used by the routines at #R$EDD9 and #R$F000.
; .
; Event #N$01: draw the next header item.
@label=Event_DrawHeaderNext
c$EFF5 LD IX,($641E) ; #REGix=*#R$641E.
 $EFF9 LD DE,$0006   ; {#REGix+=#N($0006,$04,$04).
 $EFFC ADD IX,DE     ; }
 $EFFE JR $EFEA      ; Jump to #R$EFEA.

; Event: Draw Header Pair
;
; Used by the routines at #R$EDD9 and #R$F072.
; .
; Event #N$03: draw the first two header items.
@label=Event_DrawHeaderPair
c$F000 CALL $EFE6    ; Call #R$EFE6.
 $F003 JP $EFF5      ; Jump to #R$EFF5.

; Event: Draw Fourth Header
;
; Used by the routines at #R$EDD9 and #R$EED2.
; .
; Event #N$27: draw the fourth header item.
@label=Event_DrawHeaderFourth
c$F006 LD IX,($641E) ; #REGix=*#R$641E.
 $F00A LD DE,$0012   ; {#REGix+=#N($0012,$04,$04).
 $F00D ADD IX,DE     ; }
 $F00F JR $EFEA      ; Jump to #R$EFEA.

; Event: Nudge Actor
;
; Used by the routine at #R$EDD9.
; .
; Event #N$02: nudge the first actor.
@label=Event_NudgeActor
c$F011 LD IX,($6430)   ; #REGix=*#R$6430.
@label=Event_NudgeActor_Target
*$F015 LD A,(IX+$00)   ; {Return if the terminator #N$FF is reached.
 $F018 INC A           ;
 $F019 RET Z           ; }
 $F01A LD A,(IX+$09)   ; {Return if the actor already has a vertical delta.
 $F01D OR A            ;
 $F01E RET NZ          ; }
 $F01F LD A,(IX+$0C)   ; {Jump to #R$F037 if there is no stored destination.
 $F022 OR A            ;
 $F023 JR Z,$F037      ; }
 $F025 LD A,(IX+$06)   ; {Jump to #R$F033 if the actor is above the
 $F028 CP (IX+$0B)     ; destination.
 $F02B JR NC,$F033     ; }
 $F02D LD (IX+$09),$FE ; Write #N$FE as the vertical delta.
 $F031 JR $F037        ; Jump to #R$F037.
@label=Event_NudgeActor_Branch
*$F033 LD (IX+$09),$02 ; Write #N$02 as the vertical delta.
@label=Event_NudgeActor_Skip
*$F037 LD DE,$000D     ; {#REGix+=#N($000D,$04,$04).
 $F03A ADD IX,DE       ; }
 $F03C JR $F015        ; Jump to #R$F015.

; Event: Start Enemy
;
; Used by the routine at #R$EDD9.
; .
; Event #N$05: start the first enemy.
@label=Event_StartEnemy
c$F03E LD BC,$2614   ; {Write #N$2614 to *#R$649F.
 $F041 LD ($649F),BC ; }
 $F045 LD IX,($6432) ; #REGix=*#R$6432.
@label=Event_StartEnemy_Target
*$F049 LD A,(IX+$00) ; {Return if the terminator #N$FF is reached.
 $F04C INC A         ;
 $F04D RET Z         ; }
 $F04E BIT 7,A       ; {Jump to #R$F063 if this enemy is hidden.
 $F050 JR NZ,$F063   ; }
 $F052 LD A,(IX+$08) ; {Negate the horizontal delta.
 $F055 DEC A         ; }
 $F056 XOR %11111111 ; Invert the subtracted byte.
 $F058 LD (IX+$08),A ; Write the new horizontal delta.
 $F05B LD A,(IX+$07) ; #REGa=*#REGix+#N$07.
 $F05E XOR %10000000 ; Toggle bit 7.
 $F060 LD (IX+$07),A ; Write the facing flag back.
@label=Event_StartEnemy_Continue
*$F063 LD DE,$000E   ; {#REGix+=#N($000E,$04,$04).
 $F066 ADD IX,DE     ; }
 $F068 JR $F049      ; Jump to #R$F049.

; Event: Start Short Timer
;
; Used by the routine at #R$EDD9.
; .
; Event #N$0A: start a short event timer.
@label=Event_ShortTimer
c$F06A LD BC,$021C   ; {Write #N$021C to *#R$649F.
 $F06D LD ($649F),BC ; }
 $F071 RET           ; Return.

; Event: Draw Header Timer
;
; Used by the routine at #R$EDD9.
; .
; Event #N$17: draw two header items and start a timer.
@label=Event_HeaderAndTimer
c$F072 CALL $F000    ; Call #R$F000.
 $F075 LD BC,$246E   ; {Write #N$246E to *#R$649F.
 $F078 LD ($649F),BC ; }
 $F07C RET           ; Return.

; Event: Hide Header Pair
;
; Used by the routine at #R$EDD9.
; .
; Event #N$24: hide two header items.
@label=Event_HideHeaderPair
c$F07D LD B,$02      ; #REGb=#N$02.
 $F07F LD IX,($641E) ; #REGix=*#R$641E.
@label=Event_HideHeaderPair_Target
*$F083 PUSH BC       ; Stash the count on the stack.
 $F084 CALL $F090    ; Call #R$F090.
 $F087 POP BC        ; Restore the count from the stack.
 $F088 LD DE,$0006   ; {Advance to the next header record.
 $F08B ADD IX,DE     ; }
 $F08D DJNZ $F083    ; Decrease the count and loop back to #R$F083.
 $F08F RET           ; Return.

; Hide Header Item
;
; Used by the routines at #R$F07D, #R$F0B4 and #R$F0C0.
; .
; Hides one header item by overprinting #N$C8.
@label=Hide_HeaderItem
c$F090 LD A,(IX+$00)  ; #REGa=the header record.
 $F093 AND %01111111  ; Keep only bits 0-6.
 $F095 LD C,A         ; #REGc=the column.
 $F096 SET 7,(IX+$00) ; Set bit 7 of the header record.
 $F09A LD B,(IX+$01)  ; #REGb=the row.
 $F09D CALL $F42D     ; Call #R$F42D.
 $F0A0 LD B,(IX+$05)  ; #REGb=the remaining height.
@label=Hide_HeaderItem_Target
*$F0A3 LD C,(IX+$04)  ; #REGc=the remaining width.
@label=Hide_HeaderItem_Continue
*$F0A6 LD A,$C8       ; #REGa=#N$C8.
 $F0A8 CALL $F436     ; Call #R$F436.
 $F0AB CALL $F43F     ; Call #R$F43F.
 $F0AE DEC C          ; {Decrease the width and loop back to #R$F0A6.
 $F0AF JR NZ,$F0A6    ; }
 $F0B1 DJNZ $F0A3     ; Decrease the height and loop back to #R$F0A3.
 $F0B3 RET            ; Return.

; Event: Hide Fourth Header
;
; Used by the routine at #R$EDD9.
; .
; Event #N$28: hide the fourth header item.
@label=Event_HideHeaderFourth
c$F0B4 LD IX,($641E) ; #REGix=*#R$641E.
 $F0B8 LD DE,$0012   ; {#REGix+=#N($0012,$04,$04).
 $F0BB ADD IX,DE     ; }
 $F0BD JP $F090      ; Jump to #R$F090.

; Event: Reveal Header Triple
;
; Used by the routine at #R$EDD9.
; .
; Event #N$07: reveal three header items.
@label=Event_RevealHeaderTriple
c$F0C0 LD BC,$2614   ; {Write #N$2614 to *#R$649F.
 $F0C3 LD ($649F),BC ; }
 $F0C7 LD B,$03      ; #REGb=#N$03.
 $F0C9 LD IX,($641E) ; #REGix=*#R$641E.
@label=Event_RevealHeaderTriple_Target
*$F0CD PUSH BC       ; Stash the count on the stack.
 $F0CE LD A,(IX+$00) ; #REGa=the header record.
 $F0D1 BIT 7,A       ; Test bit 7.
 $F0D3 PUSH AF       ; Stash the flags on the stack.
 $F0D4 CALL NZ,$EFEA ; Call #R$EFEA if the item is hidden.
 $F0D7 POP AF        ; Restore the flags from the stack.
 $F0D8 CALL Z,$F090  ; Call #R$F090 if the item is visible.
 $F0DB POP BC        ; Restore the count from the stack.
 $F0DC LD DE,$0006   ; {Advance to the next header record.
 $F0DF ADD IX,DE     ; }
 $F0E1 DJNZ $F0CD    ; Decrease the count and loop back to #R$F0CD.
 $F0E3 RET           ; Return.

; Event: Reveal Furniture
;
; Used by the routine at #R$EDD9.
; .
; Event #N$19: reveal the first furniture item.
@label=Event_RevealFurniture
c$F0E4 LD IX,($6420)   ; #REGix=*#R$6420.
 $F0E8 BIT 7,(IX+$00)  ; {Return if this furniture item is already visible.
 $F0EC RET Z           ; }
 $F0ED RES 7,(IX+$00)  ; Clear bit 7 of the furniture record.
 $F0F1 LD BC,$1E08     ; {Write #N$1E08 to *#R$6472.
 $F0F4 LD ($6472),BC   ; }
 $F0F8 LD C,(IX+$00)   ; {Fetch the column, row, colour and glyph.
 $F0FB LD B,(IX+$01)   ;
 $F0FE LD L,(IX+$02)   ;
 $F101 LD A,(IX+$03)   ;
 $F104 LD E,$03        ;
 $F106 LD D,$04        ; }
 $F108 LD IX,$648B     ; #REGix=#R$648B.
 $F10C CALL $F457      ; Call #R$F457.
 $F10F CALL $F333      ; Call #R$F333.
 $F112 LD A,(IX+$01)   ; {Store the drop row four cells above the furniture.
 $F115 LD (IX+$0F),A   ;
 $F118 SUB $04         ;
 $F11A LD (IX+$01),A   ;
 $F11D LD (IX+$11),A   ;
 $F120 LD (IX+$09),$01 ; }
 $F124 RET             ; Return.

; Event: Reveal Ladder
;
; Used by the routine at #R$EDD9.
; .
; Event #N$1B: reveal the first ladder.
@label=Event_RevealLadder
c$F125 LD IX,($6428)   ; #REGix=*#R$6428.
 $F129 BIT 7,(IX+$00)  ; {Return if this ladder is already visible.
 $F12D RET Z           ; }
 $F12E RES 7,(IX+$00)  ; Clear bit 7 of the ladder record.
 $F132 LD BC,$2207     ; {Write #N$2207 to *#R$6472.
 $F135 LD ($6472),BC   ; }
 $F139 LD C,(IX+$00)   ; {Fetch the column, row and colour; glyph #N$D9.
 $F13C LD B,(IX+$01)   ;
 $F13F LD L,(IX+$02)   ;
 $F142 LD A,$D9        ;
 $F144 LD DE,$0502     ; }
 $F147 LD IX,$648B     ; #REGix=#R$648B.
 $F14B CALL $F457      ; Call #R$F457.
 $F14E CALL $F333      ; Call #R$F333.
 $F151 LD A,(IX+$01)   ; {Store the drop row five cells above the ladder.
 $F154 LD (IX+$0F),A   ;
 $F157 SUB $05         ;
 $F159 LD (IX+$01),A   ;
 $F15C LD (IX+$11),A   ;
 $F15F LD (IX+$09),$01 ; }
 $F163 RET             ; Return.

; Event: Show Enemy
;
; Used by the routines at #R$EDD9, #R$EED2 and #R$EEE5.
; .
; Event #N$18: show the first hidden enemy.
@label=Event_ShowEnemy
c$F164 LD IX,($6432) ; #REGix=*#R$6432.
@label=Event_ShowEnemy_Target
*$F168 LD A,(IX+$00) ; {Return if the terminator #N$FF is reached.
 $F16B CP $FF        ;
 $F16D RET Z         ; }
 $F16E BIT 7,A       ; {Jump to #R$F181 if this enemy is already visible.
 $F170 JR Z,$F181    ; }
 $F172 AND %01111111 ; Keep only bits 0-6.
 $F174 LD (IX+$00),A ; Write the visible ID.
 $F177 LD C,A        ; {#REGbc=the column and row; size #N$03 by #N$02.
 $F178 LD B,(IX+$01) ;
 $F17B LD DE,$0302   ; }
 $F17E CALL $F463    ; Call #R$F463.
@label=Event_ShowEnemy_Skip
*$F181 LD DE,$000E   ; {#REGix+=#N($000E,$04,$04).
 $F184 ADD IX,DE     ; }
 $F186 JR $F168      ; Jump to #R$F168.

; Event: Award Digit
;
; Used by the routine at #R$EDD9.
