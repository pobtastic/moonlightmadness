@label=Event_AwardDigit
c$F188 CALL $F249    ; Call #R$F249.
 $F18B LD BC,$2005   ; {Write #N$2005 to *#R$649F.
 $F18E LD ($649F),BC ; }
 $F192 RET           ; Return.

; Hide Decoration
;
; Used by the routines at #R$EEE5, #R$EF3A, #R$EF5C, #R$F1C4 and #R$F1D4.
; .
; Hides one decoration by filling its tiles with #N$C8.
@label=Reveal_Decoration
c$F193 POP BC         ; Restore the return address from the stack.
 $F194 BIT 7,(IX+$00) ; {Return if this decoration is already hidden.
 $F198 RET NZ         ; }
 $F199 PUSH BC        ; Stash the return address on the stack.
 $F19A LD C,(IX+$00)  ; #REGc=the column.
 $F19D SET 7,(IX+$00) ; Set bit 7 of the decoration record.
 $F1A1 LD B,(IX+$01)  ; #REGb=the row.
 $F1A4 CALL $F43C     ; Call #R$F43C.
 $F1A7 LD DE,$5DCE    ; {Point #REGhl at that #R$5DCE tile.
 $F1AA ADD HL,DE      ; }
 $F1AB LD C,(IX+$04)  ; {#REGbc=the remaining width and height.
 $F1AE LD B,(IX+$05)  ; }
 $F1B1 LD A,$C8       ; #REGa=#N$C8.
 $F1B3 JP $F454       ; Jump to #R$F454.

; Event: Test Header
;
