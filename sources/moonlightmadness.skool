 $F238 LD (IX+$00),A ; }
 $F23B LD B,(IX+$01) ; #REGb=the row.
 $F23E LD DE,$0403   ; {Jump to #R$F463 with size #N$04 by #N$03.
 $F241 JP $F463      ; }

; Event: Bump Digit Three
;
; Used by the routine at #R$EDD9.
