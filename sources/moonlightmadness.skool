 $D53E DEFB $0D
 $D53F DEFM "DW NUMGRA+9"                   ; #STR(#PC,$04,$0B)
 $D54A DEFB $36,$0D
 $D54C DEFM "NUMBER:"                       ; #STR(#PC,$04,$07)
 $D553 DEFB $0D
 $D554 DEFM "LD B,8",$0D                    ; #STR(#PC,$04,$07)
 $D55B DEFM "PUSH DE",$0D                   ; #STR(#PC,$04,$08)
 $D563 DEFM "NL1:"                          ; #STR(#PC,$04,$04)
 $D567 DEFB $0D
 $D568 DEFM "LD A,(HL)",$0D                 ; #STR(#PC,$04,$0A)
 $D572 DEFM "LD (DE),A",$0D                 ; #STR(#PC,$04,$0A)
 $D57C DEFM "INC HL",$0D                    ; #STR(#PC,$04,$07)
 $D583 DEFM "INC E",$0D                     ; #STR(#PC,$04,$06)
 $D589 DEFM "LD A,(HL)",$0D                 ; #STR(#PC,$04,$0A)
 $D593 DEFM "LD (DE),A",$0D                 ; #STR(#PC,$04,$0A)
 $D59D DEFM "DEC E",$0D                     ; #STR(#PC,$04,$06)
 $D5A3 DEFM "INC D",$0D                     ; #STR(#PC,$04,$06)
 $D5A9 DEFB $49,$4E,$43
; View the equivalent code in #BOOTY$A16C.

; Initialise Game
;
; Used by the routine at #R$4885.
; .
; Sets up the stack, copies the default keys, shows the
; introduction screen and installs the interrupt handler.
@label=Initialise_Game
c$D5AC DI            ; Disable interrupts.
 $D5AD LD HL,$5BFF   ; {#REGsp=#N$5BFF.
 $D5B0 LD SP,HL      ; }
 $D5B1 LD DE,$647F   ; {Copy #N($0007,$04,$04) bytes from #R$E6EC to #R$647F.
 $D5B4 LD HL,$E6EC   ;
 $D5B7 LD BC,$0007   ;
 $D5BA LDIR          ; }
 $D5BC XOR A         ; {Write #N$00 to: #LIST
 $D5BD LD ($647E),A  ; { *#R$647E }
 $D5C0 LD ($647C),A  ; { *#R$647C }
                     ; LIST#}
 $D5C3 LD HL,$B370   ; {Write #R$B370 to *#R$6469.
 $D5C6 LD ($6469),HL ; }
 $D5C9 LD HL,$B491   ; {Write #R$B491 to *#R$646B.
 $D5CC LD ($646B),HL ; }
 $D5CF LD A,R        ; {Keep bit 7 of the refresh register set.
 $D5D1 SET 7,A       ;
 $D5D3 LD R,A        ; }
; This entry point is used by the routines at #R$D765, #R$DD37 and #R$DE19.
; .
; Reset the introduction / demo state.
@label=Reset_Introduction
*$D5D5 XOR A         ; {Write #N$00 to *#R$646F.
 $D5D6 LD ($646F),A  ; }
 $D5D9 DI            ; Disable interrupts.
 $D5DA XOR A         ; {Write #N$00 to *#R$641D.
 $D5DB LD ($641D),A  ; }
 $D5DE OUT ($FE),A   ; Set the border to #INK$00.
 $D5E0 LD HL,$9870   ; {Copy #N$1B00 bytes from #R$9870 to #N$4000.
 $D5E3 LD DE,$4000   ;
 $D5E6 LD BC,$1B00   ;
 $D5E9 LDIR          ; }
 $D5EB LD BC,$0190   ; {Write #N$0190 to *#R$6470.
 $D5EE LD ($6470),BC ; }
 $D5F2 CALL $E51D    ; Call #R$E51D.
; Install IM #N$02. Every interrupt vector in the #N$FD page
; holds #N$FE, so the CPU jumps to #R$FEFE, which jumps to #R$E46C.
 $D5F5 LD A,$C3      ; {Write #N$C3 to *#R$FEFE.
 $D5F7 LD ($FEFE),A  ; }
 $D5FA DI            ; Disable interrupts.
 $D5FB LD HL,$E46C   ; {Write #R$E46C after the jump at #R$FEFE.
 $D5FE LD ($FEFF),HL ; }
 $D601 XOR A         ; {Write #N$00 to *#R$646E.
 $D602 LD ($646E),A  ; }
 $D605 LD HL,$0000   ; {Write #N($0000,$04,$04) to *#R$6472.
 $D608 LD ($6472),HL ; }
 $D60B LD A,$FD      ; {Set #N$FD as the high-order byte in #REGi.
 $D60D LD I,A        ; }
 $D60F IM 2          ; Set interrupt mode #N$02.
 $D611 CALL $F42A    ; Call #R$F42A.
 $D614 EI            ; Enable interrupts.
 $D615 LD A,($646F)  ; {Jump to #R$D730 if *#R$646F is set (start a game).
 $D618 OR A          ;
 $D619 JP NZ,$D730   ; }
 $D61C XOR A         ; {Write #N$00 to *#R$641D.
 $D61D LD ($641D),A  ; }
 $D620 OUT ($FE),A   ; Set the border to #INK$00.
 $D622 LD HL,$3C00   ; {Write #N$3C00 to *#SKOOLKID$5C36(CHARS).
 $D625 LD ($5C36),HL ; }
@label=Draw_Menu
*$D628 CALL $E3B3    ; Call #R$E3B3.
; This entry point is used by the routine at #R$D889.
; .
; Print the introduction menu.
@label=Print_Menu
*$D62B LD HL,$E6F3   ; {Print the messaging at #R$E6F3.
 $D62E CALL $F460    ; }
 $D631 LD HL,$E73C   ; {Print the messaging at #R$E73C.
 $D634 CALL $F460    ; }
 $D637 LD A,($647E)  ; {Write #INK$38 to *#SKOOLKID$5C8F(ATTR_T) when Kempston
 $D63A OR A          ; is selected.
 $D63B JR NZ,$D642   ;
 $D63D LD A,$38      ;
 $D63F LD ($5C8F),A  ; }
@label=Print_Menu_Keyboard
*$D642 LD HL,$E750   ; {Print the messaging at #R$E750.
 $D645 CALL $F460    ; }
 $D648 LD A,($647E)  ; {Write #INK$38 to *#SKOOLKID$5C8F(ATTR_T) when the
 $D64B OR A          ; keyboard is selected.
 $D64C JR Z,$D653    ;
 $D64E LD A,$38      ;
 $D650 LD ($5C8F),A  ; }
@label=Print_Menu_DefineKeys
*$D653 LD HL,$E762   ; {Print the messaging at #R$E762.
 $D656 CALL $F460    ; }
 $D659 LD A,($647E)  ; {Jump to #R$D673 if *#R$647E is zero.
 $D65C OR A          ;
 $D65D JR Z,$D673    ; }
; Wait for a Kempston menu choice.
 $D65F LD B,$FF      ; #REGb=#N$FF.
@label=Menu_Kempston_Loop
*$D661 CALL $D826    ; Call #R$D826.
 $D664 JR NZ,$D66B   ; Jump to #R$D66B if the port is unstable.
 $D666 CP $10        ; {Jump to #R$D730 if fire was pressed.
 $D668 JP Z,$D730    ; }
@label=Menu_Kempston_Next
*$D66B DEC BC        ; {Jump to #R$D661 until #REGbc is zero.
 $D66C LD A,C        ;
 $D66D OR B          ;
 $D66E JR NZ,$D661   ; }
 $D670 JP $D889      ; Jump to #R$D889.
; Keyboard menu. Codes are from #SKOOLKID$028E(KEY_SCAN).
@label=Menu_Keyboard_Loop
*$D673 LD B,$03      ; {Call #R$F430 with a pause of #N$03.
 $D675 CALL $F430    ; }
 $D678 CALL $028E    ; Call #SKOOLKID$028E(KEY_SCAN).
 $D67B LD A,E        ; #REGa=the keypress.
 $D67C CP $23        ; {Jump to #R$D730 if "0" was pressed.
 $D67E JP Z,$D730    ; }
 $D681 CP $24        ; {Jump to #R$D889 if "1" was pressed.
 $D683 JP Z,$D889    ; }
 $D686 CP $1C        ; {Jump to #R$D88C if "2" was pressed.
 $D688 JP Z,$D88C    ; }
 $D68B CP $14        ; {Jump to #R$D673 if the key was not "3".
 $D68D JR NZ,$D673   ; }
; Define the five user keys.
 $D68F CALL $E3B3    ; Call #R$E3B3.
 $D692 LD HL,$E6F3   ; {Print the messaging at #R$E6F3.
 $D695 CALL $F460    ; }
 $D698 LD HL,$E78F   ; {Print the messaging at #R$E78F.
 $D69B CALL $F460    ; }
@label=DefineKeys_Restart
*$D69E XOR A         ; {Write #N$00 to *#R$647E.
 $D69F LD ($647E),A  ; }
 $D6A2 LD B,$00      ; #REGb=#N$00.
@label=DefineKeys_Loop
*$D6A4 PUSH BC       ; Stash the key index on the stack.
 $D6A5 LD C,$1B      ; {Print at column #N$1B, row #N$05+index*#N$02.
 $D6A7 LD A,$04      ;
 $D6A9 SUB B         ;
 $D6AA SLA A         ;
 $D6AC ADD A,$05     ;
 $D6AE LD B,A        ; }
 $D6AF CALL $F42D    ; Call #R$F42D.
 $D6B2 POP BC        ; {Restore and restash the key index.
 $D6B3 PUSH BC       ; }
 $D6B4 LD A,($647E)  ; {Highlight the current slot in #INK$38.
 $D6B7 CP B          ;
 $D6B8 JR NZ,$D6BF   ;
 $D6BA LD A,$38      ;
 $D6BC LD ($5C8F),A  ; }
@label=DefineKeys_PrintSlot
*$D6BF LD DE,$647F   ; {#REGhl=#R$647F+#REGbc.
 $D6C2 LD L,B        ;
 $D6C3 LD H,$00      ;
 $D6C5 ADD HL,DE     ;
 $D6C6 LD A,(HL)     ;
 $D6C7 LD E,A        ;
 $D6C8 LD D,$00      ; }
 $D6CA LD HL,$E802   ; {Print the glyph from #R$E802 for this slot.
 $D6CD ADD HL,DE     ;
 $D6CE LD A,(HL)     ;
 $D6CF CALL $F436    ; }
 $D6D2 LD A,$07      ; {Write #INK$07 to *#SKOOLKID$5C8F(ATTR_T).
 $D6D4 LD ($5C8F),A  ; }
 $D6D7 POP BC        ; Restore the key index from the stack.
 $D6D8 INC B         ; {Increase the key index and jump to #R$D6A4 until
 $D6D9 LD A,B        ; five keys have been printed.
 $D6DA CP $05        ;
 $D6DC JR NZ,$D6A4   ; }
@label=DefineKeys_Read
*$D6DE LD BC,$4E20   ; {Call #R$F430 with a pause of #N$4E20.
 $D6E1 CALL $F430    ; }
 $D6E4 CALL $028E    ; Call #SKOOLKID$028E(KEY_SCAN).
 $D6E7 LD A,E        ; #REGa=the keypress.
 $D6E8 CP $FF        ; {Jump to #R$D6DE if no key is pressed.
 $D6EA JR Z,$D6DE    ; }
 $D6EC CP $20        ; {Jump to #R$D706 if ENTER was pressed.
 $D6EE JR Z,$D706    ; }
 $D6F0 LD BC,($647E) ; {Write the key into the current slot at #R$647F.
 $D6F4 LD B,$00      ;
 $D6F6 LD HL,$647F   ;
 $D6F9 ADD HL,BC     ; }
 $D6FA LD (HL),A     ; {Increase *#R$647E by one.
 $D6FB LD A,($647E)  ;
 $D6FE INC A         ;
 $D6FF LD ($647E),A  ; }
 $D702 CP $05        ; {Jump to #R$D6A4 if fewer than five keys are set.
 $D704 JR NZ,$D6A4   ; }
; Reject a set that contains any duplicate key.
@label=DefineKeys_CheckDuplicates
*$D706 LD HL,$647F   ; {#REGhl=#R$647F, #REGde=#R$6480, #REGb=#N$04.
 $D709 LD DE,$6480   ;
 $D70C LD B,$04      ; }
@label=DefineKeys_Compare
*$D70E PUSH DE       ; {Stash the compare pointers on the stack.
 $D70F PUSH BC       ; }
@label=DefineKeys_CompareSlot
*$D710 LD A,(DE)     ; {Jump to #R$D719 if this pair differs.
 $D711 CP (HL)       ;
 $D712 JR NZ,$D719   ; }
 $D714 POP BC        ; {Restart define-keys if a duplicate was found.
 $D715 POP DE        ;
 $D716 JP $D69E      ; }
@label=DefineKeys_CompareNext
*$D719 INC DE        ; Increase #REGde by one.
 $D71A DJNZ $D710    ; Decrease the inner counter and loop back to #R$D710.
 $D71C POP BC        ; {Restore the compare pointers from the stack.
 $D71D POP DE        ; }
 $D71E INC HL        ; {Increase both pointers by one.
 $D71F INC DE        ; }
 $D720 DEC B         ; {Jump to #R$D70E until every pair is unique.
 $D721 JR NZ,$D70E   ; }
 $D723 LD HL,($647F) ; {Copy the first two keys to *#R$6484.
 $D726 LD ($6484),HL ; }
 $D729 XOR A         ; {Write #N$00 to *#R$647E.
 $D72A LD ($647E),A  ; }
 $D72D JP $D628      ; Jump to #R$D628.
; View the equivalent code in #BOOTY$CD14.

; Start Game
;
; Used by the routine at #R$D5AC.
; .
; Starts a new game from room #N$00.
@label=Start_Game
c$D730 LD HL,$03E8   ; {Write #N$03E8 to *#R$E82A.
 $D733 LD ($E82A),HL ; }
 $D736 LD A,$FF      ; #REGa=#N$FF.
; View the equivalent code in #BOOTY$D08A.
; .
; Continue on to #R$D738.

; Change Room
;
; Used by the routines at #R$D765, #R$DCF5, #R$DD03, #R$DD22, #R$DD37 and
; #R$DE19.
; .
; Loads the room in #REGa.
@label=Change_Room
c$D738 CALL $E9FC    ; Call #R$E9FC.
 $D73B CALL $DA15    ; Call #R$DA15.
 $D73E LD BC,$0096   ; {Write #N$0096 to *#R$6470.
 $D741 LD ($6470),BC ; }
 $D745 LD A,$FF      ; {Write #N$FF to *#R$DAC3.
 $D747 LD ($DAC3),A  ; }
 $D74A LD A,($647D)  ; {Jump to #R$D765 if *#R$647D is zero.
 $D74D OR A          ;
 $D74E JR Z,$D765    ; }
 $D750 LD A,($64A2)  ; {Jump to #R$D765 if *#R$64A2 is not zero.
 $D753 OR A          ;
 $D754 JR NZ,$D765   ; }
 $D756 LD A,$1D      ; {Call #R$E9FF with event #N$1D.
 $D758 CALL $E9FF    ; }
 $D75B LD HL,($6422) ; {Write #N$12 to the door pointed to by *#R$6422.
 $D75E LD (HL),$12   ; }
 $D760 LD A,$01      ; {Write #N$01 to *#R$64B4.
 $D762 LD ($64B4),A  ; }
; Continue on to #R$D765.

; Game Loop
;
; Used by the routines at #R$D738 and #R$D7A2.
; .
; Watches demo input and *#R$6470. Jumps to #R$D7A2 while
; the game is active or the demo timer is running, else picks a
; room and jumps to #R$D738.
@label=Game_Loop
c$D765 LD A,($646F)  ; {Jump to #R$D7A2 if *#R$646F is zero.
 $D768 OR A          ;
 $D769 JR Z,$D7A2    ; }
 $D76B CALL $D826    ; Call #R$D826.
 $D76E JR NZ,$D775   ; Jump to #R$D775 if the port is unstable.
 $D770 CP $10        ; {Jump to #R$D5D5 if fire was pressed.
 $D772 JP Z,$D5D5    ; }
@label=Demo_Timeout
*$D775 CALL $028E    ; Call #SKOOLKID$028E(KEY_SCAN).
 $D778 LD A,E        ; {Jump to #R$D5D5 if any key is pressed.
 $D779 INC A         ;
 $D77A JP NZ,$D5D5   ; }
 $D77D LD BC,($6470) ; {Decrease *#R$6470 by one.
 $D781 DEC BC        ;
 $D782 LD ($6470),BC ; }
 $D786 LD A,B        ; {Jump to #R$D7A2 until the timer is zero.
 $D787 OR C          ;
 $D788 JR NZ,$D7A2   ; }
 $D78A LD A,($D888)  ; {Jump to #R$D5D5 if *#R$D888 is #N$01.
 $D78D DEC A         ;
 $D78E JP Z,$D5D5    ; }
 $D791 LD ($D888),A  ; Write the decreased count back to *#R$D888.
; Pick a random room between #N$00-#N$16 and jump to #R$D738.
 $D794 CALL $F433    ; {Generate a random number between #N$00-#N$0F in #REGe.
 $D797 AND %00001111 ;
 $D799 LD E,A        ; }
 $D79A CALL $F433    ; {Generate a random number between #N$00-#N$07 and add it
 $D79D AND %00000111 ; to #REGe.
 $D79F ADD A,E       ; }
 $D7A0 JR $D738      ; Jump to #R$D738.

; Dispatch Handlers
;
; Used by the routine at #R$D765.
; .
; Calls each frame handler, then jumps back to #R$D765.
@label=Dispatch_Handlers
c$D7A2 CALL $DD97    ; Call #R$DD97.
 $D7A5 CALL $DE19    ; Call #R$DE19.
 $D7A8 CALL $E3DE    ; Call #R$E3DE.
 $D7AB CALL $E1CC    ; Call #R$E1CC.
 $D7AE CALL $D7FF    ; Call #R$D7FF.
 $D7B1 CALL $DC26    ; Call #R$DC26.
 $D7B4 CALL $DC62    ; Call #R$DC62.
 $D7B7 CALL $D894    ; Call #R$D894.
 $D7BA CALL $D9B6    ; Call #R$D9B6.
 $D7BD CALL $D904    ; Call #R$D904.
 $D7C0 CALL $DB05    ; Call #R$DB05.
 $D7C3 CALL $DBC9    ; Call #R$DBC9.
 $D7C6 CALL $D7D2    ; Call #R$D7D2.
 $D7C9 CALL $DA3F    ; Call #R$DA3F.
 $D7CC CALL $D877    ; Call #R$D877.
 $D7CF JP $D765      ; Jump to #R$D765.

; Handler: Collectibles
;
; Used by the routine at #R$D7A2.
; .
; Walks the #N$03-byte records at *#R$6424. When the player
; stands on an active record, bit 7 is set and #R$E9FF runs.
@label=Handler_Collectibles
c$D7D2 LD IX,($6424) ; #REGix=*#R$6424.
@label=Handler_Collectibles_Loop
*$D7D6 LD A,(IX+$00) ; {Return if the terminator #N$FF is reached.
 $D7D9 CP $FF        ; }
 $D7DB RET Z         ; {Jump to #R$D7F8 if this record is already collected.
 $D7DC BIT 7,A       ;
 $D7DE JR NZ,$D7F8   ; }
 $D7E0 LD A,($64A4)  ; {Jump to #R$D7F8 if the column does not match *#R$64A4.
 $D7E3 CP (IX+$00)   ;
 $D7E6 JR NZ,$D7F8   ; }
 $D7E8 LD A,($64A5)  ; {Jump to #R$D7F8 if the row does not match *#R$64A5.
 $D7EB CP (IX+$01)   ;
 $D7EE JR NZ,$D7F8   ; }
 $D7F0 LD A,(IX+$02) ; {Set bit 7 of the record.
 $D7F3 SET 7,A       ; }
 $D7F5 JP $E9FF      ; Jump to #R$E9FF.
; Advance to the next collectible record.
@label=Handler_Collectibles_Next
*$D7F8 LD DE,$0003   ; {#REGix+=#N($0003,$04,$04).
 $D7FB ADD IX,DE     ; }
 $D7FD JR $D7D6      ; Jump to #R$D7D6.

; Handler: Housekeeping
;
; Used by the routine at #R$D7A2.
; .
; Marks the game complete when the combination is #N$09 in
; every #R$64C1 slot, then ticks #R$6489.
@label=Handler_Housekeeping
c$D7FF LD HL,$64C1   ; {Test whether the combination is complete (every digit
 $D802 LD B,$04      ; is #N$09).
 $D804 LD A,$09      ; }
; Compare each combination digit with #N$09.
@label=Handler_Housekeeping_SlotLoop
*$D806 CP (HL)       ; {Jump to #R$D818 if this slot differs.
 $D807 JR NZ,$D818   ; }
 $D809 INC HL        ; Advance to the next slot.
 $D80A DJNZ $D806    ; Decrease the slot count and loop back to #R$D806.
 $D80C LD A,($64A1)  ; {Jump to #R$D818 unless *#R$64A1 is #N$10.
 $D80F CP $10        ;
 $D811 JR NZ,$D818   ; }
 $D813 LD A,$FF      ; {Write #N$FF to *#R$647D.
 $D815 LD ($647D),A  ; }
; Tick the action timer.
@label=Handler_Housekeeping_Timer
*$D818 LD A,($6489)  ; {Return if *#R$6489 is zero.
 $D81B OR A          ;
 $D81C RET Z         ; }
 $D81D DEC A         ; {Decrease *#R$6489 by one.
 $D81E LD ($6489),A  ; }
 $D821 OR A          ; {Return if the timer is still running.
 $D822 RET NZ        ; }
 $D823 JP $DF22      ; Jump to #R$DF22.

; Read Kempston
;
; Used by the routines at #R$D5AC, #R$D765, #R$D82D and #R$D864.
; .
; Reads the Kempston port twice and returns with the Z
; flag set if the two reads match.
;
; O:A Kempston port value
; O:F Z flag set if the two reads match
@label=Read_Kempston
c$D826 IN A,($1F)    ; {Read from the Kempston joystick port twice.
 $D828 LD E,A        ;
 $D829 IN A,($1F)    ; }
 $D82B CP E          ; Set the Z flag if the two reads match.
 $D82C RET           ; Return.

; Handler: Kempston
;
; Used by the routine at #R$E1CC.
; .
; Reads Kempston and walks, climbs, jumps or fires.
;
; .
;
; Fetch the left/right Kempston masks.
@label=Controls_Kempston
c$D82D LD HL,($6486) ; Fetch the left mask into #REGl and the right mask into
                     ; #REGh.
; Walk left.
 $D830 CALL $D826    ; {Call #R$DF44 if left matches the stored mask.
 $D833 JR NZ,$D839   ;
 $D835 CP L          ;
 $D836 CALL Z,$DF44  ; }
; Walk right.
@label=Controls_Kempston_Right
*$D839 CALL $D826    ; {Call #R$DF69 if right matches the stored mask.
 $D83C JR NZ,$D842   ;
 $D83E CP H          ;
 $D83F CALL Z,$DF69  ; }
; Climb up, or start a jump.
@label=Controls_Kempston_Up
*$D842 CALL $D826    ; {Call #R$E06A if up (bit 3) is pressed.
 $D845 JR NZ,$D84C   ;
 $D847 CP $08        ;
 $D849 CALL Z,$E06A  ; }
; Climb down.
@label=Controls_Kempston_Down
*$D84C CALL $D826    ; {Call #R$E013 if down (bit 2) is pressed.
 $D84F JR NZ,$D856   ;
 $D851 CP $04        ;
 $D853 CALL Z,$E013  ; }
; Fire / use the furniture.
@label=Controls_Kempston_Action
*$D856 CALL $D826    ; {Call #R$DF8E if fire (bit 4) is pressed.
 $D859 JP NZ,$E28C   ;
 $D85C CP $10        ;
 $D85E CALL Z,$DF8E  ; }
; Resolve the player movement.
 $D861 JP $E28C      ; Jump to #R$E28C.

; Handler: Kempston Climb
;
; Used by the routine at #R$DE19.
; .
; Reads Kempston while climbing and jumps to the matching
; climb routine.
;
; .
;
; Bail out if the port is unstable.
@label=Controls_Kempston_Climb
c$D864 CALL $D826    ; Call #R$D826.
 $D867 JP NZ,$E358   ; Jump to #R$E358 if the port is unstable.
; Climb up.
 $D86A CP $08        ; {Jump to #R$E145 if up (bit 3) is pressed.
 $D86C JP Z,$E145    ; }
; Climb down.
 $D86F CP $04        ; {Jump to #R$E130 if down (bit 2) is pressed.
 $D871 JP Z,$E130    ; }
; Hold the current climb if neither direction is pressed.
 $D874 JP $E358      ; Jump to #R$E358.

; Handler: Room Pause
;
; Used by the routine at #R$D7A2.
; .
; Pauses using the per-room delay at #R$E82A.
@label=Handler_RoomPause
c$D877 LD DE,($64A2) ; {#REGbc=*#R$E82A+(*#R$64A2)*#N$02.
 $D87B LD D,$00      ;
 $D87D LD HL,$E82A   ;
 $D880 ADD HL,DE     ;
 $D881 ADD HL,DE     ;
 $D882 LD C,(HL)     ;
 $D883 INC HL        ;
 $D884 LD B,(HL)     ; }
 $D885 JP $F430      ; Jump to #R$F430.

; Demo Room Count
;
; Remaining demo rooms before returning to the menu.
@label=Demo_RoomCount
g$D888 DEFB $00

; Select Control Method
;
; Used by the routine at #R$D5AC.
; .
; Selects keyboard (#N$00) or Kempston (#N$FF) and returns
; to the menu.
;
; .
;
; Select keyboard.
@label=Select_Keyboard
c$D889 XOR A         ; {Set keyboard (#N$00) and jump to #R$D88E.
 $D88A JR $D88E      ; }
; This entry point is used by the routine at #R$D5AC.
; .
; Select Kempston.
@label=Select_Kempston
*$D88C XOR A         ; {Set Kempston (#N$FF).
 $D88D DEC A         ; }
; Write the control method and return to the menu.
@label=Select_ControlMethod
*$D88E LD ($647E),A  ; Write #REGa to *#R$647E.
 $D891 JP $D62B      ; Jump to #R$D62B.

; Handler: Moving Objects
;
; Used by the routine at #R$D7A2.
; .
; Animates the #N$13-byte records at *#R$642A.
;
; .
;
; Walk the moving-object list.
@label=Handler_MovingObjects
c$D894 LD IX,($642A)  ; Point #REGix at the moving-object list.
; Skip inactive objects and expired timers.
@label=Handler_MovingObjects_Loop
*$D898 LD A,(IX+$00)  ; {Jump to #R$D8FC if the terminator #N$FF is reached.
 $D89B CP $FF         ; }
 $D89D JR Z,$D8FC     ; {Jump to #R$D8F5 if this object is inactive.
 $D89F BIT 7,A        ; }
 $D8A1 JR NZ,$D8F5    ; {Deactivate the object if its timer is zero.
 $D8A3 XOR A          ;
 $D8A4 CP (IX+$01)    ;
 $D8A7 JR NZ,$D8AF    ; }
 $D8A9 SET 7,(IX+$00) ; {Jump to #R$D8F5.
 $D8AD JR $D8F5       ; }
; Set the font and clip window.
@label=Handler_MovingObjects_Draw
*$D8AF LD HL,$7C70    ; {Use #R$7C70, or #R$9070 when the stored font ID
 $D8B2 CP (IX+$12)    ; differs.
 $D8B5 JR Z,$D8BA     ;
 $D8B7 LD HL,$9070    ; }
@label=Handler_MovingObjects_Font
*$D8BA LD ($5C36),HL  ; Write #REGhl to *#SKOOLKID$5C36(CHARS).
 $D8BD LD C,(IX+$10)  ; {Write the object's clip window to *#R$6419.
 $D8C0 LD B,(IX+$11)  ;
 $D8C3 LD ($6419),BC  ; }
 $D8C7 CALL $F448     ; Call #R$F448.
; Test the moving edge against the stored limit.
 $D8CA LD A,(IX+$09)  ; {Compare the moving edge against the stored limit.
 $D8CD OR A           ;
 $D8CE LD A,B         ;
 $D8CF JR NZ,$D8D2    ; }
 $D8D1 LD A,C         ; {Jump to #R$D8E9 if they differ.
@label=Handler_MovingObjects_LimitHit
*$D8D2 CP (IX+$0E)    ;
 $D8D5 JR NZ,$D8E9    ; }
; Reverse at the stored limit.
 $D8D7 CALL $DC37     ; Call #R$DC37.
 $D8DA LD A,(IX+$0E)  ; {Swap the two limit bytes.
 $D8DD LD B,(IX+$0F)  ;
 $D8E0 LD (IX+$0F),A  ;
 $D8E3 LD (IX+$0E),B  ; }
 $D8E6 CALL $F448     ; Call #R$F448.
; Store, move, draw and erase the object.
@label=Handler_MovingObjects_Update
*$D8E9 CALL $F424     ; Call #R$F424.
 $D8EC CALL $F442     ; Call #R$F442.
 $D8EF CALL $F44B     ; Call #R$F44B.
 $D8F2 CALL $F44E     ; Call #R$F44E.
; Advance to the next moving object.
@label=Handler_MovingObjects_Next
*$D8F5 LD DE,$0013    ; {#REGix+=#N($0013,$04,$04).
 $D8F8 ADD IX,DE      ; }
 $D8FA JR $D898       ; Jump to #R$D898.
; Restore the default clip window.
@label=Handler_MovingObjects_Done
*$D8FC LD BC,$0218    ; {Write #N$0218 to *#R$6419.
 $D8FF LD ($6419),BC  ; }
 $D903 RET            ; Return.

; Handler: Room Sixteen
;
; Used by the routine at #R$D7A2.
; .
; Special actor for room #N$16.
;
; .
;
; Return unless this is room #N$16.
@label=Handler_RoomSixteen
c$D904 LD A,($64A2)    ; {Return if *#R$64A2 is not #N$16.
 $D907 CP $16          ;
 $D909 RET NZ          ; }
; Point at the special actor and set the clip window.
 $D90A LD IX,$644D     ; Point #REGix at #R$644D.
 $D90E LD BC,$051D     ; {Write #N$051D to *#R$641B.
 $D911 LD ($641B),BC   ; }
; Draw the actor if it is already active.
 $D915 BIT 7,(IX+$00)  ; {Jump to #R$D994 if the actor is already active.
 $D919 JR Z,$D994      ; }
; Only spawn when the player is on a trigger row.
 $D91B LD A,($64A5)    ; {Jump to #R$D92B if the player row is #N($07), #N$14 or
 $D91E CP $07          ; #N($11), otherwise jump to #R$D9AE.
 $D920 JR Z,$D92B      ;
 $D922 CP $14          ;
 $D924 JR Z,$D92B      ;
 $D926 CP $11          ;
 $D928 JP NZ,$D9AE     ; }
; Only spawn when the player is in the trigger columns.
@label=Handler_RoomSixteen_Column
*$D92B LD A,($64A4)    ; {Jump to #R$D9AE unless the player column is
 $D92E CP $17          ; #N$0F-#N$16.
 $D930 JP NC,$D9AE     ;
 $D933 CP $0F          ;
 $D935 JR C,$D9AE      ; }
; Spawn on a random roll.
 $D937 CALL $F433      ; {Jump to #R$D9AE if the random number is #N$DC or
 $D93A CP $DC          ; higher.
 $D93C JR NC,$D9AE     ; }
; #UDGTABLE
; { #SPRITE$E6,$47(sprite-e6) }
; UDGTABLE#
 $D93E LD A,$E6        ; {Spawn the actor with sprite #N($E6), colour #INK$47
 $D940 LD L,$47        ; and size #N$01 by #N$01.
 $D942 LD DE,$0101     ;
 $D945 CALL $F457      ; }
; Choose left or right movement.
 $D948 CALL $F433      ; {Jump to #R$D95D if the random number is #N$80 or
 $D94B CP $80          ; higher.
 $D94D JR NC,$D95D     ; }
 $D94F LD (IX+$00),$1E ; {Start at column #N$1E and write #N$FB as the
 $D953 LD (IX+$0A),$1E ; horizontal delta.
 $D957 LD (IX+$08),$FB ; }
 $D95B JR $D969        ; Jump to #R$D969.
; Start on the left and move right.
@label=Handler_RoomSixteen_Right
*$D95D LD (IX+$00),$05 ; {Start at column #N$05 and write #N$05 as the
 $D961 LD (IX+$0A),$05 ; horizontal delta.
 $D965 LD (IX+$08),$05 ; }
; Sound the actor appearing.
; #HTML(#AUDIO0(noise.wav)(#INCLUDE(Noise)))
@label=Handler_RoomSixteen_Sound
*$D969 LD B,$FF        ; {Call #R$E4B1 with mask #N$FF and #N$32 iterations.
 $D96B LD D,$32        ;
 $D96D CALL $E4B1      ; }
; Choose the actor row.
 $D970 LD A,($64A5)    ; {Jump to #R$D982 if the player row is #N$14.
 $D973 CP $14          ;
 $D975 JR Z,$D982      ; }
 $D977 CP $11          ; {Jump to #R$D98C if the player row is #N$11.
 $D979 JR Z,$D98C      ; }
 $D97B CALL $F433      ; {Jump to #R$D98C if the random number is #N$80 or
 $D97E CP $80          ; higher.
 $D980 JR NC,$D98C     ; }
@label=Handler_RoomSixteen_RowLow
*$D982 LD (IX+$01),$13 ; {Write row #N$13 into the actor.
 $D986 LD (IX+$0B),$13 ; }
 $D98A JR $D994        ; Jump to #R$D994.
@label=Handler_RoomSixteen_RowHigh
*$D98C LD (IX+$01),$10 ; {Write row #N$10 into the actor.
 $D990 LD (IX+$0B),$10 ; }
; Store, move, draw and erase the actor.
@label=Handler_RoomSixteen_Draw
*$D994 CALL $F448      ; Call #R$F448.
 $D997 CALL $F424      ; Call #R$F424.
 $D99A CALL $F442      ; Call #R$F442.
 $D99D CALL $F44B      ; Call #R$F44B.
 $D9A0 CALL $F44E      ; Call #R$F44E.
; Hide the actor once it has left the room.
 $D9A3 LD A,(IX+$00)   ; {Deactivate the actor once column #N$23 is passed.
 $D9A6 CP $23          ;
 $D9A8 JR C,$D9AE      ;
 $D9AA LD (IX+$00),$80 ; }
; Restore the clip window.
@label=Handler_RoomSixteen_Done
*$D9AE LD BC,$0121     ; {Write #N$0121 to *#R$641B.
 $D9B1 LD ($641B),BC   ; }
 $D9B5 RET             ; Return.

; Handler: Room Seven
;
; Used by the routine at #R$D7A2.
; .
; Two balls in room #N$07, stored at #R$644D.
;
; .
;
; Return unless this is room #N$07.
@label=Handler_RoomSeven
c$D9B6 LD IX,$644D     ; Point #REGix at #R$644D.
 $D9BA LD A,($64A2)    ; {Return if *#R$64A2 is not #N$07.
 $D9BD CP $07          ;
 $D9BF RET NZ          ; }
; Clip drawing to a maximum row of #N$0E.
 $D9C0 LD A,$0E        ; {Write #N$0E to *#R$641A.
 $D9C2 LD ($641A),A    ; }
 $D9C5 LD B,$02        ; Set the ball count to #N$02.
; Process each ball.
@label=Handler_RoomSeven_Loop
*$D9C7 PUSH BC         ; Stash the ball count on the stack.
; Draw the ball if it is already active.
 $D9C8 LD A,(IX+$00)   ; {Jump to #R$D9EB if this ball is already active.
 $D9CB BIT 7,A         ;
 $D9CD JR Z,$D9EB      ; }
; Spawn on a random roll.
 $D9CF CALL $F433      ; {Jump to #R$DA07 if the random number is #N$BE or
 $D9D2 CP $BE          ; higher.
 $D9D4 JR NC,$DA07     ; }
; #UDGTABLE
; { #SPRITE$E7,$46(sprite-e7) }
; UDGTABLE#
 $D9D6 AND %00001111   ; Keep only bits 0-3.
 $D9D8 ADD A,$09       ; {Spawn the ball at row #N$19, column #N$09-#N$18,
 $D9DA LD C,A          ; sprite #N($E7), colour #INK$46 and size #N$01 by #N$01.
 $D9DB LD B,$19        ;
 $D9DD LD DE,$0101     ;
 $D9E0 LD L,$46        ;
 $D9E2 LD A,$E7        ;
 $D9E4 CALL $F457      ; }
 $D9E7 LD (IX+$09),$FA ; Write #N$FA as the vertical delta.
; Hide the ball once it has reached row #N$0C.
@label=Handler_RoomSeven_Move
*$D9EB LD A,(IX+$01)   ; {Deactivate the ball if it has reached row #N$0C.
 $D9EE CP $0C          ;
 $D9F0 JR NZ,$D9F8     ;
 $D9F2 SET 7,(IX+$00)  ; }
 $D9F6 JR $DA07        ; Jump to #R$DA07.
; Store, move, draw and erase the ball.
@label=Handler_RoomSeven_Draw
*$D9F8 CALL $F448      ; Call #R$F448.
 $D9FB CALL $F424      ; Call #R$F424.
 $D9FE CALL $F442      ; Call #R$F442.
 $DA01 CALL $F44B      ; Call #R$F44B.
 $DA04 CALL $F44E      ; Call #R$F44E.
; Step to the next ball.
@label=Handler_RoomSeven_Next
*$DA07 POP BC          ; Restore the ball count from the stack.
 $DA08 LD DE,$000E     ; {#REGix+=#N($000E,$04,$04).
 $DA0B ADD IX,DE       ; }
 $DA0D DJNZ $D9C7      ; Decrease the ball count and loop back to #R$D9C7.
; Reset the clip maximum row.
 $DA0F LD A,$02        ; {Write #N$02 to *#R$641A.
 $DA11 LD ($641A),A    ; }
 $DA14 RET             ; Return.

; Print Key Bar
;
; Used by the routines at #R$D738 and #R$DBC9.
; .
; Draws the #N$10 collected-key icons along the bottom
; of the screen.
;
; .
;
; Set the icon font and print position.
@label=Print_KeyBar
c$DA15 LD HL,$7C70   ; {Write #R$7C70 to *#SKOOLKID$5C36(CHARS).
 $DA18 LD ($5C36),HL ; }
 $DA1B LD BC,$0119   ; {Call #R$F42D at column #N$19, row #N$01 (the
 $DA1E CALL $F42D    ; bottom line).}
; Start the key loop.
 $DA21 LD B,$00      ; Start at key #N$00.
 $DA23 LD A,$07      ; {Write #INK$07 to *#SKOOLKID$5C8F(ATTR_T).
 $DA25 LD ($5C8F),A  ; }
; Skip the highlight unless this key matches *#R$64A1.
@label=Print_KeyBar_Loop
*$DA28 LD A,($64A1)  ; {Jump to #R$DA33 unless this key matches *#R$64A1.
 $DA2B CP B          ;
 $DA2C JR NZ,$DA33   ; }
; Highlight this key.
 $DA2E LD A,$38      ; {Write #INK$38 to *#SKOOLKID$5C8F(ATTR_T).
 $DA30 LD ($5C8F),A  ; }
; #UDGTABLE
; { #GLYPH$E4,$07(glyph-e4) }
; UDGTABLE#
@label=Print_KeyBar_Glyph
*$DA33 LD A,$E4      ; {Print key glyph #N$E4.
 $DA35 CALL $F436    ; }
 $DA38 INC B         ; {Jump to #R$DA28 until #N$10 keys are printed.
 $DA39 LD A,B        ;
 $DA3A CP $10        ;
 $DA3C JR NZ,$DA28   ; }
 $DA3E RET           ; Return.

; Handler: Carried Object
;
; Used by the routine at #R$D7A2.
; .
; Draws #R$648B and drops it when it lines up with a slot.
;
; .
;
; Point at the carried object.
@label=Handler_CarriedObject
c$DA3F LD HL,$7C70    ; {Write #R$7C70 to *#SKOOLKID$5C36(CHARS).
 $DA42 LD ($5C36),HL  ; }
 $DA45 LD IX,$648B    ; Point #REGix at #R$648B.
; Return unless something is being carried.
 $DA49 LD A,(IX+$00)  ; {Return if nothing is being carried.
 $DA4C BIT 7,A        ;
 $DA4E RET NZ         ; }
; Stash the clip window and use the object's.
 $DA4F LD HL,($6419)  ; {Stash the current clip window on the stack.
 $DA52 PUSH HL        ;
 $DA53 LD HL,($641B)  ;
 $DA56 PUSH HL        ; }
 $DA57 LD L,(IX+$10)  ; {Write the object's clip window to *#R$6419.
 $DA5A LD H,(IX+$11)  ;
 $DA5D LD ($6419),HL  ;
 $DA60 LD L,(IX+$12)  ;
 $DA63 LD H,(IX+$13)  ;
 $DA66 LD ($641B),HL  ; }
; Store and draw the object.
 $DA69 CALL $F448     ; Call #R$F448.
 $DA6C CALL $F424     ; Call #R$F424.
 $DA6F CALL $F44B     ; Call #R$F44B.
; Restore the clip window.
 $DA72 POP HL         ; {Restore the clip window from the stack.
 $DA73 LD ($641B),HL  ;
 $DA76 POP HL         ;
 $DA77 LD ($6419),HL  ; }
; Only drop when the object is cell-aligned.
 $DA7A LD A,$07       ; {Return unless both fine offsets are #N$07.
 $DA7C CP (IX+$03)    ;
 $DA7F RET NZ         ;
 $DA80 CP (IX+$02)    ;
 $DA83 RET NZ         ; }
; Only drop on the stored drop cell.
 $DA84 LD A,(IX+$00)  ; {Return unless the column and row match the
 $DA87 CP (IX+$0E)    ; stored drop cell.
 $DA8A RET NZ         ;
 $DA8B LD A,(IX+$01)  ;
 $DA8E CP (IX+$0F)    ;
 $DA91 RET NZ         ; }
; Stamp the object into the room.
 $DA92 LD C,(IX+$00)  ; {Call #R$F445 with the object's cell, size and
 $DA95 LD B,(IX+$01)  ; sprite ID.
 $DA98 LD E,(IX+$04)  ;
 $DA9B LD D,(IX+$05)  ;
 $DA9E LD A,(IX+$06)  ;
 $DAA1 CALL $F445     ; }
; Mark it as no longer carried.
 $DAA4 SET 7,(IX+$00) ; Set bit 7 of *#REGix+#N$00.
; Only the #R$F125 object writes a window into the room.
; #UDGTABLE { #GLYPH$D9(object-d9) } UDGTABLE#
 $DAA8 LD A,(IX+$06)  ; {Skip the window write unless this is #N$D9.
 $DAAB CP $D9         ;
 $DAAD RET NZ         ; }
 $DAAE LD C,(IX+$00)  ; {Convert the drop cell into a #R$5DCE offset.
 $DAB1 LD B,(IX+$01)  ;
 $DAB4 RES 7,C        ;
 $DAB6 CALL $F43C     ; }
; Write a 2-wide window into those tiles.
; #UDGTABLE
; { #GLYPH$0E,$47,$8470(window-0e) | #GLYPH$0F,$47,$8470(window-0f) }
; UDGTABLE#
 $DAB9 LD DE,$5DCE    ; {Write #N$0E and #N$0F into those tiles.
 $DABC ADD HL,DE      ;
 $DABD LD (HL),$0E    ;
 $DABF INC HL         ;
 $DAC0 LD (HL),$0F    ; }
 $DAC2 RET            ; Return.

; Pendulum Position
;
; Pendulum sprite ID for rooms #N$0A and #N$0B. #N$FF
; resets at #R$DAC5.
@label=Pendulum_Position
g$DAC3 DEFB $00

; Pendulum Delta
;
; Added to #R$DAC3 each step. Negated at each end-stop.
@label=Pendulum_Delta
g$DAC4 DEFB $00

; Animate Pendulum
;
; Used by the routine at #R$DB05.
; .
; Steps the pendulum sprite IDs for rooms #N$0A and
; #N$0B.
;
; .
;
; Reset after a room change.
@label=Handler_Pendulum
c$DAC5 LD A,($DAC3)  ; {Jump to #R$DAD6 unless the position is #N$FF.
 $DAC8 CP $FF        ;
 $DACA JR NZ,$DAD6   ; }
 $DACC LD A,$D8      ; {Write #N$D8 to *#R$DAC3 and #N$02 to *#R$DAC4.
 $DACE LD ($DAC3),A  ;
 $DAD1 LD A,$02      ;
 $DAD3 LD ($DAC4),A  ; }
; Advance the position.
@label=Handler_Pendulum_Step
*$DAD6 LD A,($DAC3)  ; {Add *#R$DAC4 to *#R$DAC3.
 $DAD9 LD C,A        ;
 $DADA LD A,($DAC4)  ;
 $DADD ADD A,C       ;
 $DADE LD ($DAC3),A  ; }
; Keep the new position as both sprite IDs.
 $DAE1 LD C,A        ; {Copy the position into #REGb and #REGc.
 $DAE2 LD B,A        ; }
; Bounce at the end-stops.
 $DAE3 CP $D6        ; {Jump to #R$DAFA if the position is #N$D6 or
 $DAE5 JR Z,$DAFA    ; #N$E2.
 $DAE7 CP $E2        ;
 $DAE9 JR Z,$DAFA    ; }
; Use the same frame for both sprites in room #N$0A.
 $DAEB LD A,($64A2)  ; {Jump to #R$DB24 if the room is #N$0A.
 $DAEE CP $0A        ;
 $DAF0 JR Z,$DB24    ; }
; Mirror the first sprite in room #N$0B.
 $DAF2 LD A,$DC      ; {Mirror the first sprite around #N$DC.
 $DAF4 SUB B         ;
 $DAF5 ADD A,$DC     ;
 $DAF7 LD B,A        ; }
 $DAF8 JR $DB24      ; Jump to #R$DB24.
; Negate the delta and apply it again.
@label=Handler_Pendulum_Bounce
*$DAFA LD A,($DAC4)  ; {Decrease the delta by one.
 $DAFD DEC A         ; }
 $DAFE XOR %11111111 ; Invert every bit.
 $DB00 LD ($DAC4),A  ; Write the negated delta to *#R$DAC4.
 $DB03 JR $DAD6      ; Jump to #R$DAD6.

; Handler: Pendulum
;
; Used by the routine at #R$D7A2.
; .
; Room #N$09 chooses a frame from the player column.
; Rooms #N$0A and #N$0B animate at #R$DAC5.
;
; .
;
; Return unless this is a pendulum room.
@label=Handler_PendulumRooms
c$DB05 LD A,($64A2)  ; {Return if the room is #N$0C or higher.
 $DB08 CP $0C        ;
 $DB0A RET NC        ; }
 $DB0B CP $09        ; {Return if the room is lower than #N$09.
 $DB0D RET C         ; }
; Animate rooms #N$0A and #N$0B.
 $DB0E CP $0A        ; {Jump to #R$DAC5 if the room is #N$0A or #N$0B.
 $DB10 JR NC,$DAC5   ; }
; Choose a frame from the player column.
 $DB12 LD A,($64A4)  ; {Start from the player column minus #N$04.
 $DB15 SUB $04       ; }
; #UDGTABLE
; { #GLYPH$E0,$47,$9070(pendulum-e0)
; | #GLYPH$E1,$47,$9070(pendulum-e1) }
; UDGTABLE#
 $DB17 LD B,$E0      ; Set the sprite ID to #N$E0.
; Step the sprite ID back for each six columns.
@label=Handler_Pendulum_FrameLoop
*$DB19 SUB $06       ; {Subtract #N$06 until #REGa is negative, decreasing
 $DB1B BIT 7,A       ; the sprite ID by two each pass.
 $DB1D JR NZ,$DB23   ;
 $DB1F DEC B         ;
 $DB20 DEC B         ;
 $DB21 JR $DB19      ; }
; Use the same frame for both sprites.
@label=Handler_Pendulum_DrawPair
*$DB23 LD C,B        ; Copy the sprite ID into #REGc.
; Continue on to #R$DB24.

; Draw Pendulum
;
; Used by the routine at #R$DAC5.
; .
; Draws the two pendulum sprites.
;
; B First sprite ID
; C Second sprite ID
;
; Draw the pair.
@label=Draw_Pendulum
c$DB24 LD A,$47      ; {Write #INK$47 to *#SKOOLKID$5C8F(ATTR_T).
 $DB26 LD ($5C8F),A  ; }
 $DB29 PUSH BC       ; {Draw the first sprite at row #N$12, column #N$14.
 $DB2A LD A,B        ;
 $DB2B LD BC,$1214   ;
 $DB2E LD DE,$0102   ;
 $DB31 CALL $F445    ;
 $DB34 POP BC        ; }
 $DB35 LD A,C        ; {Jump to #R$F445 for the second sprite at row
 $DB36 LD BC,$1210   ; #N$12, column #N$10.
 $DB39 LD DE,$0102   ;
 $DB3C JP $F445      ; }

; Test Actor Collision
;
; Used by the routines at #R$E1CC and #R$E3DE.
; .
; Reverses the actor at a destination. On a player hit,
; copies the actor deltas onto #R$64A4.
;
; IY Actor record
;
; Reverse at the destination when cell-aligned.
@label=Test_ActorCollision
c$DB3F LD A,(IY+$08)  ; {Jump to #R$DB57 if the horizontal delta is set.
 $DB42 OR A           ;
 $DB43 JR NZ,$DB57    ; }
; Test the destination row.
 $DB45 LD A,$07       ; {Jump to #R$DB67 unless the fine-Y is #N$07.
 $DB47 CP (IY+$03)    ;
 $DB4A JR NZ,$DB67    ; }
 $DB4C LD A,(IY+$01)  ; {Call #R$E43B if the row matches the destination.
 $DB4F CP (IY+$06)    ;
 $DB52 CALL Z,$E43B   ; }
 $DB55 JR $DB67       ; Jump to #R$DB67.
; Test the destination column.
@label=Test_ActorCollision_Column
*$DB57 LD A,$07       ; {Jump to #R$DB67 unless the fine-X is #N$07.
 $DB59 CP (IY+$02)    ;
 $DB5C JR NZ,$DB67    ; }
 $DB5E LD A,(IY+$00)  ; {Call #R$E43B if the column matches the
 $DB61 CP (IY+$05)    ; destination.
 $DB64 CALL Z,$E43B   ; }
; Skip the hit test while jumping or falling.
@label=Test_ActorCollision_Bounds
*$DB67 LD A,($6410)   ; {Return if *#R$6410 is set.
 $DB6A OR A           ;
 $DB6B RET NZ         ; }
; Require a close vertical overlap.
 $DB6C LD A,(IY+$01)  ; {Convert the actor row and fine-Y into a pixel row.
 $DB6F ADD A,A        ;
 $DB70 ADD A,A        ;
 $DB71 ADD A,A        ;
 $DB72 ADD A,(IY+$03) ;
 $DB75 LD C,A         ; }
; Convert the player row the same way.
 $DB76 LD A,($64A7)   ; {Convert the player row and fine-Y into a pixel row.
 $DB79 LD B,A         ;
 $DB7A LD A,($64A5)   ;
 $DB7D SUB $03        ;
 $DB7F ADD A,A        ;
 $DB80 ADD A,A        ;
 $DB81 ADD A,A        ;
 $DB82 ADD A,B        ; }
 $DB83 SUB C          ; {Return unless the difference is less than #N$04.
 $DB84 CP $04         ;
 $DB86 RET NC         ; }
; Keep the gap and convert the actor column.
 $DB87 LD D,A         ; Keep the vertical gap in #REGd.
 $DB88 LD A,(IY+$00)  ; {Convert the actor column and fine-X into a pixel
 $DB8B DEC A          ; column.
 $DB8C DEC A          ;
 $DB8D ADD A,A        ;
 $DB8E ADD A,A        ;
 $DB8F ADD A,A        ;
 $DB90 ADD A,(IY+$02) ;
 $DB93 LD B,A         ; }
; Build the overlap limit.
 $DB94 LD A,($6449)   ; {Copy the footprint offset into #REGc.
 $DB97 LD C,A         ; }
 $DB98 LD A,(IY+$04)  ; {Write the actor pixel width plus that offset into
 $DB9B ADD A,A        ; *#R$DB3F(#N$DBAD).
 $DB9C ADD A,A        ;
 $DB9D ADD A,A        ;
 $DB9E ADD A,C        ;
 $DB9F DEC A          ;
 $DBA0 LD ($DBAD),A   ; }
; Test the player width against the actor column.
 $DBA3 SUB C          ; {Restore the actor pixel width in #REGc.
 $DBA4 LD C,A         ;
 $DBA5 INC C          ; }
 $DBA6 LD A,($6448)   ; {Return unless the ranges overlap.
 $DBA9 ADD A,C        ;
 $DBAA SUB B          ;
 $DBAB DEC A          ;
 $DBAC CP $C8         ;
 $DBAE RET NC         ; }
; Copy the actor movement onto the player.
 $DBAF LD A,(IY+$08)  ; {Write the horizontal delta to *#R$64AC.
 $DBB2 LD ($64AC),A   ; }
 $DBB5 LD A,$03       ; {Write #N$03 to *#R$6434.
 $DBB7 LD ($6434),A   ; }
; Adjust the vertical delta by the gap.
 $DBBA LD A,(IY+$09)  ; {Jump to #R$DBC1 if the vertical delta is zero.
 $DBBD OR A           ;
 $DBBE JR Z,$DBC1     ; }
 $DBC0 SUB D          ; Subtract the vertical gap.
; Store the vertical delta and the actor.
@label=Test_ActorCollision_Store
*$DBC1 LD ($64AD),A   ; Write the vertical delta to *#R$64AD.
 $DBC4 LD ($644B),IY  ; Write the actor pointer to *#R$644B.
 $DBC8 RET            ; Return.

; Handler: Inventory Items
;
; Used by the routine at #R$D7A2.
; .
; Picks up the first matching 2-wide key and redraws
; #R$DA15.
;
; .
;
; Point at the inventory list.
@label=Handler_InventoryItems
c$DBC9 LD HL,$7C70   ; {Write #R$7C70 to *#SKOOLKID$5C36(CHARS).
 $DBCC LD ($5C36),HL ; }
 $DBCF LD IX,($6426) ; Point #REGix at *#R$6426.
 $DBD3 LD A,($64A4)  ; {Copy the player column into #REGc.
 $DBD6 LD C,A        ; }
; Walk each key record.
@label=Handler_InventoryItems_Loop
*$DBD7 LD A,(IX+$00) ; {Return if the terminator #N$FF is reached.
 $DBDA CP $FF        ;
 $DBDC RET Z         ; }
 $DBDD BIT 7,A       ; {Jump to #R$DC20 if this item is already taken.
 $DBDF JR NZ,$DC20   ; }
; Accept this column or the next.
 $DBE1 CP C          ; {Jump to #R$DBE8 if the column matches.
 $DBE2 JR Z,$DBE8    ; }
 $DBE4 INC A         ; {Jump to #R$DC20 unless the next column matches.
 $DBE5 CP C          ;
 $DBE6 JR NZ,$DC20   ; }
; Require the same row.
@label=Handler_InventoryItems_Row
*$DBE8 LD A,($64A5)  ; {Jump to #R$DC20 unless the player row matches.
 $DBEB CP (IX+$01)   ;
 $DBEE JR NZ,$DC20   ; }
; Punch a hole in the room tiles.
 $DBF0 LD C,(IX+$00) ; {Convert the item cell into a #R$5DCE offset.
 $DBF3 LD B,(IX+$01) ;
 $DBF6 CALL $F43C    ; }
 $DBF9 LD DE,$5DCE   ; {Fill a #N$02 by #N$02 hole with #N$C8.
 $DBFC ADD HL,DE     ;
 $DBFD LD BC,$0202   ;
 $DC00 LD A,$C8      ;
 $DC02 CALL $F454    ; }
; Hide the record.
 $DC05 LD A,(IX+$00) ; Reload the item column.
 $DC08 OR %10000000  ; Set bit 7.
 $DC0A LD (IX+$00),A ; Write the hidden record.
; Count the key.
 $DC0D LD A,($64A1)  ; {Increase *#R$64A1 by one.
 $DC10 INC A         ;
 $DC11 LD ($64A1),A  ; }
; Play the pickup sound and redraw the key bar.
; #HTML(#AUDIO0(pickup.wav)(#INCLUDE(Pickup)))
 $DC14 LD BC,$0032   ; {Call #R$E501 with delay #N$32 and #N$19
 $DC17 LD DE,$0019   ; iterations.
 $DC1A CALL $E501    ; }
 $DC1D JP $DA15      ; Jump to #R$DA15.
; Step to the next record.
@label=Handler_InventoryItems_Next
*$DC20 INC IX        ; {Increase #REGix by two.
 $DC22 INC IX        ; }
 $DC24 JR $DBD7      ; Jump to #R$DBD7.

; Handler: Event Timer
;
; Used by the routines at #R$D7A2 and #R$DE19.
; .
; Counts *#R$649F down and fires *#R$64A0 through #R$E9FF.
;
; .
;
; Return unless a timer is running.
@label=Handler_EventTimer
c$DC26 LD A,($649F)  ; {Return if *#R$649F is zero.
 $DC29 OR A          ;
 $DC2A RET Z         ; }
; Count down and fire when it hits zero.
 $DC2B DEC A         ; {Decrease *#R$649F by one.
 $DC2C LD ($649F),A  ; }
 $DC2F OR A          ; {Return if the timer is still running.
 $DC30 RET NZ        ; }
 $DC31 LD A,($64A0)  ; {Jump to #R$E9FF with *#R$64A0.
 $DC34 JP $E9FF      ; }

; Reverse Direction
;
; Used by the routines at #R$D894 and #R$DC62.
; .
; Negates both deltas and flips facing when the
; horizontal delta is non-zero.
;
; IX Entity record
;
; Negate the vertical delta.
@label=Reverse_Direction
c$DC37 LD A,(IX+$09) ; {Fetch the vertical delta and decrease it by one.
 $DC3A DEC A         ; }
 $DC3B XOR %11111111 ; Invert every bit.
 $DC3D LD (IX+$09),A ; Write the negated vertical delta.
; Negate the horizontal delta.
 $DC40 LD A,(IX+$08) ; {Fetch the horizontal delta and decrease it by one.
 $DC43 DEC A         ; }
 $DC44 XOR %11111111 ; Invert every bit.
 $DC46 LD (IX+$08),A ; Write the negated horizontal delta.
 $DC49 RET Z         ; Return if it is now zero.
; Flip the facing bit.
 $DC4A LD A,$80      ; {Toggle bit 7 of *#REGix+#N$07.
 $DC4C XOR (IX+$07)  ;
 $DC4F LD (IX+$07),A ; }
 $DC52 RET           ; Return.

; Pause Leaving Room
;
; Used by the routine at #R$DC62.
; .
; Delays when leaving a non-zero room.
;
; .
;
; Skip the pause in room #N$00.
@label=Pause_LeavingRoom
c$DC53 PUSH AF       ; Stash #REGaf on the stack.
 $DC54 LD A,($64A2)  ; {Jump to #R$DC60 if the room is zero.
 $DC57 OR A          ;
 $DC58 JR Z,$DC60    ; }
; Wait, then restore.
 $DC5A LD BC,$03E8   ; {Call #R$F430 with a pause of #N$03E8.
 $DC5D CALL $F430    ; }
@label=Pause_LeavingRoom_Done
*$DC60 POP AF        ; Restore #REGaf from the stack.
 $DC61 RET           ; Return.

; Handler: Enemies
;
; Used by the routine at #R$D7A2.
; .
; Animates the #N$0E-byte records at *#R$6432.
;
; .
;
; Point at the enemy list.
@label=Handler_Enemies
c$DC62 LD HL,$9070    ; {Write #R$9070 to *#SKOOLKID$5C36(CHARS).
 $DC65 LD ($5C36),HL  ; }
 $DC68 LD IX,($6432)  ; Point #REGix at *#R$6432.
; Walk each enemy record.
@label=Handler_Enemies_Loop
*$DC6C LD A,(IX+$00)  ; {Return if the terminator #N$FF is reached.
 $DC6F INC A          ;
 $DC70 RET Z          ; }
 $DC71 BIT 7,A        ; {Pause and skip this enemy if it is inactive.
 $DC73 CALL NZ,$DC53  ;
 $DC76 JP NZ,$DCED    ; }
; Skip the walk-frame wrap for high sprite IDs.
 $DC79 LD A,(IX+$06)  ; {Jump to #R$DC92 if the sprite ID is #N$E2 or higher.
 $DC7C CP $E2         ;
 $DC7E JR NC,$DC92    ; }
; Advance the walking frame.
 $DC80 ADD A,$06      ; {Add #N$06 to the sprite ID and set the wrap to #N$24.
 $DC82 LD C,A         ;
 $DC83 LD B,$24       ; }
@label=Handler_Enemies_WrapLoop
*$DC85 SUB B          ; {Subtract #N$24 until the frame is in range.
 $DC86 JR Z,$DC8C     ;
 $DC88 JR C,$DC8F     ;
 $DC8A JR $DC85       ; }
; Wrap an exact multiple of #N$24.
@label=Handler_Enemies_WrapExact
*$DC8C LD A,C         ; {Subtract one more span of #N$24.
 $DC8D SUB B          ;
 $DC8E LD C,A         ; }
@label=Handler_Enemies_CommitFrame
*$DC8F LD (IX+$06),C  ; Write the wrapped sprite ID.
; Only probe when the enemy is cell-aligned.
@label=Handler_Enemies_Probe
*$DC92 LD A,(IX+$02)  ; {Jump to #R$DCDE unless the fine-X is #N$07.
 $DC95 CP $07         ;
 $DC97 JR NZ,$DCDE    ; }
 $DC99 BIT 7,(IX+$07) ; {Jump to #R$DCBC if the enemy is facing left.
 $DC9D JR Z,$DCBC     ; }
; Probe the cell ahead on the right.
 $DC9F LD C,(IX+$00)  ; {Set the probe to the top row, one column right.
 $DCA2 LD A,(IX+$01)  ;
 $DCA5 SUB (IX+$05)   ;
 $DCA8 LD B,A         ;
 $DCA9 INC C          ; }
 $DCAA CALL $F42D     ; Call #R$F42D.
 $DCAD LD HL,($6412)  ; {Point #REGhl at that #R$5DCE tile.
 $DCB0 LD DE,$5DCE    ;
 $DCB3 ADD HL,DE      ; }
 $DCB4 LD A,(HL)      ; {Call #R$DC37 if the tile is solid.
 $DCB5 CP $10         ;
 $DCB7 CALL NC,$DC37  ; }
 $DCBA JR $DCDE       ; Jump to #R$DCDE.
; Probe ahead on the left.
@label=Handler_Enemies_ProbeLeft
*$DCBC LD A,(IX+$01)  ; {Set the probe row to the top of the enemy.
 $DCBF SUB (IX+$05)   ;
 $DCC2 LD B,A         ; }
 $DCC3 LD A,(IX+$00)  ; {Jump to #R$DCDE if the column is #N$23 or higher.
 $DCC6 CP $23         ;
 $DCC8 JR NC,$DCDE    ; }
 $DCCA SUB (IX+$04)   ; {Set the probe column to the left of the enemy.
 $DCCD LD C,A         ; }
 $DCCE CALL $F42D     ; Call #R$F42D.
 $DCD1 LD HL,($6412)  ; {Point #REGhl at that #R$5DCE tile.
 $DCD4 LD DE,$5DCE    ;
 $DCD7 ADD HL,DE      ; }
 $DCD8 LD A,(HL)      ; {Call #R$DC37 if the tile is solid.
 $DCD9 CP $10         ;
 $DCDB CALL NC,$DC37  ; }
; Store, move, draw and erase the enemy.
@label=Handler_Enemies_Update
*$DCDE CALL $F448     ; Call #R$F448.
 $DCE1 CALL $F424     ; Call #R$F424.
 $DCE4 CALL $F442     ; Call #R$F442.
 $DCE7 CALL $F44B     ; Call #R$F44B.
 $DCEA CALL $F44E     ; Call #R$F44E.
; Step to the next record.
@label=Handler_Enemies_Next
*$DCED LD DE,$000E    ; {#REGix+=#N($000E,$04,$04).
 $DCF0 ADD IX,DE      ; }
 $DCF2 JP $DC6C       ; Jump to #R$DC6C.
; View the equivalent code in #BOOTY$E22D.

; Cheat: Next Room
;
; Used by the routine at #R$DD97.
; .
; Wraps from room #N$16 back to #N$00.
;
; .
;
; Drop the stacked return and step the room.
@label=Cheat_NextRoom
c$DCF5 POP BC        ; Restore #REGbc from the stack.
 $DCF6 LD A,($64A2)  ; {Jump to #R$D738 with the next room, unless this
 $DCF9 INC A         ; was room #N$16.
 $DCFA CP $17        ;
 $DCFC JP NZ,$D738   ; }
 $DCFF XOR A         ; {Jump to #R$D738 with room #N$00.
 $DD00 JP $D738      ; }

; Cheat: Previous Room
;
; Used by the routine at #R$DD97.
; .
; Wraps from room #N$00 back to #N$16.
;
; .
;
; Drop the stacked return and step the room.
@label=Cheat_PreviousRoom
c$DD03 POP BC        ; Restore #REGbc from the stack.
 $DD04 LD A,($64A2)  ; {Jump to #R$D738 with the previous room, unless
 $DD07 DEC A         ; this was room #N$00.
 $DD08 CP $FF        ;
 $DD0A JP NZ,$D738   ; }
 $DD0D LD A,$16      ; {Jump to #R$D738 with room #N$16.
 $DD0F JP $D738      ; }

; Prepare Tape Block
;
; Used by the routines at #R$DD22, #R$DD37 and #R$DD6C.
; .
; Sets #REGix to #R$647C, #REGde to the length
; and #REGa to #N$FF.
;
; O:IX Start of the tape block
; O:DE Length of the tape block
; O:A Data block flag (#N$FF)
;
; Point at the start and the exclusive end.
@label=Tape_BlockRange
c$DD12 LD IX,$647C   ; Point #REGix at #R$647C.
 $DD16 LD DE,$647C   ; Point #REGde at #R$647C.
 $DD19 LD HL,$7C67   ; Point #REGhl at #N$7C67.
; Make the length.
 $DD1C XOR A         ; Clear #REGa and the carry flag.
 $DD1D SBC HL,DE     ; Subtract #REGde from #REGhl.
; Set the data-block flag.
 $DD1F EX DE,HL      ; Put the length in #REGde.
 $DD20 DEC A         ; Set #REGa to #N$FF.
; Return.
 $DD21 RET           ; Return.

; Save Game
;
; Used by the routine at #R$DD97.
; .
; Writes the checksum and saves #R$647C to tape.
;
; .
;
; Store the checksum, then save the block.
@label=Tape_Save
c$DD22 CALL $DD6C    ; {Write the checksum from #R$DD6C to *#R$6488.
 $DD25 LD ($6488),A  ; }
 $DD28 POP BC        ; Restore #REGbc from the stack.
 $DD29 CALL $DD12    ; Call #R$DD12.
 $DD2C CALL $04C2    ; Call #SKOOLKID$04C2(SA_BYTES).
; Reload the room with bit 7 set.
 $DD2F LD A,($64A2)  ; {Set bit 7 of the room ID.
 $DD32 SET 7,A       ; }
 $DD34 JP $D738      ; Jump to #R$D738.

; Load Game
;
; Used by the routine at #R$DD97.
; .
; Prints #R$E7E4, waits for "2", then loads the tape
; block.
;
; .
;
; Use the ROM font and print the load message.
@label=Tape_Load
c$DD37 LD HL,$3C00   ; {Write #N$3C00 to *#SKOOLKID$5C36(CHARS).
 $DD3A LD ($5C36),HL ; }
 $DD3D LD HL,$E7E4   ; {Print the messaging at #R$E7E4.
 $DD40 CALL $F460    ; }
; Wait until a key is pressed.
@label=Tape_Load_Wait
*$DD43 LD BC,$2710   ; {Call #R$F430 with a pause of #N$2710.
 $DD46 CALL $F430    ; }
 $DD49 CALL $028E    ; Call #SKOOLKID$028E(KEY_SCAN).
 $DD4C LD A,E        ; {Jump to #R$DD43 if no key is pressed.
 $DD4D CP $FF        ;
 $DD4F JR Z,$DD43    ; }
; Load only if "2" was pressed.
 $DD51 CP $02        ; {Jump to #R$DD64 unless "2" was pressed.
 $DD53 JR NZ,$DD64   ; }
 $DD55 POP BC        ; Restore #REGbc from the stack.
 $DD56 CALL $DD12    ; Call #R$DD12.
 $DD59 SCF           ; {Call #SKOOLKID$0556(LD_BYTES) with carry set.
 $DD5A CALL $0556    ; }
 $DD5D CALL $DD6C    ; {Jump to #R$D5D5 if the checksum does not match.
 $DD60 CP L          ;
 $DD61 JP NZ,$D5D5   ; }
; Reload the room with bit 7 set.
@label=Tape_Load_Resume
*$DD64 LD A,($64A2)  ; {Set bit 7 of the room ID.
 $DD67 SET 7,A       ; }
 $DD69 JP $D738      ; Jump to #R$D738.

; Checksum Tape
;
; Used by the routines at #R$DD22 and #R$DD37.
; .
; Adds every byte in the tape block after
; writing #N$00 to *#R$6488. #REGl keeps the previous
; checksum for the load compare.
;
; O:A The checksum
; O:L The previous *#R$6488
;
; Point at the tape block.
@label=Tape_Checksum
c$DD6C CALL $DD12     ; Call #R$DD12.
; Keep the previous checksum and clear the stored
; one.
 $DD6F XOR A          ; Clear the sum.
 $DD70 LD HL,($6488)  ; Copy *#R$6488 into #REGl.
 $DD73 LD ($6488),A   ; Write #N$00 to *#R$6488.
 $DD76 LD H,A         ; Clear #REGh.
; Add each byte into the running total.
@label=Tape_Checksum_Loop
*$DD77 ADD A,(IX+$00) ; {Add *(#REGix) into #REGa and keep the sum in
 $DD7A LD H,A         ; #REGh.}
 $DD7B INC IX         ; {Move to the next byte.
 $DD7D DEC DE         ; }
 $DD7E LD A,E         ; {Test whether #REGde is zero.
 $DD7F OR D           ; }
 $DD80 LD A,H         ; Restore the sum.
 $DD81 JR NZ,$DD77    ; Jump to #R$DD77 if #REGde is not zero.
; Return.
 $DD83 RET            ; Return.

; Wait Keypress
;
; Used by the routine at #R$DD97.
; .
; Pauses, then returns when any key is pressed.
;
; .
;
; Delay, then scan.
@label=Wait_Keypress
c$DD84 LD BC,$2710   ; {Call #R$F430 with a pause of #N$2710.
 $DD87 CALL $F430    ; }
 $DD8A CALL $028E    ; Call #SKOOLKID$028E(KEY_SCAN).
 $DD8D LD A,E        ; {Jump to #R$DD84 if no key is pressed.
 $DD8E INC A         ;
 $DD8F JR Z,$DD84    ; }
 $DD91 RET           ; Return.

; Toggle Tune
;
; Used by the routine at #R$DD97.
; .
; Fires event #N$09, which inverts *#R$647C.
@label=Toggle_Tune
c$DD92 LD A,$09      ; {Jump to #R$E9FF with event #N$09.
 $DD94 JP $E9FF      ; }

; Handler: Keyboard
;
; Used by the routine at #R$D7A2.
; .
; In-game keypresses: save, load, pause, toggle
; tune, and the hidden room cheats when *#N$FFFF is #N$0A.
@label=Handler_Keyboard
c$DD97 CALL $028E    ; Call #SKOOLKID$028E(KEY_SCAN).
 $DD9A LD A,E        ; #REGa=the keypress.
 $DD9B CP $1E        ; {Jump to #R$DD22 if "S" was pressed.
 $DD9D JR Z,$DD22    ; }
 $DD9F CP $19        ; {Jump to #R$DD37 if "J" was pressed.
 $DDA1 JR Z,$DD37    ; }
 $DDA3 CP $22        ; {Jump to #R$DD84 if "H" was pressed.
 $DDA5 JR Z,$DD84    ; }
 $DDA7 CP $10        ; {Jump to #R$DD92 if "Q" was pressed.
 $DDA9 JR Z,$DD92    ; }
 $DDAB LD A,($FFFF)  ; {Return unless *#N$FFFF is #N$0A.
 $DDAE CP $0A        ; }
 $DDB0 RET NZ        ; {Cap *#R$64B4 at #N$03.
 $DDB1 LD A,($64B4)  ;
 $DDB4 CP $02        ;
 $DDB6 JR C,$DDBD    ;
 $DDB8 LD A,$03      ;
 $DDBA LD ($64B4),A  ; }
@label=Handler_Keyboard_Cheats
*$DDBD LD HL,$3C00   ; {Write #N$3C00 to *#SKOOLKID$5C36(CHARS).
 $DDC0 LD ($5C36),HL ; }
 $DDC3 LD A,E        ; {Jump to #R$DCF5 if "8" was pressed.
 $DDC4 CP $08        ;
 $DDC6 JP Z,$DCF5    ; }
 $DDC9 OR A          ; {Jump to #R$DD03 if "1" was pressed.
 $DDCA JP Z,$DD03    ; }
 $DDCD CP $20        ; {Write #N$0705 to *#R$64A4 if "C" was pressed.
 $DDCF JR NZ,$DDD7   ;
 $DDD1 LD HL,$0705   ;
 $DDD4 LD ($64A4),HL ; }
@label=Handler_Keyboard_Corner2
*$DDD7 CP $24        ; {Write #N$161F to *#R$64A4 if "X" was pressed.
 $DDD9 JR NZ,$DDE1   ;
 $DDDB LD HL,$161F   ;
 $DDDE LD ($64A4),HL ; }
@label=Handler_Keyboard_Corner3
*$DDE1 CP $27        ; {Write #N$071F to *#R$64A4 if "Z" was pressed.
 $DDE3 JR NZ,$DDEB   ;
 $DDE5 LD HL,$071F   ;
 $DDE8 LD ($64A4),HL ; }
@label=Handler_Keyboard_Corner4
*$DDEB CP $23        ; {Write #N$1605 to *#R$64A4 if "V" was pressed.
 $DDED JR NZ,$DDF5   ;
 $DDEF LD HL,$1605   ;
 $DDF2 LD ($64A4),HL ; }
@label=Handler_Keyboard_Lives
*$DDF5 CP $16        ; {Write #N$01 to *#R$64B4 if "B" was pressed.
 $DDF7 JR NZ,$DDFE   ;
 $DDF9 LD A,$01      ;
 $DDFB LD ($64B4),A  ; }
@label=Handler_Keyboard_RoomLetter
*$DDFE LD BC,$0321   ; {Call #R$F42D at column #N$03, row #N$21.
 $DE01 CALL $F42D    ; }
 $DE04 LD A,$07      ; {Write #INK$07 to *#SKOOLKID$5C8F(ATTR_T).
 $DE06 LD ($5C8F),A  ; }
 $DE09 LD A,($64A2)  ; {Print *#R$64A2 as "A"+"room".
 $DE0C ADD A,$41     ;
 $DE0E JP $F436      ; }
 $DE11 RET           ; Return.
; Print #REGc as an ASCII digit.
@label=Print_Digit
 $DE12 LD A,C        ; {Convert the digit into ASCII.
 $DE13 ADD A,$30     ; }
 $DE15 CALL $F436    ; Call #R$F436.
 $DE18 RET           ; Return.

; Handler: Combination
;
; Used by the routine at #R$D7A2.
; .
; Prints the four #R$64C1 digits on room #N$00.
@label=Handler_Combination
c$DE19 LD A,($647D)    ; {Return if *#R$647D is set.
 $DE1C OR A            ; }
 $DE1D RET NZ          ; {Return if *#R$64A2 is not zero.
 $DE1E LD A,($64A2)    ; }
 $DE21 OR A            ; {Write #N$3C00 to *#SKOOLKID$5C36(CHARS).
 $DE22 RET NZ          ;
 $DE23 LD HL,$3C00     ;
 $DE26 LD ($5C36),HL   ; }
 $DE29 LD A,$17        ; {Write #INK$17 to *#SKOOLKID$5C8F(ATTR_T).
 $DE2B LD ($5C8F),A    ; }
 $DE2E LD BC,$1413     ; Call #R$F42D at column #N$14, row #N$13.
 $DE31 CALL $F42D      ; #REGhl=#R$64C1.
 $DE34 LD HL,$64C1     ; #REGb=#N$04.
 $DE37 LD B,$04        ;
@label=Handler_Combination_Loop
*$DE39 LD A,(HL)       ; {Print *(#REGhl) as a decimal digit.
 $DE3A ADD A,$30       ;
 $DE3C CALL $F436      ; }
 $DE3F INC HL          ; {Increase #REGhl and loop back to #R$DE39.
 $DE40 DJNZ $DE39      ; }
 $DE42 RET             ; Return.
; This entry point is used by the routine at #R$E1CC.
; .
; Probe the three tiles above the player for a solid.
@label=Probe_Ceiling
*$DE43 LD A,(IX+$03)   ; {Keep the player's fine-Y in range #N$00-#N$03.
 $DE46 INC A           ;
 $DE47 AND $07         ;
 $DE49 CP $04          ;
 $DE4B RET NC          ;
 $DE4C LD C,A          ;
 $DE4D XOR A           ;
 $DE4E SUB C           ; }
 $DE4F LD ($DE83),A    ; {Call #R$F42D for the cell above the player.
 $DE52 LD C,(IX+$00)   ;
 $DE55 LD B,(IX+$01)   ;
 $DE58 DEC B           ;
 $DE59 DEC B           ;
 $DE5A DEC B           ;
 $DE5B LD A,$07        ;
 $DE5D CP (IX+$03)     ;
 $DE60 JR Z,$DE63      ;
 $DE62 DEC B           ; }
@label=Probe_Ceiling_Ready
*$DE63 CALL $F42D      ; {Point #REGhl at that #R$5DCE tile and #REGde at
 $DE66 LD HL,($6412)   ; #R$643A.
 $DE69 LD DE,$5DCE     ;
 $DE6C ADD HL,DE       ; }
 $DE6D LD DE,$643A     ; #REGde=#R$643A.
 $DE70 LD B,$03        ; #REGb=#N$03.
@label=Probe_Ceiling_Loop
*$DE72 LD A,(DE)       ; {Jump to #R$DE85 if this mask byte is zero.
 $DE73 OR A            ;
 $DE74 JR Z,$DE85      ; }
 $DE76 LD A,(HL)       ; {Stop the jump if the tile is solid (#N$10 or higher).
 $DE77 CP $10          ;
 $DE79 JR NC,$DE85     ;
 $DE7B LD A,$02        ;
 $DE7D LD ($6434),A    ; }
 $DE80 LD (IX+$09),$00 ; Write #N$00 to *#REGix+#N$09.
 $DE84 RET             ; Return.
@label=Probe_Ceiling_Next
*$DE85 INC DE          ; {Increase both pointers and loop back to #R$DE72.
 $DE86 INC HL          ;
 $DE87 DJNZ $DE72      ; }
 $DE89 RET             ; Return.
; Mirror the #REGde bitmask into #REGe.
@label=Mirror_Mask
*$DE8A LD B,$08        ; {Reverse the eight bits of #REGd into #REGe.
 $DE8C XOR A           ;
@label=Mirror_Mask_Loop
*$DE8D RR D            ;
 $DE8F RL E            ;
 $DE91 DJNZ $DE8D      ;
 $DE93 RR D            ; }
 $DE95 RET             ; Return.
; This entry point is used by the routines at #R$E1CC and #R$E3DE.
; .
; Build the player's shifted collision mask.
@label=Build_PlayerMask
*$DE96 LD DE,($64AA)   ; {#REGhl=#R$B5D8+(*#R$64AA)*#N$08.
 $DE9A XOR A           ;
 $DE9B LD D,A          ;
 $DE9C SLA E           ;
 $DE9E RL D            ;
 $DEA0 SLA E           ;
 $DEA2 RL D            ;
 $DEA4 SLA E           ;
 $DEA6 RL D            ;
 $DEA8 LD HL,$B5D8     ;
 $DEAB ADD HL,DE       ; }
 $DEAC LD A,(HL)       ; {Mirror the mask when the player is facing left.
 $DEAD LD DE,$0008     ;
 $DEB0 ADD HL,DE       ;
 $DEB1 LD D,(HL)       ;
 $DEB2 LD E,A          ;
 $DEB3 LD A,($64AB)    ;
 $DEB6 BIT 7,A         ;
 $DEB8 CALL NZ,$DE8A   ; }
 $DEBB LD BC,($64A5)   ; {Shift the mask down by the player's fine-Y.
 $DEBF INC B           ;
 $DEC0 XOR A           ;
@label=Build_PlayerMask_Shift
*$DEC1 SLA D           ;
 $DEC3 RL E            ;
 $DEC5 RL A            ;
 $DEC7 DJNZ $DEC1      ;
 $DEC9 LD ($643A),A    ;
 $DECC LD ($643B),DE   ; }
 $DED0 LD A,($64A4)    ; {Walk left from the player column until a set bit is
 $DED3 DEC A           ; found.
 $DED4 ADD A,A         ;
 $DED5 ADD A,A         ;
 $DED6 ADD A,A         ;
 $DED7 LD C,A          ;
 $DED8 LD B,$18        ;
 $DEDA LD A,($643A)    ;
@label=Build_PlayerMask_Scan
*$DEDD DEC C           ;
 $DEDE SLA D           ;
 $DEE0 RL E            ;
 $DEE2 RLA             ;
 $DEE3 JR C,$DEEF      ;
 $DEE5 DJNZ $DEDD      ; }
 $DEE7 XOR A           ; {Write #N($0000,$04,$04) to *#R$6448.
 $DEE8 LD ($6448),A    ;
 $DEEB LD ($6449),A    ; }
 $DEEE RET             ; Return.
@label=Build_PlayerMask_Width
*$DEEF LD B,$00        ; {Count the run of set bits into *#R$6448.
@label=Build_PlayerMask_Count
*$DEF1 SLA A           ;
 $DEF3 INC B           ;
 $DEF4 JR C,$DEF1      ;
 $DEF6 LD ($6448),BC   ; }
 $DEFA RET             ; Return.
; This entry point is used by the routine at #R$E1CC.
; .
; Award points and flash the player after a successful action.
; #HTML(#AUDIO0(action.wav)(#INCLUDE(Action)))
@label=Award_Action
*$DEFB LD A,($6489)    ; {Return if *#R$6489 is already running.
 $DEFE OR A            ;
 $DEFF RET NZ          ; }
 $DF00 LD BC,$0096     ; {Call #R$E4E1 (score sound).
 $DF03 LD DE,$0064     ;
 $DF06 CALL $E4E1      ; }
 $DF09 LD BC,$0001     ; {Call #R$E501 (pickup sound).
 $DF0C LD DE,$0064     ;
 $DF0F CALL $E501      ; }
 $DF12 LD A,$12        ; {Write #N$12 to *#R$6489.
 $DF14 LD ($6489),A    ; }
 $DF17 LD A,($64AB)    ; {Set the player flash bits in *#R$64AB.
 $DF1A AND $80         ;
 $DF1C OR $42          ;
 $DF1E LD ($64AB),A    ; }
 $DF21 RET             ; Return.
; This entry point is used by the routine at #R$D7FF.
; .
; Lose a life and restart the room.
@label=Lose_Life
*$DF22 LD A,($649F)    ; {Force any pending event to fire first.
 $DF25 OR A            ;
 $DF26 JR Z,$DF30      ;
 $DF28 LD A,$01        ;
 $DF2A LD ($649F),A    ;
 $DF2D CALL $DC26      ; }
@label=Lose_Life_Apply
*$DF30 POP BC          ; Restore #REGbc from the stack.
 $DF31 LD A,$01        ; {Write #N$01 to *#R$6411.
 $DF33 LD ($6411),A    ; }
 $DF36 LD A,($64B4)    ; {Jump to #R$D5D5 if *#R$64B4 is #N$01.
 $DF39 DEC A           ;
 $DF3A JP Z,$D5D5      ; }
 $DF3D LD ($64B4),A    ; Decrease *#R$64B4 by one.
 $DF40 XOR A           ; {Jump to #R$D738 with #REGa=#N$00.
 $DF41 JP $D738        ; }
; This entry point is used by the routines at #R$D82D and #R$E1CC.
; .
; Walk left, or start a left-facing walk.
@label=Player_MoveLeft
*$DF44 BIT 7,(IX+$07)  ; {Jump to #R$DF53 if already facing left.
 $DF48 JR NZ,$DF53     ; }
 $DF4A SET 7,(IX+$07)  ; Face left.
 $DF4E LD (IX+$06),$60 ; Set frame #N$60.
 $DF52 RET             ; Return.
@label=Player_MoveLeft_Step
*$DF53 LD A,(IX+$06)   ; {Advance the walk frame, wrapping at #N$30.
 $DF56 ADD A,$06       ;
 $DF58 CP $30          ;
 $DF5A JR C,$DF5D      ;
 $DF5C XOR A           ;
@label=Player_MoveLeft_StoreFrame
*$DF5D LD (IX+$06),A   ; }
 $DF60 LD A,(IX+$08)   ; {Increase the horizontal delta by #N$02.
 $DF63 ADD A,$02       ;
 $DF65 LD (IX+$08),A   ; }
 $DF68 RET             ; Return.
; This entry point is used by the routines at #R$D82D and #R$E1CC.
; .
; Walk right, or start a right-facing walk.
@label=Player_MoveRight
*$DF69 BIT 7,(IX+$07)  ; {Jump to #R$DF78 if already facing right.
 $DF6D JR Z,$DF78      ; }
 $DF6F LD (IX+$06),$60 ; Set frame #N$60.
 $DF73 RES 7,(IX+$07)  ; Face right.
 $DF77 RET             ; Return.
@label=Player_MoveRight_Step
*$DF78 LD A,(IX+$06)   ; {Advance the walk frame, wrapping at #N$30.
 $DF7B ADD A,$06       ;
 $DF7D CP $30          ;
 $DF7F JR C,$DF82      ;
 $DF81 XOR A           ;
@label=Player_MoveRight_StoreFrame
*$DF82 LD (IX+$06),A   ; }
 $DF85 LD A,(IX+$08)   ; {Decrease the horizontal delta by #N$02.
 $DF88 SUB $02         ;
 $DF8A LD (IX+$08),A   ; }
 $DF8D RET             ; Return.
; This entry point is used by the routines at #R$D82D and #R$E1CC.
; .
; Fire / use the furniture in front of the player.
@label=Player_Action
*$DF8E LD HL,($6420)   ; #REGhl=*#R$6420.
@label=Player_Action_Loop
*$DF91 LD A,(HL)       ; {Jump to #R$DFC8 if the terminator #N$FF is reached.
 $DF92 CP $FF          ;
 $DF94 JR Z,$DFC8      ; }
 $DF96 BIT 7,A         ; {Jump to #R$DFC2 if this record is inactive.
 $DF98 JR NZ,$DFC2     ; }
 $DF9A CP (IX+$00)     ; {Jump to #R$DFC2 unless it matches the player cell.
 $DF9D JR NZ,$DFC2     ;
 $DF9F INC HL          ;
 $DFA0 LD A,(HL)       ;
 $DFA1 DEC HL          ;
 $DFA2 DEC A           ;
 $DFA3 CP (IX+$01)     ;
 $DFA6 JR NZ,$DFC2     ; }
 $DFA8 LD A,($649F)    ; {Fire any pending event before using this furniture.
 $DFAB OR A            ;
 $DFAC JR Z,$DFB8      ;
 $DFAE LD A,$01        ;
 $DFB0 LD ($649F),A    ;
 $DFB3 PUSH HL         ;
 $DFB4 CALL $DC26      ;
 $DFB7 POP HL          ; }
@label=Player_Action_Use
*$DFB8 INC HL          ; {Jump to #R$D738 with the furniture event ID.
 $DFB9 INC HL          ;
 $DFBA INC HL          ;
 $DFBB INC HL          ;
 $DFBC LD A,(HL)       ;
 $DFBD POP BC          ;
 $DFBE POP BC          ;
 $DFBF JP $D738        ; }
@label=Player_Action_Next
*$DFC2 LD DE,$0005     ; {#REGhl+=#N($0005,$04,$04).
 $DFC5 ADD HL,DE       ; }
 $DFC6 JR $DF91        ; Jump to #R$DF91.
@label=Player_Action_Doors
*$DFC8 LD A,($649F)    ; {Return if *#R$649F is running.
 $DFCB OR A            ;
 $DFCC RET NZ          ; }
 $DFCD LD HL,($6422)   ; #REGhl=*#R$6422.
@label=Player_Action_DoorLoop
*$DFD0 LD A,(HL)       ; {Return if the terminator #N$FF is reached.
 $DFD1 CP $FF          ;
 $DFD3 RET Z           ; }
 $DFD4 BIT 7,A         ; {Jump to #R$E00C if this door is inactive.
 $DFD6 JR NZ,$E00C     ; }
 $DFD8 CP (IX+$00)     ; {Jump to #R$E00C unless the door column matches.
 $DFDB JR Z,$DFE3      ;
 $DFDD INC A           ;
 $DFDE CP (IX+$00)     ;
 $DFE1 JR NZ,$E00C     ; }
@label=Player_Action_DoorMatch
*$DFE3 INC HL          ; {Jump to #R$E00C unless the door row matches.
 $DFE4 LD A,(HL)       ;
 $DFE5 DEC HL          ;
 $DFE6 CP (IX+$01)     ;
 $DFE9 JR Z,$DFF1      ;
 $DFEB DEC A           ;
 $DFEC CP (IX+$01)     ;
 $DFEF JR NZ,$E00C     ; }
@label=Player_Action_DoorUse
*$DFF1 LD DE,$0003     ; {Bump the door use count when it is not #N$FF.
 $DFF4 ADD HL,DE       ;
 $DFF5 LD A,(HL)       ;
 $DFF6 OR A            ;
 $DFF7 JR Z,$DFFC      ;
 $DFF9 INC A           ;
 $DFFA RET Z           ;
 $DFFB LD (HL),A       ; }
@label=Player_Action_DoorEvent
*$DFFC INC HL          ; {Jump to #R$E9FF unless the event is #N$2A.
 $DFFD LD A,(HL)       ;
 $DFFE CP $2A          ;
 $E000 JP NZ,$E9FF     ; }
 $E003 LD HL,$0001     ; {Write #N($0001,$04,$04) to *#R$E82A.
 $E006 LD ($E82A),HL   ; }
 $E009 JP $E9FF        ; Jump to #R$E9FF.
@label=Player_Action_DoorNext
*$E00C LD DE,$0005     ; {#REGhl+=#N($0005,$04,$04).
 $E00F ADD HL,DE       ; }
 $E010 JR $DFD0        ; Jump to #R$DFD0.
 $E012 RET             ; Return.
; This entry point is used by the routines at #R$D82D and #R$E1CC.
; .
; Climb down a ladder from *#R$6428.
@label=Player_ClimbDown
*$E013 LD A,(IX+$03)   ; {Return unless the player fine-Y is #N$07.
 $E016 CP $07          ;
 $E018 RET NZ          ; }
 $E019 LD HL,($6428)   ; #REGhl=*#R$6428.
@label=Player_ClimbDown_Loop
*$E01C LD A,(HL)       ; {Return if the terminator #N$FF is reached.
 $E01D CP $FF          ;
 $E01F RET Z           ; }
 $E020 BIT 7,A         ; {Jump to #R$E065 if this ladder is hidden.
 $E022 JR NZ,$E065     ; }
 $E024 CP (IX+$00)     ; {Jump to #R$E036 if the ladder column matches.
 $E027 JR Z,$E036      ; }
 $E029 INC A           ; {Jump to #R$E065 unless the player is on the
 $E02A CP (IX+$00)     ; right-hand half.
 $E02D JR NZ,$E065     ;
 $E02F LD A,(IX+$02)   ;
 $E032 CP $04          ;
 $E034 JR NC,$E065     ; }
@label=Player_ClimbDown_Start
*$E036 INC HL          ; {Jump to #R$E065 unless the player is three rows
 $E037 LD A,(HL)       ; below the ladder.
 $E038 DEC HL          ;
 $E039 ADD A,$03       ;
 $E03B CP (IX+$01)     ;
 $E03E JR NZ,$E065     ; }
 $E040 SUB $03         ; {Write the ladder row to *#R$648A and start climbing
 $E042 LD ($648A),A    ; down.
 $E045 LD (IX+$06),$5A ;
 $E049 LD (IX+$09),$FE ; }
 $E04D LD A,(HL)       ; {Jump to #R$E05C unless the ladder column matches.
 $E04E CP (IX+$00)     ;
 $E051 JR NZ,$E05C     ; }
 $E053 LD A,$07        ; {Write the remaining fine-X as the horizontal delta.
 $E055 SUB (IX+$02)    ;
 $E058 LD (IX+$08),A   ; }
 $E05B RET             ; Return.
@label=Player_ClimbDown_Offset
*$E05C LD A,$FF        ; {Write the opposite climb delta.
 $E05E SUB (IX+$02)    ;
 $E061 LD (IX+$08),A   ; }
 $E064 RET             ; Return.
@label=Player_ClimbDown_Next
*$E065 INC HL          ; {Increase #REGhl by three.
 $E066 INC HL          ;
 $E067 INC HL          ; }
 $E068 JR $E01C        ; Jump to #R$E01C.
; This entry point is used by the routines at #R$D82D and #R$E1CC.
; .
; Climb up a ladder, or start a jump.
@label=Player_ClimbUp
*$E06A LD A,($6410)    ; {Return if *#R$6410 is set.
 $E06D OR A            ;
 $E06E RET NZ          ; }
 $E06F LD A,(IX+$03)   ; {Jump to #R$E0CE unless the player fine-Y is #N$07.
 $E072 CP $07          ;
 $E074 JR NZ,$E0CE     ; }
 $E076 LD HL,($6428)   ; #REGhl=*#R$6428.
@label=Player_ClimbUp_Loop
*$E079 LD A,(HL)       ; {Jump to #R$E0CE if the terminator #N$FF is reached.
 $E07A CP $FF          ;
 $E07C JR Z,$E0CE      ; }
 $E07E BIT 7,A         ; {Jump to #R$E0C9 if this ladder is hidden.
 $E080 JR NZ,$E0C9     ; }
 $E082 CP (IX+$00)     ; {Jump to #R$E094 if the ladder column matches.
 $E085 JR Z,$E094      ; }
 $E087 INC A           ; {Jump to #R$E0C9 unless the player is on the
 $E088 CP (IX+$00)     ; right-hand half.
 $E08B JR NZ,$E0C9     ;
 $E08D LD A,(IX+$02)   ;
 $E090 CP $04          ;
 $E092 JR NC,$E0C9     ; }
@label=Player_ClimbUp_Start
*$E094 INC HL          ; {Return if the player is already at the top.
 $E095 LD A,(HL)       ;
 $E096 ADD A,$03       ;
 $E098 CP (IX+$01)     ;
 $E09B RET Z           ; }
 $E09C DEC HL          ; {Jump to #R$E0C9 unless the player is two rows
 $E09D SUB $05         ; below the top.
 $E09F CP (IX+$01)     ;
 $E0A2 JR NZ,$E0C9     ; }
 $E0A4 ADD A,$02       ; {Write the ladder row to *#R$648A and start climbing
 $E0A6 LD ($648A),A    ; up.
 $E0A9 LD (IX+$06),$5A ;
 $E0AD LD (IX+$09),$02 ; }
 $E0B1 LD A,(HL)       ; {Jump to #R$E0C0 unless the ladder column matches.
 $E0B2 CP (IX+$00)     ;
 $E0B5 JR NZ,$E0C0     ; }
 $E0B7 LD A,$07        ; {Write the remaining fine-X as the horizontal delta.
 $E0B9 SUB (IX+$02)    ;
 $E0BC LD (IX+$08),A   ; }
 $E0BF RET             ; Return.
@label=Player_ClimbUp_Offset
*$E0C0 LD A,$FF        ; {Write the opposite climb delta.
 $E0C2 SUB (IX+$02)    ;
 $E0C5 LD (IX+$08),A   ; }
 $E0C8 RET             ; Return.
@label=Player_ClimbUp_Next
*$E0C9 INC HL          ; {Increase #REGhl by three.
 $E0CA INC HL          ;
 $E0CB INC HL          ; }
 $E0CC JR $E079        ; Jump to #R$E079.
@label=Player_Jump
*$E0CE LD A,$07        ; {Write #N$07 to *#R$6410 and start the jump.
 $E0D0 LD ($6410),A    ;
 $E0D3 LD (IX+$09),$03 ; }
 $E0D7 BIT 7,(IX+$07)  ; {Choose a left-facing jump frame.
 $E0DB JR NZ,$E0E6     ;
 $E0DD LD (IX+$06),$30 ;
 $E0E1 LD (IX+$08),$FE ;
 $E0E5 RET             ; }
@label=Player_Jump_Right
*$E0E6 LD (IX+$06),$30 ; {Choose a right-facing jump frame.
 $E0EA LD (IX+$08),$02 ;
 $E0EE RET             ; }
; This entry point is used by the routine at #R$E1CC.
; .
; Stop climbing when the stored ladder row is left.
@label=Player_ClimbStop
*$E0EF LD A,(IX+$03)   ; {Jump to #R$E110 unless the fine-Y is #N$07.
 $E0F2 CP $07          ;
 $E0F4 JR NZ,$E110     ; }
 $E0F6 LD A,($648A)    ; {Jump to #R$E107 if the player is two rows below
 $E0F9 SUB $02         ; *#R$648A.
 $E0FB CP (IX+$01)     ;
 $E0FE JR Z,$E107      ; }
 $E100 ADD A,$05       ; {Jump to #R$E110 unless the player is three rows
 $E102 CP (IX+$01)     ; above that point.
 $E105 JR NZ,$E110     ; }
@label=Player_ClimbStop_Clear
*$E107 XOR A           ; {Return after restoring the walk frame.
 $E108 LD ($648A),A    ;
 $E10B LD (IX+$06),$60 ;
 $E10F RET             ; }
@label=Player_ReadKeys
*$E110 POP BC          ; Restore #REGbc from the stack.
 $E111 LD A,($647E)    ; {Jump to #R$D864 if Kempston is selected.
 $E114 OR A            ;
 $E115 JP NZ,$D864     ; }
 $E118 CALL $028E      ; Call #SKOOLKID$028E(KEY_SCAN).
 $E11B LD IX,$64A4     ; #REGix=#R$64A4.
 $E11F LD A,E          ; {Jump to #R$E358 if no key is pressed.
 $E120 CP $FF          ;
 $E122 JP Z,$E358      ; }
 $E125 LD HL,$6481     ; {Jump to #R$E145 if the up key matches.
 $E128 CP (HL)         ;
 $E129 JR Z,$E145      ; }
 $E12B INC HL          ; {Jump to #R$E358 unless the down key matches.
 $E12C CP (HL)         ;
 $E12D JP NZ,$E358     ; }
; This entry point is used by the routine at #R$D864.
; .
; Animate climbing down.
@label=Player_ClimbDown_Anim
*$E130 LD A,(IX+$06)   ; {Step the climb frame down.
 $E133 SUB $06         ;
 $E135 CP $42          ;
 $E137 JR NZ,$E13B     ;
 $E139 LD A,$5A        ; }
@label=Player_ClimbDown_StoreFrame
*$E13B LD (IX+$06),A   ; {Store the frame, write #N$FE as the vertical delta
 $E13E LD (IX+$09),$FE ; and jump to #R$E358.
 $E142 JP $E358        ; }
; This entry point is used by the routine at #R$D864.
; .
; Animate climbing up.
@label=Player_ClimbUp_Anim
*$E145 LD A,(IX+$06)   ; {Step the climb frame up.
 $E148 ADD A,$06       ;
 $E14A CP $60          ;
 $E14C JR NZ,$E150     ;
 $E14E LD A,$48        ; }
@label=Player_ClimbUp_StoreFrame
*$E150 LD (IX+$06),A   ; {Store the frame, write #N$02 as the vertical delta
 $E153 LD (IX+$09),$02 ; and jump to #R$E358.
 $E157 JP $E358        ; }
; This entry point is used by the routine at #R$E1CC.
; .
; Flash and drop the player after a hit.
; #HTML(#AUDIO0(bonus.wav)(#INCLUDE(Bonus)))
@label=Player_Hit
*$E15A LD A,($6435)    ; {Award a bonus if the hit timer is still #N$32.
 $E15D CP $32          ;
 $E15F JR NZ,$E16A     ;
 $E161 LD BC,$0064     ;
 $E164 LD DE,$00C8     ;
 $E167 CALL $E501      ; }
; Advance, store and erase the falling player.
@label=Player_Hit_Fall
*$E16A LD (IX+$09),$FF ; Write #N$FF as the vertical delta.
 $E16E CALL $F448      ; Call #R$F448.
 $E171 CALL $F424      ; Call #R$F424.
 $E174 CALL $F442      ; Call #R$F442.
; Clip the draw against *#R$644A.
 $E177 LD A,($641A)    ; #REGa=*#R$641A.
 $E17A PUSH AF         ; Stash it on the stack.
 $E17B LD A,($644A)    ; {Write *#R$644A to *#R$641A.
 $E17E LD ($641A),A    ; }
 $E181 CALL $F44B      ; Call #R$F44B.
 $E184 POP AF          ; Restore *#R$641A from the stack.
 $E185 LD ($641A),A    ; Write it back to *#R$641A.
 $E188 LD A,($6435)    ; {Decrease *#R$6435.
 $E18B DEC A           ; }
 $E18C JP Z,$DF22      ; Jump to #R$DF22 if it is now zero.
 $E18F LD ($6435),A    ; Write the new count back.
 $E192 RET             ; Return.
; This entry point is used by the routine at #R$E1CC.
; .
; Animate the jump frames from *#R$6410.
@label=Player_JumpAnim
*$E193 DEC A           ; {Decrease *#R$6410 and point at #R$E292.
 $E194 LD ($6410),A    ;
 $E197 LD HL,$E292     ;
 $E19A PUSH HL         ; }
 $E19B LD (IX+$06),$30 ; {Use frame #N$30 while the timer is #N$06 or higher.
 $E19F CP $06          ; }
 $E1A1 RET NC          ; {Use frame #N$36 while the timer is #N$04 or higher.
 $E1A2 LD (IX+$06),$36 ;
 $E1A6 CP $04          ; }
 $E1A8 RET NC          ; {Use frame #N$3C while the timer is #N$03 or higher.
 $E1A9 LD (IX+$06),$3C ;
 $E1AD CP $03          ; }
 $E1AF RET NC          ; {Use frame #N$42 while the timer is #N$01 or higher.
 $E1B0 LD (IX+$06),$42 ;
 $E1B4 CP $01          ; }
 $E1B6 RET NC          ; {Use frame #N$12 for the last tick.
 $E1B7 LD (IX+$06),$12 ; }
 $E1BB RET             ; Return.
; This entry point is used by the routine at #R$E1CC.
; .
; Start the hit sequence.
@label=Player_StartHit
*$E1BC LD A,$32        ; {Write #N$32 to *#R$6435 and store the ceiling row.
 $E1BE LD ($6435),A    ;
 $E1C1 LD A,(IX+$01)   ;
 $E1C4 SUB $03         ;
 $E1C6 LD ($644A),A    ; }
 $E1C9 JP $E292        ; Jump to #R$E292.

; Handler: Player
;
; Used by the routine at #R$D7A2.
; .
; Moves, collides and draws the player entity at #R$64A4.
@label=Handler_Player
c$E1CC LD A,($646F)    ; {Return if *#R$646F is set (demo / intro).
 $E1CF OR A            ;
 $E1D0 RET NZ          ; }
 $E1D1 LD HL,$B5B1     ; {Write #R$B5B1 to *#SKOOLKID$5C36(CHARS).
 $E1D4 LD ($5C36),HL   ; }
 $E1D7 LD IX,$64A4     ; #REGix=#R$64A4.
 $E1DB LD A,($6489)    ; {Erase the player while *#R$6489 is running.
 $E1DE OR A            ;
 $E1DF PUSH AF         ;
 $E1E0 CALL NZ,$F44B   ;
 $E1E3 POP AF          ;
 $E1E4 RET NZ          ; }
 $E1E5 LD A,($6435)    ; {Jump to #R$E15A if *#R$6435 is set.
 $E1E8 OR A            ;
 $E1E9 JP NZ,$E15A     ; }
 $E1EC LD A,($6410)    ; {Jump to #R$E193 if *#R$6410 is set.
 $E1EF OR A            ;
 $E1F0 JP NZ,$E193     ; }
 $E1F3 LD A,($648A)    ; {Call #R$E0EF if *#R$648A is set.
 $E1F6 OR A            ;
 $E1F7 CALL NZ,$E0EF   ; }
 $E1FA CALL $DE96      ; Call #R$DE96.
 $E1FD LD A,($6434)    ; {Start a fall if *#R$6434 is not a collision.
 $E200 CP $03          ;
 $E202 JR Z,$E22C      ;
 $E204 LD (IX+$09),$FC ; }
 $E208 PUSH IY         ; Stash #REGiy on the stack.
 $E20A LD IY,($6430)   ; #REGiy=*#R$6430.
@label=Handler_Player_ActorLoop
*$E20E LD A,(IY+$00)   ; {Jump to #R$E22A if the terminator #N$FF is reached.
 $E211 CP $FF          ;
 $E213 JR Z,$E22A      ; }
 $E215 BIT 7,A         ; {Jump to #R$E223 if this actor is inactive.
 $E217 JR NZ,$E223     ; }
 $E219 CALL $DB3F      ; Call #R$DB3F.
 $E21C LD A,($6434)    ; {Stop scanning once *#R$6434 is a collision.
 $E21F CP $03          ;
 $E221 JR Z,$E22A      ; }
@label=Handler_Player_ActorNext
*$E223 LD DE,$000D     ; {#REGiy+=#N($000D,$04,$04).
 $E226 ADD IY,DE       ; }
 $E228 JR $E20E        ; Jump to #R$E20E.
@label=Handler_Player_ActorsDone
*$E22A POP IY          ; Restore #REGiy from the stack.
@label=Handler_Player_Apply
*$E22C LD A,(IX+$09)   ; {Probe the ceiling while the vertical delta is
 $E22F OR A            ; negative.
 $E230 JR Z,$E246      ;
 $E232 CP $80          ;
 $E234 JR C,$E246      ;
 $E236 CALL $DE43      ; }
 $E239 LD A,($6438)    ; {Increase *#R$6438 and honour a collision.
 $E23C INC A           ;
 $E23D LD ($6438),A    ;
 $E240 LD A,($6434)    ;
 $E243 OR A            ;
 $E244 JR Z,$E28C      ; }
@label=Handler_Player_Stand
*$E246 LD A,($6438)    ; {Start a hit if *#R$6438 reaches #N$0A.
 $E249 CP $0A          ;
 $E24B JP NC,$E1BC     ; }
 $E24E XOR A           ; {Clear *#R$6438.
 $E24F LD ($6438),A    ; }
 $E252 LD A,($647E)    ; {Jump to #R$D82D if Kempston is selected.
 $E255 OR A            ;
 $E256 JP NZ,$D82D     ; }
 $E259 CALL $028E      ; Call #SKOOLKID$028E(KEY_SCAN).
 $E25C LD A,E          ; #REGa=the keypress.
 $E25D LD IX,$64A4     ; #REGix=#R$64A4.
 $E261 LD HL,$647F     ; {Call #R$DF44 if the left key matches.
 $E264 CP (HL)         ;
 $E265 PUSH AF         ;
 $E266 CALL Z,$DF44    ;
 $E269 POP AF          ; }
 $E26A PUSH AF         ; {Call #R$DF69 if the right key matches.
 $E26B LD HL,$6480     ;
 $E26E CP (HL)         ;
 $E26F CALL Z,$DF69    ;
 $E272 POP AF          ; }
 $E273 PUSH AF         ; {Call #R$E06A if the up key matches.
 $E274 LD HL,$6481     ;
 $E277 CP (HL)         ;
 $E278 CALL Z,$E06A    ;
 $E27B POP AF          ; }
 $E27C PUSH AF         ; {Call #R$E013 if the down key matches.
 $E27D LD HL,$6482     ;
 $E280 CP (HL)         ;
 $E281 CALL Z,$E013    ;
 $E284 POP AF          ; }
 $E285 LD HL,$6483     ; {Call #R$DF8E if the action key matches.
 $E288 CP (HL)         ;
 $E289 CALL Z,$DF8E    ; }
; This entry point is used by the routine at #R$D82D.
@label=Handler_Player_Resolve
*$E28C LD A,($648A)    ; {Fall through to #R$E292 when *#R$648A is set.
 $E28F OR A            ;
 $E290 JR NZ,$E292     ; }
; This entry point is used by the routine at #R$DE19.
@label=Handler_Player_Draw
*$E292 CALL $F448      ; Call #R$F448.
; Start a fall if the new row is off the bottom of the
; room.
 $E295 LD A,B          ; {Jump to #R$E2AA unless the new row is #N$1B.
 $E296 CP $1B          ;
 $E298 JR NZ,$E2AA     ; }
 $E29A LD (IX+$09),$FC ; Write #N$FC as the vertical delta.
 $E29E XOR A           ; {Write #N$00 to *#R$6434 and *#R$6410.
 $E29F LD ($6434),A    ;
 $E2A2 LD ($6410),A    ; }
 $E2A5 LD A,$0C        ; {Write #N$0C to *#R$6438.
 $E2A7 LD ($6438),A    ; }
@label=Handler_Player_Collision
*$E2AA LD A,($6434)    ; {Jump to #R$E358 if *#R$6434 is a collision.
 $E2AD CP $03          ;
 $E2AF JP Z,$E358      ; }
; Probe the tiles above while the player is jumping.
 $E2B2 LD A,($6410)    ; {Jump to #R$E2E2 if *#R$6410 is zero.
 $E2B5 OR A            ;
 $E2B6 JR Z,$E2E2      ; }
 $E2B8 LD A,B          ; {Jump to #R$E2E2 if the row has not changed.
 $E2B9 CP (IX+$01)     ;
 $E2BC JR Z,$E2E2      ; }
 $E2BE LD A,E          ; {#REGa=#N$03, or #N$02 when fine-Y is #N$07.
 $E2BF CP $07          ;
 $E2C1 LD A,$00        ;
 $E2C3 ADC A,$02       ;
 $E2C5 PUSH AF         ; }
 $E2C6 CALL $F43C      ; {Convert that cell into a #R$5DCE pointer.
 $E2C9 LD DE,$5DCE     ;
 $E2CC ADD HL,DE       ;
 $E2CD POP AF          ;
 $E2CE LD B,A          ; }
@label=Handler_Player_ProbeUp
*$E2CF LD A,(HL)       ; {Jump to #R$E2DF if this tile is solid (#N$10 or
 $E2D0 CP $10          ; higher).
 $E2D2 JR NC,$E2DF     ; }
 $E2D4 XOR A           ; {Clear the vertical delta.
 $E2D5 LD (IX+$09),A   ; }
 $E2D8 INC BC          ; {Jump to #R$E33F until the probe count is zero,
 $E2D9 DJNZ $E33F      ; then clear the sprite.
 $E2DB LD (IX+$06),$00 ; }
@label=Handler_Player_ProbeUpNext
*$E2DF INC HL          ; {Advance the tile pointer and loop back to #R$E2CF.
 $E2E0 DJNZ $E2CF      ; }
; Probe the tiles to the right while moving right.
@label=Handler_Player_Horizontal
*$E2E2 CALL $F448      ; Call #R$F448.
 $E2E5 LD A,(IX+$08)   ; {Jump to #R$E322 if the horizontal delta is
 $E2E8 CP $80          ; negative.
 $E2EA JR NC,$E322     ; }
 $E2EC LD A,C          ; {Jump to #R$E358 if the column has not changed.
 $E2ED CP (IX+$00)     ;
 $E2F0 JR Z,$E358      ; }
 $E2F2 LD A,D          ; {#REGa=#N$04, or #N$03 when fine-Y is #N$07.
 $E2F3 CP $07          ;
 $E2F5 LD A,$00        ;
 $E2F7 ADC A,$03       ;
 $E2F9 PUSH AF         ; }
 $E2FA CALL $F43C      ; {Convert that cell into a #R$5DCE pointer.
 $E2FD LD DE,$5DCE     ;
 $E300 ADD HL,DE       ;
 $E301 POP AF          ;
 $E302 LD B,A          ;
 $E303 LD DE,$0020     ; }
@label=Handler_Player_ProbeRight
*$E306 LD A,(HL)       ; {Jump to #R$E31D if this tile is solid (#N$10 or
 $E307 CP $10          ; higher).
 $E309 JR NC,$E31D     ; }
 $E30B XOR A           ; {Clear the horizontal delta.
 $E30C LD (IX+$08),A   ; }
 $E30F LD A,($6410)    ; {Jump to #R$E31D if *#R$6410 is zero.
 $E312 OR A            ;
 $E313 JR Z,$E31D      ; }
 $E315 XOR A           ; {Write #N$00 to *#R$6410 and clear the sprite.
 $E316 LD ($6410),A    ;
 $E319 LD (IX+$06),$00 ; }
@label=Handler_Player_ProbeRightNext
*$E31D ADD HL,DE       ; {Step down one row and loop back to #R$E306, then
 $E31E DJNZ $E306      ; jump to #R$E358.
 $E320 JR $E358        ; }
; Probe the tiles to the left while moving left.
@label=Handler_Player_Left
*$E322 LD A,C          ; {Jump to #R$E358 if the column has not changed.
 $E323 CP (IX+$00)     ;
 $E326 JR Z,$E358      ; }
 $E328 DEC C           ; {Point two columns left; #REGa=#N$04, or #N$03
 $E329 DEC C           ; when fine-Y is #N$07.
 $E32A LD A,D          ;
 $E32B CP $07          ;
 $E32D LD A,$00        ;
 $E32F ADC A,$03       ;
 $E331 PUSH AF         ; }
 $E332 CALL $F43C      ; {Convert that cell into a #R$5DCE pointer.
 $E335 LD DE,$5DCE     ;
 $E338 ADD HL,DE       ;
 $E339 POP AF          ;
 $E33A LD B,A          ;
 $E33B LD DE,$0020     ; }
@label=Handler_Player_ProbeLeft
*$E33E LD A,(HL)       ; {Jump to #R$E355 if this tile is solid (#N$10 or
@label=Handler_Player_ProbeLeftTest
*$E33F CP $10          ; higher).
 $E341 JR NC,$E355     ; }
 $E343 XOR A           ; {Clear the horizontal delta.
 $E344 LD (IX+$08),A   ; }
 $E347 LD A,($6410)    ; {Jump to #R$E355 if *#R$6410 is zero.
 $E34A OR A            ;
 $E34B JR Z,$E355      ; }
 $E34D XOR A           ; {Write #N$00 to *#R$6410 and clear the sprite.
 $E34E LD ($6410),A    ;
 $E351 LD (IX+$06),$00 ; }
@label=Handler_Player_ProbeLeftNext
*$E355 ADD HL,DE       ; {Step down one row and loop back to #R$E33E.
 $E356 DJNZ $E33E      ; }
; This entry point is used by the routines at #R$D864 and #R$DE19.
@label=Handler_Player_Commit
*$E358 CALL $F448      ; Call #R$F448.
 $E35B LD A,C          ; {Jump to #R$E398 if the new column is off-screen.
 $E35C CP $22          ;
 $E35E JP Z,$E398      ;
 $E361 CP $03          ;
 $E363 JP Z,$E398      ; }
 $E366 LD A,B          ; {Start a fall if the new row is #N$1A.
 $E367 CP $1A          ;
 $E369 JR NZ,$E373     ;
 $E36B XOR A           ;
 $E36C LD ($6410),A    ;
 $E36F LD (IX+$09),$FC ; }
; Store, move and draw the player.
@label=Handler_Player_Paint
*$E373 CALL $F424      ; Call #R$F424.
 $E376 CALL $F442      ; Call #R$F442.
 $E379 CALL $F44B      ; Call #R$F44B.
 $E37C LD A,($6434)    ; {Draw a collided actor through #R$F45A.
 $E37F CP $03          ;
 $E381 JR NZ,$E38A     ;
 $E383 LD IX,($644B)   ;
 $E387 CALL $F45A      ; }
; Reset after drawing.
@label=Handler_Player_Reset
*$E38A LD IX,$64A4     ; Point #REGix at #R$64A4.
 $E38E XOR A           ; {Write #N$00 to *#R$6434.
 $E38F LD ($6434),A    ; }
 $E392 LD A,($6410)    ; {Jump to #R$E3A4 if *#R$6410 is set.
 $E395 OR A            ;
 $E396 JR NZ,$E3A4     ; }
; Clear the jump timer and both deltas.
@label=Handler_Player_ClearDeltas
*$E398 XOR A           ; {Write #N$00 to *#R$6410.
 $E399 LD ($6410),A    ; }
 $E39C LD (IX+$08),$00 ; {Write #N$00 to both movement deltas.
 $E3A0 LD (IX+$09),$00 ; }
@label=Handler_Player_Floor
*$E3A4 LD A,(IX+$01)   ; {Jump to #R$DEFB when standing on the floor.
 $E3A7 CP $03          ;
 $E3A9 JR Z,$E3B0      ;
 $E3AB LD A,($6411)    ;
 $E3AE OR A            ;
 $E3AF RET Z           ; }
@label=Handler_Player_Award
*$E3B0 JP $DEFB        ; Jump to #R$DEFB.
; This entry point is used by the routine at #R$D5AC.
; .
; Clear the play area and the room buffers.
@label=Clear_PlayArea
*$E3B3 XOR A           ; {Write #INK$00 to *#SKOOLKID$5C8F(ATTR_T).
 $E3B4 LD ($5C8F),A    ; }
 $E3B7 CALL $1CAD      ; Call #SKOOLKID$1CAD(CL_ALL).
 $E3BA LD HL,$5DCE     ; {Write #N$00 to the #N$0320 bytes at #R$5DCE.
 $E3BD LD BC,$0320     ;
@label=Clear_PlayArea_TileLoop
*$E3C0 XOR A           ;
 $E3C1 LD (HL),A       ;
 $E3C2 INC HL          ;
 $E3C3 DEC BC          ;
 $E3C4 LD A,B          ;
 $E3C5 OR C            ;
 $E3C6 JR NZ,$E3C0     ; }
 $E3C8 LD BC,$0320     ; {Fill #R$60EE with *#SKOOLKID$5C8F(ATTR_T).
 $E3CB LD HL,$60EE     ;
@label=Clear_PlayArea_AttributeLoop
*$E3CE LD A,($5C8F)    ;
 $E3D1 LD (HL),A       ;
 $E3D2 INC HL          ;
 $E3D3 DEC BC          ;
 $E3D4 LD A,B          ;
 $E3D5 OR C            ;
 $E3D6 JR NZ,$E3CE     ; }
 $E3D8 LD B,$18        ; {Call #SKOOLKID$0E44(CL_LINE) for #N$18 lines.
 $E3DA CALL $0E44      ; }
 $E3DD RET             ; Return.
; View the equivalent code in #BOOTY$EBD8.

; Handler: Actors
;
; Used by the routine at #R$D7A2.
; .
; Animates the #N$0D-byte records at *#R$6430.
@label=Handler_Actors
c$E3DE CALL $DE96     ; Call #R$DE96.
 $E3E1 LD IX,($6430)  ; #REGix=*#R$6430.
@label=Handler_Actors_Loop
*$E3E5 LD A,(IX+$00)  ; {Return if the terminator #N$FF is reached.
 $E3E8 INC A          ;
 $E3E9 RET Z          ; }
 $E3EA BIT 7,A        ; {Jump to #R$E41E if this actor is inactive.
 $E3EC JR NZ,$E41E    ; }
; Test this actor against the player.
 $E3EE PUSH IY        ; Stash #REGiy on the stack.
 $E3F0 PUSH IX        ; {Copy #REGix to #REGiy (using the stack).
 $E3F2 POP IY         ; }
 $E3F4 CALL $DB3F     ; Call #R$DB3F.
 $E3F7 POP IY         ; Restore #REGiy from the stack.
 $E3F9 CALL $F45D     ; Call #R$F45D.
 $E3FC BIT 7,(IX+$07) ; {Restore the stored row when bit 7 of *#REGix+#N$07 is
 $E400 JR Z,$E40C     ; set.
 $E402 RES 7,(IX+$07) ;
 $E406 LD A,(IX+$0B)  ;
 $E409 LD (IX+$01),A  ; }
; Store the new position.
@label=Handler_Actors_Commit
*$E40C CALL $F448     ; Call #R$F448.
 $E40F LD (IX+$00),C  ; {Store the new column, row, fine-X and fine-Y.
 $E412 LD (IX+$01),B  ;
 $E415 LD (IX+$02),E  ;
 $E418 LD (IX+$03),D  ; }
 $E41B CALL $F45A     ; Call #R$F45A.
@label=Handler_Actors_Next
*$E41E LD DE,$000D    ; {#REGix+=#N($000D,$04,$04).
 $E421 ADD IX,DE      ; }
 $E423 JR $E3E5       ; Jump to #R$E3E5.
 $E425 RET            ; Return.
; Lock or reverse an actor after a collision.
@label=Actor_AfterCollision
*$E426 CP $02         ; {Jump to #R$E436 if the actor type is #N$02.
 $E428 JP Z,$E436     ; }
 $E42B CALL $E441     ; Call #R$E441.
 $E42E XOR A          ; {Write #N$00 to both actor deltas.
 $E42F LD (IY+$08),A  ;
 $E432 LD (IY+$09),A  ; }
 $E435 RET            ; Return.
@label=Actor_Lock
*$E436 SET 7,(IY+$07) ; Set bit 7 of *#REGiy+#N$07.
 $E43A RET            ; Return.
; This entry point is used by the routine at #R$DB3F.
@label=Actor_Reverse
*$E43B LD A,(IY+$0C)  ; {Jump to #R$E426 if *#REGiy+#N$0C is set.
 $E43E OR A           ;
 $E43F JR NZ,$E426    ; }
@label=Actor_SwapDestination
*$E441 LD A,(IY+$05)  ; {Swap *#REGiy+#N$05 with *#REGiy+#N$0A.
 $E444 LD C,(IY+$0A)  ;
 $E447 LD (IY+$05),C  ;
 $E44A LD (IY+$0A),A  ; }
 $E44D LD A,(IY+$06)  ; {Swap *#REGiy+#N$06 with *#REGiy+#N$0B.
 $E450 LD C,(IY+$0B)  ;
 $E453 LD (IY+$0B),A  ;
 $E456 LD (IY+$06),C  ; }
 $E459 LD A,(IY+$08)  ; {#REGa=*#REGiy+#N$08-#N$01.
 $E45C DEC A          ; }
 $E45D XOR %11111111  ; Invert every bit.
 $E45F LD (IY+$08),A  ; Write the new horizontal delta.
 $E462 LD A,(IY+$09)  ; {#REGa=*#REGiy+#N$09-#N$01.
 $E465 DEC A          ; }
 $E466 XOR %11111111  ; Invert every bit.
 $E468 LD (IY+$09),A  ; Write the new vertical delta.
 $E46B RET            ; Return.

; Handler: Interrupts
;
; IM #N$02 lands here from #R$FEFE. Plays the next tune note every five
; ticks and services any pending sound.
@label=Handler_Interrupts
c$E46C PUSH AF       ; {Stash #REGaf, #REGbc, #REGde, #REGhl and #REGix.
 $E46D PUSH BC       ;
 $E46E PUSH DE       ;
 $E46F PUSH HL       ;
 $E470 PUSH IX       ; }
 $E472 LD A,R        ; {Return unless bit 7 of the refresh register is set.
 $E474 BIT 7,A       ;
 $E476 RET Z         ; }
 $E477 LD A,($646E)  ; {Increase *#R$646E and return unless it reached #N$05.
 $E47A INC A         ;
 $E47B LD ($646E),A  ;
 $E47E CP $05        ;
 $E480 JR NZ,$E49B   ; }
 $E482 XOR A         ; {Write #N$00 to *#R$646E.
 $E483 LD ($646E),A  ; }
; #HTML(#AUDIO0(score.wav)(#INCLUDE(Score)))
 $E486 LD A,($6472)  ; {Call #R$E4D3 if bit 4 of *#R$6472 is set.
 $E489 BIT 4,A       ;
 $E48B CALL NZ,$E4D3 ; }
; #HTML(#AUDIO0(beep.wav)(#INCLUDE(Beep)))
 $E48E LD A,($6473)  ; {Jump to #R$E4A3 if *#R$6473 is set.
 $E491 OR A          ;
 $E492 JP NZ,$E4A3   ; }
; #HTML(#AUDIO0(theme-tune.wav)(#INCLUDE(ThemeTune)))
 $E495 LD BC,$1106   ; {Call #R$E666 with note length #N$1106.
 $E498 CALL $E666    ; }
@label=Handler_Interrupts_Done
*$E49B POP IX        ; {Restore the stashed registers from the stack.
 $E49D POP HL        ;
 $E49E POP DE        ;
 $E49F POP BC        ;
 $E4A0 POP AF        ; }
 $E4A1 EI            ; Enable interrupts.
 $E4A2 RET           ; Return.
; #HTML(#AUDIO0(beep.wav)(#INCLUDE(Beep)))
@label=Handler_Interrupts_Beep
*$E4A3 DEC A         ; {Decrease *#R$6473 and play a short beep.
 $E4A4 LD ($6473),A  ;
 $E4A7 LD B,$7F      ;
 $E4A9 LD D,$0C      ;
 $E4AB CALL $E4B1    ; }
 $E4AE JP $E49B      ; Jump to #R$E49B.
; This entry point is used by the routine at #R$D904.
; .
; Toggle the speaker #REGd times using a random delay.
; #HTML(#AUDIO0(noise.wav)(#INCLUDE(Noise)))
@label=Play_Noise
*$E4B1 CALL $E4C1    ; {Toggle bit 4 of the speaker for #REGd iterations.
 $E4B4 OUT ($FE),A   ;
 $E4B6 CALL $E4C1    ;
 $E4B9 OR $10        ;
 $E4BB OUT ($FE),A   ;
 $E4BD DEC D         ;
 $E4BE JR NZ,$E4B1   ;
 $E4C0 RET           ; }
@label=Play_Noise_Delay
*$E4C1 PUSH BC       ; {Delay by a random count masked with #REGb.
 $E4C2 CALL $F433    ;
 $E4C5 AND B         ;
 $E4C6 LD B,A        ;
 $E4C7 OR A          ;
 $E4C8 JR Z,$E4CE    ;
@label=Play_Noise_Wait
*$E4CA NOP           ;
 $E4CB NOP           ;
 $E4CC DJNZ $E4CA    ; }
@label=Play_Noise_Done
*$E4CE POP BC        ; {#REGa=*#R$641D.
 $E4CF LD A,($641D)  ; }
 $E4D2 RET           ; Return.
; Falling-pitch score sound.
; #HTML(#AUDIO0(score.wav)(#INCLUDE(Score)))
@label=Sound_Score
*$E4D3 AND %11101111 ; Clear bit 4.
 $E4D5 LD ($6472),A  ; Write #REGa to *#R$6472.
 $E4D8 LD DE,$0032   ; #REGde=#N($0032,$04,$04).
 $E4DB LD BC,$0064   ; #REGbc=#N($0064,$04,$04).
 $E4DE JP $E4E1      ; Jump to #R$E4E1.
; This entry point is used by the routine at #R$DE19.
; .
; Square-wave sound while #REGde and #REGbc count down.
@label=Sound_Square
*$E4E1 CALL $F430    ; {Toggle the speaker until both counters are zero.
 $E4E4 LD A,($641D)  ;
 $E4E7 OUT ($FE),A   ;
 $E4E9 CALL $F430    ;
 $E4EC LD A,($641D)  ;
 $E4EF OR $10        ;
 $E4F1 OUT ($FE),A   ;
 $E4F3 DEC BC        ;
 $E4F4 LD A,C        ;
 $E4F5 OR B          ;
 $E4F6 JR Z,$E4FD    ;
 $E4F8 DEC DE        ;
 $E4F9 LD A,D        ;
 $E4FA OR E          ;
 $E4FB JR NZ,$E4E1   ; }
@label=Sound_Square_Done
*$E4FD LD A,($6472)  ; #REGa=*#R$6472.
 $E500 RET           ; Return.
; This entry point is used by the routines at #R$DBC9 and #R$DE19.
; .
; Rising-pitch pickup sound.
; #HTML(#AUDIO0(pickup.wav)(#INCLUDE(Pickup)))
@label=Sound_Pickup
*$E501 CALL $F430    ; {Toggle the speaker while increasing #REGbc.
 $E504 LD A,($641D)  ;
 $E507 OUT ($FE),A   ;
 $E509 CALL $F430    ;
 $E50C LD A,($641D)  ;
 $E50F OR $10        ;
 $E511 OUT ($FE),A   ;
 $E513 INC BC        ;
 $E514 DEC DE        ;
 $E515 LD A,E        ;
 $E516 OR D          ;
 $E517 JR NZ,$E501   ;
 $E519 LD A,($6472)  ;
 $E51C RET           ; }
; View the equivalent code in #BOOTY$FE69.

; Animate Introduction
;
; Used by the routine at #R$D5AC.
; .
; Animates the bats and moon on the introduction screen until a key is
; pressed or *#R$6470 reaches zero.
;
; .
;
; #HTML(#AUDIO0(theme-tune.wav)(#INCLUDE(ThemeTune)))
@label=Animate_Introduction
c$E51D LD BC,$0A14                          ; {Call #R$E666 with note length
 $E520 CALL $E666                           ; #N$0A14.}
 $E523 LD BC,($6470)                        ; {Decrease *#R$6470 and jump to
 $E527 DEC BC                               ; #R$E65B when it is zero.
 $E528 LD A,B                               ;
 $E529 OR C                                 ;
 $E52A JP Z,$E65B                           ; }
 $E52D LD ($6470),BC                        ; {Call #R$F430 when *#R$647C is
 $E531 LD A,($647C)                         ; set.
 $E534 OR A                                 ;
 $E535 LD B,$19                             ;
 $E537 CALL NZ,$F430                        ; }
; Advance the four frame pointers and draw them across the
; moon.
 $E53A LD HL,($E632)                        ; #REGhl=*#R$E632.
 $E53D LD DE,$0004                          ; {Add #N($0004,$04,$04).
 $E540 ADD HL,DE                            ; }
 $E541 LD DE,$D4C1                          ; {Jump to #R$E54E unless the
 $E544 PUSH HL                              ; pointer has reached #R$D4C1.
 $E545 XOR A                                ;
 $E546 SBC HL,DE                            ;
 $E548 POP HL                               ;
 $E549 JR NZ,$E54E                          ; }
 $E54B LD HL,$D381                          ; Reset the pointer to #R$D381.
@label=Animate_Introduction_Frame1
*$E54E LD ($E632),HL                        ; Write #REGhl to *#R$E632.
 $E551 LD DE,$4066                          ; {Draw that frame at #N$4066.
 $E554 CALL $E63A                           ; }
 $E557 LD HL,($E634)                        ; #REGhl=*#R$E634.
 $E55A LD DE,$0002                          ; {Subtract #N($0002,$04,$04).
 $E55D XOR A                                ;
 $E55E SBC HL,DE                            ; }
 $E560 PUSH HL                              ; {Jump to #R$E56C unless the pointer has reached
 $E561 LD DE,$D37F                          ; #R$D381(#N$D37F).
 $E564 SBC HL,DE                            ;
 $E566 POP HL                               ;
 $E567 JR NZ,$E56C                          ; }
 $E569 LD HL,$D4C1                          ; Reset the pointer to #R$D4C1.
@label=Animate_Introduction_Frame2
*$E56C LD ($E634),HL                        ; Write #REGhl to *#R$E634.
 $E56F LD DE,$4068                          ; {Draw that frame at #N$4068.
 $E572 CALL $E63A                           ; }
 $E575 LD HL,($E636)                        ; #REGhl=*#R$E636.
 $E578 INC HL                               ; {Advance the pointer by two.
 $E579 INC HL                               ; }
 $E57A PUSH HL                              ; {Jump to #R$E587 unless the
 $E57B LD DE,$D4C1                          ; pointer has reached #R$D4C1.
 $E57E XOR A                                ;
 $E57F SBC HL,DE                            ;
 $E581 POP HL                               ;
 $E582 JR NZ,$E587                          ; }
 $E584 LD HL,$D381                          ; Reset the pointer to #R$D381.
@label=Animate_Introduction_Frame3
*$E587 LD ($E636),HL                        ; Write #REGhl to *#R$E636.
 $E58A LD DE,$406A                          ; {Draw that frame at #N$406A.
 $E58D CALL $E63A                           ; }
 $E590 LD HL,($E638)                        ; #REGhl=*#R$E638.
 $E593 LD DE,$0004                          ; {Subtract #N($0004,$04,$04).
 $E596 XOR A                                ;
 $E597 SBC HL,DE                            ; }
 $E599 PUSH HL                              ; {Jump to #R$E5A5 unless the
 $E59A LD DE,$D381                          ; pointer has reached #R$D381.
 $E59D SBC HL,DE                            ;
 $E59F POP HL                               ;
 $E5A0 JR NZ,$E5A5                          ; }
 $E5A2 LD HL,$D4C1                          ; Reset the pointer to #R$D4C1.
@label=Animate_Introduction_Frame4
*$E5A5 LD ($E638),HL                        ; Write #REGhl to *#R$E638.
 $E5A8 LD DE,$406C                          ; {Draw that frame at #N$406C.
 $E5AB CALL $E63A                           ; }
; Occasionally stamp a spark on the moon.
 $E5AE CALL $F433                           ; Call #R$F433.
 $E5B1 CP $40                               ; {Jump to #R$E5CA if the value is
 $E5B3 JR NC,$E5CA                          ; #N$40 or higher.}
 $E5B5 CP $20                               ; {Point #REGhl at #R$E5EA when the value is #N$20 or
 $E5B7 LD HL,$E5EA                          ; higher.}
 $E5BA JR NC,$E5BF                          ; {Otherwise use the second spark
 $E5BC LD HL,$E5EE                          ; at #R$E5EA(#N$E5EE).}
@label=Animate_Introduction_Spark
*$E5BF LD DE,$40D7                          ; {Point at #N$40D7 and copy #N$04
 $E5C2 LD B,$04                             ; pixel rows.}
@label=Animate_Introduction_SparkLoop
*$E5C4 LD A,(HL)                            ; {Copy one pixel row and loop back to #R$E5C4 until all
 $E5C5 LD (DE),A                            ; four rows are written.
 $E5C6 INC HL                               ;
 $E5C7 INC D                                ;
 $E5C8 DJNZ $E5C4                           ; }
; Occasionally stamp a bat lower down the screen.
@label=Animate_Introduction_Bat
*$E5CA CALL $F433                           ; Call #R$F433.
 $E5CD CP $40                               ; {Jump to #R$E5E1 if the value is
 $E5CF JR NC,$E5E1                          ; #N$40 or higher.}
 $E5D1 LD HL,$E5F2                          ; {Point #REGhl at #R$E5F2 when the value is #N$20 or
 $E5D4 CP $20                               ; higher.
 $E5D6 JR NC,$E5DB                          ; }
 $E5D8 LD HL,$E612                          ; Otherwise use #R$E612.
@label=Animate_Introduction_BatDraw
*$E5DB LD DE,$481D                          ; {Draw that bat at #N$481D.
 $E5DE CALL $E63A                           ; }
@label=Animate_Introduction_Key
*$E5E1 CALL $028E                           ; {Jump to #R$E51D if no key is
 $E5E4 LD A,E                               ; pressed.
 $E5E5 INC A                                ;
 $E5E6 JP Z,$E51D                           ; }
 $E5E9 RET                                  ; Return.
@label=Graphics_IntroSpark
 $E5EA DEFB $FB,$F9,$F8,$F8,$F8,$F8,$F8,$FB ; #UDGTABLE {
                                            ; #UDG(#PC)(intro-spark) }
                                            ; UDGTABLE#
@label=Graphics_IntroBatA
 $E5F2 DEFB $00,$00,$00,$00,$00,$08,$00,$1C ; {#UDGTABLE(default,centre)
 $E5FA DEFB $00,$1C,$00,$3E,$00,$3E,$00,$03 ; { #UDGS$02,$02,$04(intro-bat-1*)(
 $E602 DEFB $3F,$FB,$7F,$F3,$7C,$07,$7F,$9E ; #UDG(#PC+$08*($02*$y+$x))(*intro-bat)intro-bat) }
 $E60A DEFB $1F,$BE,$00,$1C,$06,$1C,$00,$08 ; UDGTABLE#}
@label=Graphics_IntroBatB
 $E612 DEFB $00,$00,$00,$00,$00,$10,$00,$38 ; {#UDGTABLE(default,centre)
 $E61A DEFB $00,$38,$00,$7C,$00,$7C,$00,$06 ; { #UDGS$02,$02,$04(intro-bat-2*)(
 $E622 DEFB $7F,$F6,$FF,$E6,$F8,$0E,$FF,$3C ; #UDG(#PC+$08*($02*$y+$x))(*intro-bat)intro-bat) }
 $E62A DEFB $3F,$7C,$00,$38,$0C,$38,$00,$10 ; UDGTABLE#}
@label=Pointer_IntroFrame1
 $E632 DEFW $D381                           ;
@label=Pointer_IntroFrame2
 $E634 DEFW $D3A1                           ;
@label=Pointer_IntroFrame3
 $E636 DEFW $D3C1                           ;
@label=Pointer_IntroFrame4
 $E638 DEFW $D3E1                           ;
; View the equivalent code in #BOOTY$D0AC.

; Draw Intro UDG
;
; Used by the routine at #R$E51D.
; .
; Draws a two-column, two-row UDG from *#REGhl to the
; screen at *#REGde. The introduction uses this for the moon
; and bat frames.
;
; HL Graphic data
; DE Screen address
;
; Draw the upper character row.
@label=Draw_IntroUDG
c$E63A LD B,$08      ; Set the pixel-row counter to #N$08.
 $E63C PUSH DE       ; Stash the screen address on the stack.
@label=Draw_IntroUDG_Upper
*$E63D LD A,(HL)     ; {Write the left-hand pixel byte to the screen.
 $E63E LD (DE),A     ; }
 $E63F INC HL        ; {Advance the graphic pointer and move to the next
 $E640 INC E         ; column.}
 $E641 LD A,(HL)     ; {Write the right-hand pixel byte to the screen.
 $E642 LD (DE),A     ; }
 $E643 DEC E         ; Move back to the left-hand column.
 $E644 INC D         ; Move down one pixel row.
 $E645 INC HL        ; Advance the graphic pointer.
 $E646 DJNZ $E63D    ; Decrease the pixel-row counter by one and
                     ; jump to #R$E63D until all eight rows are drawn.
; Move down one character row.
 $E648 POP DE        ; Restore the original screen address from the
                     ; stack.
 $E649 LD A,$20      ; {Add #N$20 to the screen address.
 $E64B ADD A,E       ;
 $E64C LD E,A        ; }
 $E64D LD B,$08      ; Set the pixel-row counter to #N$08.
; Draw the lower character row.
@label=Draw_IntroUDG_Lower
*$E64F LD A,(HL)     ; {Write the left-hand pixel byte to the screen.
 $E650 LD (DE),A     ; }
 $E651 INC HL        ; {Advance the graphic pointer and move to the next
 $E652 INC E         ; column.}
 $E653 LD A,(HL)     ; {Write the right-hand pixel byte to the screen.
 $E654 LD (DE),A     ; }
 $E655 INC HL        ; Advance the graphic pointer.
 $E656 DEC E         ; Move back to the left-hand column.
 $E657 INC D         ; Move down one pixel row.
 $E658 DJNZ $E64F    ; Decrease the pixel-row counter by one and
                     ; jump to #R$E64F until all eight rows are drawn.
 $E65A RET           ; Return.

; Start Demo Game
;
; Used by the routine at #R$E51D.
; .
; The introduction timed out; start a demo game.
@label=Start_DemoGame
c$E65B LD A,$04      ; {Write #N$04 to *#R$D888.
 $E65D LD ($D888),A  ; }
 $E660 XOR A         ; {Write #N$FF to *#R$646F.
 $E661 DEC A         ;
 $E662 LD ($646F),A  ; }
 $E665 RET           ; Return.

; Play Tune
;
; Used by the routines at #R$E46C and #R$E51D.
; .
; Plays one note from #R$B370 / #R$B491 through the speaker.
; #REGbc is the note length (#N$1106 in-game, #N$0A14 on the
; introduction).
;
; .
;
; #HTML(#AUDIO0(theme-tune.wav)(#INCLUDE(ThemeTune)))
@label=Play_Tune
c$E666 LD A,($647C)  ; {Jump to #R$F430 if *#R$647C is set.
 $E669 OR A          ;
 $E66A JP NZ,$F430   ; }
 $E66D LD HL,($6469) ; {Read the next #R$B370 byte, wrapping at #N$FF.
 $E670 LD A,(HL)     ;
 $E671 CP $FF        ;
 $E673 JR NZ,$E67F   ;
 $E675 LD HL,$B491   ;
 $E678 LD ($646B),HL ;
 $E67B LD HL,$B370   ;
 $E67E LD A,(HL)     ; }
@label=Play_Tune_StorePitch
*$E67F INC HL        ; {Store the pitch and read the matching #R$B491 duration.
 $E680 LD ($6469),HL ;
 $E683 LD ($646D),A  ;
 $E686 LD HL,($646B) ;
 $E689 LD A,(HL)     ;
 $E68A INC HL        ;
 $E68B LD ($646B),HL ;
 $E68E LD D,A        ;
 $E68F LD E,$01      ;
 $E691 LD A,($646D)  ;
 $E694 LD H,A        ;
 $E695 LD L,$01      ; }
 $E697 DEC A         ; {Jump to #R$E6D7 if this is a rest.
 $E698 JP NZ,$E69F   ;
 $E69B LD A,D        ;
 $E69C DEC A         ;
 $E69D JR Z,$E6D7    ; }
@label=Play_Tune_Tone
*$E69F LD A,($641D)  ; {Load the border colour and set the half-cycle
 $E6A2 EX AF,AF'     ; counters.
 $E6A3 LD A,($641D)  ;
 $E6A6 LD IXh,D      ;
 $E6A8 LD D,$10      ; }
@label=Play_Tune_Toggle
*$E6AA NOP           ; {Toggle the speaker and loop back through
 $E6AB NOP           ; #R$E6C5 and #R$E6CC.
 $E6AC EX AF,AF'     ;
 $E6AD DEC E         ;
 $E6AE OUT ($FE),A   ;
 $E6B0 JR NZ,$E6C5   ;
 $E6B2 LD E,IXh      ;
 $E6B4 XOR D         ;
 $E6B5 EX AF,AF'     ;
 $E6B6 DEC L         ;
 $E6B7 JP NZ,$E6CC   ; }
@label=Play_Tune_Half
*$E6BA OUT ($FE),A   ; {Reload the duration and loop back to #R$E6AA.
 $E6BC LD L,H        ;
 $E6BD XOR D         ;
 $E6BE DJNZ $E6AA    ;
 $E6C0 DEC C         ;
 $E6C1 JP NZ,$E6AA   ;
 $E6C4 RET           ; }
@label=Play_Tune_Hold
*$E6C5 JR Z,$E6C5    ; {Hold until the inner count expires.
 $E6C7 EX AF,AF'     ;
 $E6C8 DEC L         ;
 $E6C9 JP Z,$E6BA    ; }
@label=Play_Tune_Release
*$E6CC OUT ($FE),A   ; {Toggle the speaker on the release half-cycle.
 $E6CE NOP           ;
 $E6CF NOP           ;
 $E6D0 DJNZ $E6AA    ;
 $E6D2 DEC C         ;
 $E6D3 JP NZ,$E6AA   ;
 $E6D6 RET           ; }
@label=Play_Tune_Rest
*$E6D7 PUSH HL       ; {Waste time for a rest.
 $E6D8 LD HL,$0000   ;
 $E6DB SRA (HL)      ;
 $E6DD SRA (HL)      ;
 $E6DF SRA (HL)      ;
 $E6E1 NOP           ;
 $E6E2 POP HL        ;
 $E6E3 DEC B         ;
 $E6E4 JP NZ,$E6D7   ;
 $E6E7 DEC C         ;
 $E6E8 JP NZ,$E6D7   ;
 $E6EB RET           ; }

