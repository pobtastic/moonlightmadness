; Event: Reveal All Decorations
;
; Used by the routine at #R$EDD9.
; .
; Event #N$1D: reveal every decoration.
@label=Event_RevealAllDecorations
c$F361 LD IX,($642E)  ; #REGix=*#R$642E.
@label=Event_RevealAllDecorations_Target
*$F365 LD A,(IX+$00)  ; {Return if the terminator #N$FF is reached.
 $F368 CP $FF         ;
 $F36A RET Z          ; }
 $F36B BIT 7,A        ; {Jump to #R$F38E if this decoration is already
 $F36D JR Z,$F38E     ; visible.}
 $F36F RES 7,(IX+$00) ; Clear bit 7 of the decoration record.
 $F373 LD C,(IX+$00)  ; {#REGbc=the column and row.
 $F376 LD B,(IX+$01)  ; }
 $F379 CALL $F42D     ; Call #R$F42D.
 $F37C LD A,(IX+$02)  ; {Write the decoration colour to
 $F37F LD ($5C8F),A   ; *#SKOOLKID$5C8F(ATTR_T).}
 $F382 LD A,(IX+$03)  ; #REGa=the stored glyph.
 $F385 LD E,(IX+$04)  ; {#REGde=the stored size.
 $F388 LD D,(IX+$05)  ; }
 $F38B CALL $F445     ; Call #R$F445.
@label=Event_RevealAllDecorations_Skip
*$F38E LD DE,$0006    ; {#REGix+=#N($0006,$04,$04).
 $F391 ADD IX,DE      ; }
 $F393 JR $F365       ; Jump to #R$F365.

; Event: Toggle Tune
;
; Used by the routine at #R$EDD9.
; .
; Event #N$09: toggle the silent-tune flag.
@label=Event_ToggleTune
c$F395 LD A,($647C)  ; #REGa=*#R$647C.
 $F398 XOR %11111111 ; Invert every bit.
 $F39A LD ($647C),A  ; Write #REGa to *#R$647C.
 $F39D LD BC,$2614   ; {Write #N$2614 to *#R$649F.
 $F3A0 LD ($649F),BC ; }
 $F3A4 RET           ; Return.

