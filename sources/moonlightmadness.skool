 $F292 LD IX,($6430) ; #REGix=*#R$6430.
@label=Event_HideActor_Target
*$F296 LD A,(IX+$00) ; {Return if the terminator #N$FF is reached.
 $F299 CP $FF        ;
 $F29B RET Z         ; }
 $F29C BIT 7,A       ; {Jump to #R$F2AB if this actor is hidden.
 $F29E JR NZ,$F2AB   ; }
 $F2A0 CALL $F45D    ; Call #R$F45D.
 $F2A3 LD A,(IX+$00) ; {Set bit 7 of the actor record.
 $F2A6 SET 7,A       ;
 $F2A8 LD (IX+$00),A ; }
@label=Event_HideActor_Continue
*$F2AB LD DE,$000D   ; {#REGix+=#N($000D,$04,$04).
 $F2AE ADD IX,DE     ; }
 $F2B0 JR $F296      ; Jump to #R$F296.

; Event: Randomise Combination
;
; Used by the routine at #R$EDD9.
; .
; Event #N$16: randomise the combination.
@label=Event_RandomCombination
c$F2B2 LD BC,$013A   ; {Write #N$013A to *#R$649F.
 $F2B5 LD ($649F),BC ; }
 $F2B9 CALL $F2D9    ; Call #R$F2D9.
 $F2BC LD ($64C1),A  ; Write the digit to *#R$64C1.
 $F2BF CALL $F2D9    ; Call #R$F2D9.
 $F2C2 LD ($64C2),A  ; Write the digit to *#R$64C2.
 $F2C5 CALL $F2D9    ; Call #R$F2D9.
 $F2C8 LD ($64C3),A  ; Write the digit to *#R$64C3.
 $F2CB CALL $F2D9    ; Call #R$F2D9.
 $F2CE RES 0,A       ; Reset bit 0.
 $F2D0 AND %00000111 ; Keep only bits 0-2.
 $F2D2 INC A         ; {Write #N$01-#N$08 to *#R$64C4.
 $F2D3 LD ($64C4),A  ; }
 $F2D6 JP $ECF2      ; Jump to #R$ECF2.
@label=Event_RandomCombination_Target
*$F2D9 CALL $F433    ; Call #R$F433.
 $F2DC AND %00000111 ; Keep only bits 0-2.
 $F2DE INC A         ; Increase #REGa by one.
 $F2DF RET           ; Return.

; Event: Reveal Door
;
; Used by the routine at #R$EDD9.
; .
; Event #N$12: reveal the first door.
@label=Event_RevealDoor
c$F2E0 LD IX,($6422)   ; #REGix=*#R$6422.
; This entry point is used by the routines at #R$F31D and #R$F328.
@label=Event_RevealDoor_Body
*$F2E4 BIT 7,(IX+$00)  ; {Return if this door is already visible.
 $F2E8 RET Z           ; }
 $F2E9 RES 7,(IX+$00)  ; Clear bit 7 of the door record.
 $F2ED HALT            ; Halt.
 $F2EE LD BC,$1006     ; {Write #N$1006 to *#R$6472.
 $F2F1 LD ($6472),BC   ; }
 $F2F5 LD C,(IX+$00)   ; {Fetch the column, row and colour; glyph #N$84.
 $F2F8 LD B,(IX+$01)   ;
 $F2FB LD L,(IX+$02)   ;
 $F2FE LD A,$84        ;
 $F300 LD DE,$0202     ; }
 $F303 LD IX,$648B     ; #REGix=#R$648B.
 $F307 CALL $F457      ; Call #R$F457.
 $F30A CALL $F333      ; Call #R$F333.
 $F30D LD A,(IX+$01)   ; {Store the drop row two cells below the door.
 $F310 LD (IX+$10),A   ;
 $F313 INC A           ;
 $F314 INC A           ;
 $F315 LD (IX+$01),A   ;
 $F318 LD (IX+$09),$FF ; }
 $F31C RET             ; Return.

