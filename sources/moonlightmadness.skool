; Event #N$1F: show every moving object.
@label=Event_ShowMovers
c$F217 LD IX,($642A)  ; #REGix=*#R$642A.
@label=Event_ShowMovers_Target
*$F21B LD A,(IX+$00)  ; {Return if the terminator #N$FF is reached.
 $F21E CP $FF         ;
 $F220 RET Z          ; }
 $F221 RES 7,(IX+$00) ; Clear bit 7 of this mover.
 $F225 LD DE,$0013    ; {#REGix+=#N($0013,$04,$04).
 $F228 ADD IX,DE      ; }
 $F22A JR $F21B       ; Jump to #R$F21B.

; Event: Hide Furniture
;
; Used by the routine at #R$EDD9.
; .
; Event #N$11: hide the first furniture item.
@label=Event_HideFurniture
c$F22C LD IX,($6420) ; #REGix=*#R$6420.
