; Event #N$1E: reveal three decorations.
@label=Event_RevealThreeDecorations
c$F1EE LD IX,($642E)  ; #REGix=*#R$642E.
 $F1F2 LD B,$03       ; #REGb=#N$03.
@label=Event_RevealThreeDecorations_Target
*$F1F4 PUSH BC        ; Stash the count on the stack.
 $F1F5 LD A,(IX+$00)  ; {Jump to #R$F20F if this decoration is hidden.
 $F1F8 BIT 7,A        ;
 $F1FA JR NZ,$F20F    ; }
 $F1FC LD C,(IX+$00)  ; {Fetch the column, row and size.
 $F1FF LD B,(IX+$01)  ;
 $F202 LD E,(IX+$04)  ;
 $F205 LD D,(IX+$05)  ; }
