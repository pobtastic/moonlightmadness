 $F1E0 LD IX,($642A)  ; {Clear bit 7 of *#R$642A+#N($0013,$04,$04).
 $F1E4 LD BC,$0013    ;
 $F1E7 ADD IX,BC      ;
 $F1E9 RES 7,(IX+$00) ; }
