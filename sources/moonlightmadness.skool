; Store Entity Position
;
; Used by the routine at #R$F424.
; .
; Remembers the previous position, then writes the new one.
@label=Store_EntityPosition
c$F466 LD A,(IX+$00) ; {Store the old column and write #REGc as the new column.
 $F469 LD (IX+$0A),A ;
 $F46C LD (IX+$00),C ; }
 $F46F LD A,(IX+$01) ; {Store the old row and write #REGb as the new row.
 $F472 LD (IX+$0B),A ;
 $F475 LD (IX+$01),B ; }
 $F478 LD A,(IX+$02) ; {Store the old fine-X and write #REGe as the new fine-X.
 $F47B LD (IX+$0C),A ;
 $F47E LD (IX+$02),E ; }
 $F481 LD A,(IX+$03) ; {Store the old fine-Y and write #REGd as the new fine-Y.
 $F484 LD (IX+$0D),A ;
 $F487 LD (IX+$03),D ; }
 $F48A RET           ; Return.

; Draw Box
;
; Used by the routine at #R$F463.
; .
; Draws a box of character #N$C8.
@label=Draw_Box
c$F48B CALL $FA6A    ; Call #R$FA6A.
 $F48E XOR A         ; {Return if the width is zero.
 $F48F CP E          ;
 $F490 RET Z         ; }
 $F491 CP D          ; {Return if the height is zero.
 $F492 RET Z         ; }
@label=Draw_Box_Target
*$F493 PUSH BC       ; Stash the print position on the stack.
 $F494 CALL $F5C4    ; Call #R$F5C4.
 $F497 LD B,E        ; Copy the remaining width into #REGb.
@label=Draw_Box_Target2
*$F498 LD A,$C8      ; {Print a #N$C8 tile.
 $F49A CALL $F60A    ; }
 $F49D CALL $F6C6    ; Call #R$F6C6.
 $F4A0 DJNZ $F498    ; Decrease the width and loop back to #R$F498 until
                     ; this row is drawn.
 $F4A2 POP BC        ; Restore the print position from the stack.
 $F4A3 DEC D         ; {Return if every row is drawn.
 $F4A4 RET Z         ; }
 $F4A5 DEC B         ; Move up one row.
 $F4A6 JR $F493      ; Jump to #R$F493.

; Draw Status Icons
;
; Used by the routine at #R$F427.
; .
; Draws one life icon for each remaining life, then a blank.
@label=Draw_StatusIcons
c$F4A8 CALL $F5C4    ; Call #R$F5C4.
 $F4AB LD A,($64B4)  ; {Jump to #R$F4B9 if *#R$64B4 is the last life.
 $F4AE DEC A         ;
 $F4AF JR Z,$F4B9    ; }
; #UDGTABLE
; { #GLYPH$E3,$07(glyph-e3) }
; UDGTABLE#
 $F4B1 LD B,A        ; {Set the remaining-life count and the #N$E3 icon.
 $F4B2 LD A,$E3      ; }
@label=Draw_StatusIcons_Target
*$F4B4 CALL $F60A    ; Call #R$F60A.
 $F4B7 DJNZ $F4B4    ; Decrease the life count and loop back to #R$F4B4
                     ; until all lives are drawn.
@label=Draw_StatusIcons_Skip
*$F4B9 LD A,$C8      ; #REGa=#N$C8.
 $F4BB JP $F60A      ; Jump to #R$F60A.
; View the equivalent code in #BOOTY$E064.

; Add Score
;
; Adds *#R$6417 into the score digits at #R$64B5(#N$64BA).
@label=Draw_StatusIcons_Target2
c$F4BE LD A,($6417)  ; {Return if *#R$6417 is zero.
 $F4C1 OR A          ;
 $F4C2 RET Z         ; }
 $F4C3 LD BC,($6417) ; {Point at the digit that matches the place value.
 $F4C7 XOR A         ;
 $F4C8 LD D,A        ;
 $F4C9 LD E,B        ;
 $F4CA LD HL,$64BF   ;
 $F4CD SBC HL,DE     ;
 $F4CF LD DE,$64BA   ;
 $F4D2 XOR A         ;
 $F4D3 EX DE,HL      ;
 $F4D4 SBC HL,DE     ;
 $F4D6 EX DE,HL      ; }
 $F4D7 JR NC,$F4F0   ; Jump to #R$F4F0 if that digit is already in range.
 $F4D9 LD A,C        ; {Add the low byte into the digit, wrapping at #N$0A.
 $F4DA ADD A,(HL)    ;
 $F4DB CP $0A        ;
 $F4DD LD (HL),A     ;
 $F4DE JR C,$F4F0    ; }
 $F4E0 SUB $0A       ; {Carry into the next place.
 $F4E2 LD (HL),A     ;
 $F4E3 LD BC,($6417) ;
 $F4E7 LD C,$01      ;
 $F4E9 INC B         ;
 $F4EA LD ($6417),BC ; }
 $F4EE JR $F4BE      ; Jump to #R$F4BE.

; Print Score
;
; Used by the routine at #R$F4BE.
; .
; Prints the score digits and copies a new high score when
; the stored score is lower.
@label=Draw_StatusIcons_Branch
c$F4F0 LD DE,$0000   ; {Write #N($0000,$04,$04) to *#R$6417.
 $F4F3 LD ($6417),DE ; }
 $F4F7 LD HL,$3C00   ; {Write #N$3C00 to *#SKOOLKID$5C36(CHARS).
 $F4FA LD ($5C36),HL ; }
 $F4FD LD A,$07      ; {Write #INK$07 to *#SKOOLKID$5C8F(ATTR_T).
 $F4FF LD ($5C8F),A  ; }
 $F502 LD BC,$041B   ; {Print the five digits at #R$64B5(#N$64BB).
 $F505 LD HL,$64BB   ;
 $F508 CALL $F535    ; }
 $F50B LD B,$05      ; {Compare those digits with #R$64B5.
 $F50D LD HL,$64BB   ;
 $F510 LD DE,$64B5   ; }
@label=Draw_StatusIcons_Target3
*$F513 LD A,(DE)     ; {Jump to #R$F51B if this pair matches.
 $F514 CP (HL)       ;
 $F515 JR Z,$F51B    ; }
 $F517 JR C,$F528    ; Jump to #R$F528 if the stored score is lower.
 $F519 JR $F51F      ; Jump to #R$F51F.
@label=Draw_StatusIcons_Skip2
*$F51B INC HL        ; {Advance both pointers and loop back to #R$F513.
 $F51C INC DE        ;
 $F51D DJNZ $F513    ; }
@label=Draw_StatusIcons_Target4
*$F51F LD BC,$0410   ; {Print the five digits at #R$64B5.
 $F522 LD HL,$64B5   ;
 $F525 JP $F535      ; }
@label=Draw_StatusIcons_Branch2
*$F528 LD DE,$64B5   ; {Copy the new score over the stored score.
 $F52B LD HL,$64BB   ;
 $F52E LD BC,$0005   ;
 $F531 LDIR          ; }
 $F533 JR $F51F      ; Jump to #R$F51F.
@label=Draw_StatusIcons_Target5
*$F535 CALL $F5C4    ; Call #R$F5C4.
 $F538 LD B,$05      ; #REGb=#N$05.
@label=Draw_StatusIcons_Target6
*$F53A LD A,(HL)     ; {Convert the digit into a character.
 $F53B ADD A,$0A     ; }
 $F53D CALL $F60A    ; Call #R$F60A.
 $F540 INC HL        ; {Advance the digit pointer and loop back to #R$F53A
 $F541 DJNZ $F53A    ; until all five digits are printed.}
 $F543 RET           ; Return.

; Print Message
;
; Used by the routine at #R$F460.
; .
; Prints a control-byte string: bytes below #N$C8 are characters, #N$D8
; sets #SKOOLKID$5C8F(ATTR_T), other values set the print position, and #N$FF
; terminates.
;
; HL Message address
@label=Print_Message
c$F544 LD A,(HL)     ; {Jump to #R$F55C if this byte is a character.
 $F545 CP $C8        ;
 $F547 JR C,$F55C    ; }
 $F549 CP $FF        ; {Return if the terminator is reached.
 $F54B RET Z         ; }
 $F54C CP $D8        ; {Jump to #R$F562 if this byte sets
 $F54E JR Z,$F562    ; #SKOOLKID$5C8F(ATTR_T).}
; Else this is a print-position pair.
 $F550 INC HL        ; {Fetch the column and row into #REGbc.
 $F551 LD A,(HL)     ;
 $F552 LD C,A        ;
 $F553 INC HL        ;
 $F554 LD A,(HL)     ;
 $F555 LD B,A        ; }
 $F556 CALL $F5C4    ; Call #R$F5C4.
 $F559 INC HL        ; Advance the message pointer.
 $F55A JR $F544      ; Jump to #R$F544.
@label=Print_Message_Branch
*$F55C CALL $F60A    ; Call #R$F60A.
 $F55F INC HL        ; Advance the message pointer.
 $F560 JR $F544      ; Jump to #R$F544.
@label=Print_Message_Skip
*$F562 INC HL        ; Advance the message pointer.
 $F563 LD A,(HL)     ; {Write the next byte to *#SKOOLKID$5C8F(ATTR_T).
 $F564 LD ($5C8F),A  ; }
 $F567 INC HL        ; Advance the message pointer.
 $F568 JR $F544      ; Jump to #R$F544.

; Initialise Display
;
; Used by the routine at #R$F42A.
; .
; Opens the upper screen, builds the line-address table and fills the IM
; #N$02 vector page at #N$FD00 with #N$FE.
@label=Initialise_Display
c$F56A LD A,$00      ; {Write #N$00 to *#SKOOLKID$5C6B(DF_SZ).
 $F56C LD ($5C6B),A  ; }
 $F56F LD A,$02      ; {Open channel #N$02 via #SKOOLKID$1601(CHAN_OPEN).
 $F571 CALL $1601    ; }
; Build #N$19 display-file addresses from #SKOOLKID$0DD9(CL_SET).
 $F574 LD HL,$FF04   ; #REGhl=#N$FF04.
 $F577 LD BC,$0121   ; #REGbc=#N$0121.
 $F57A PUSH HL       ; Stash the table pointer on the stack.
@label=Initialise_Display_Continue
*$F57B PUSH BC       ; Stash the position on the stack.
 $F57C CALL $0DD9    ; Call #SKOOLKID$0DD9(CL_SET).
 $F57F POP BC        ; {Fetch *#SKOOLKID$5C84(DF_CC) and add #N$21.
 $F580 LD DE,($5C84) ;
 $F584 LD HL,$0021   ;
 $F587 ADD HL,DE     ;
 $F588 EX DE,HL      ; }
 $F589 POP HL        ; {Store that address in the table.
 $F58A LD (HL),E     ;
 $F58B INC HL        ;
 $F58C LD (HL),D     ;
 $F58D INC HL        ;
 $F58E PUSH HL       ; }
 $F58F INC B         ; {Increase the row and jump to #R$F57B until #N$19
 $F590 LD A,B        ; rows are stored.
 $F591 CP $19        ;
 $F593 JR NZ,$F57B   ; }
 $F595 POP HL        ; Drop the leftover table pointer.
 $F596 LD BC,$0018   ; {Write the default clip window to *#R$6419.
 $F599 LD ($6419),BC ;
 $F59D LD BC,$0121   ;
 $F5A0 LD ($641B),BC ; }
 $F5A4 LD DE,$5CB7   ; {Clear seven bytes at #SKOOLKID$5CB6(UDG).
 $F5A7 LD HL,$5CB6   ;
 $F5AA LD BC,$0007   ;
 $F5AD LD (HL),$00   ;
 $F5AF LDIR          ; }
 $F5B1 LD HL,$643E   ; {Write #N$00 to *#R$643E.
 $F5B4 LD (HL),$00   ; }
 $F5B6 LD HL,$FD00   ; {Fill #N$0100 bytes at #N$FD00 with #N$FE.
 $F5B9 LD DE,$FD01   ;
 $F5BC LD BC,$0100   ;
 $F5BF LD (HL),$FE   ;
 $F5C1 LDIR          ; }
 $F5C3 RET           ; Return.
; View the equivalent code in #BOOTY$CD14.

; Set Print Position
;
; Used by the routines at #R$F42D, #R$F48B, #R$F4A8, #R$F4F0, #R$F544, #R$F7AA,
; #R$F8B4 and #R$FA9E.
; .
; Sets the print position from #REGbc.
@label=Set_PrintPosition
c$F5C4 LD ($5C88),BC ; Write #REGbc to *#SKOOLKID$5C88(S_POSN).
 $F5C8 EXX           ; Switch to the shadow registers.
 $F5C9 LD BC,($5C88) ; {Fetch the stored position and clear #REGa, #REGd and
 $F5CD LD E,B        ; #REGb.
 $F5CE XOR A         ;
 $F5CF LD D,A        ;
 $F5D0 LD B,A        ; }
 $F5D1 LD HL,$FF02   ; {Look up the line address from the table at #N$FF02.
 $F5D4 SLA E         ;
 $F5D6 ADD HL,DE     ; }
 $F5D7 LD E,(HL)     ; {Subtract the column and write *#SKOOLKID$5C84(DF_CC).
 $F5D8 INC HL        ;
 $F5D9 LD D,(HL)     ;
 $F5DA EX DE,HL      ;
 $F5DB SBC HL,BC     ;
 $F5DD LD ($5C84),HL ; }
 $F5E0 LD A,H        ; {Rotate the high byte into an attribute offset.
 $F5E1 RRCA          ;
 $F5E2 RRCA          ;
 $F5E3 RRCA          ; }
 $F5E4 AND %00000011 ; Keep only bits 0-1.
 $F5E6 LD H,A        ; {Write the offset to *#R$6412.
 $F5E7 LD ($6412),HL ; }
 $F5EA EXX           ; Switch back.
 $F5EB RET           ; Return.

; Delay
;
; Used by the routine at #R$F430.
; .
; Delay for #REGbc iterations.
;
; BC Length of loop
@label=Delay
c$F5EC PUSH BC       ; Stash #REGbc on the stack.
@label=Delay_Continue
*$F5ED DEC BC        ; {Decrease #REGbc and jump to #R$F5ED until it is
 $F5EE LD A,B        ; zero.
 $F5EF OR C          ;
 $F5F0 JR NZ,$F5ED   ; }
 $F5F2 POP BC        ; Restore #REGbc from the stack.
 $F5F3 RET           ; Return.
; View the equivalent code in #BOOTY$F8C0.

; Get Random Number
;
; Used by the routine at #R$F433.
; .
; (((#REGb + #REGc) % #N$100 + #N$AB) % #N$100) * #N$100 +
; (#REGc + #N$CD) % #N$100
;
; O:A The random number
@label=Get_RandomNumber
c$F5F4 PUSH BC       ; Stash #REGbc on the stack.
 $F5F5 LD BC,($64B2) ; #REGbc=*#R$64B2.
 $F5F9 LD A,C        ; {#REGb=#REGb+#REGc.
 $F5FA ADD A,B       ;
 $F5FB LD B,A        ; }
 $F5FC LD A,$CD      ; {#REGc=#N$CD+#REGc.
 $F5FE ADD A,C       ;
 $F5FF LD C,A        ; }
 $F600 LD A,$AB      ; {#REGb+=#N$AB.
 $F602 ADC A,B       ;
 $F603 LD B,A        ; }
 $F604 LD ($64B2),BC ; Write the updated #REGbc to *#R$64B2.
 $F608 POP BC        ; Restore #REGbc from the stack.
 $F609 RET           ; Return.
; View the equivalent code in #BOOTY$E349.

; Print Character
;
; Used by the routines at #R$F436, #R$F48B, #R$F4A8, #R$F4F0, #R$F544, #R$F7AA,
; #R$F8B4 and #R$FA9E.
; .
; Prints one character using *#SKOOLKID$5C36(CHARS).
;
; A Character to print
@label=Print_Character
c$F60A PUSH AF       ; {Stash the character and #REGix on the stack.
 $F60B PUSH IX       ; }
 $F60D EXX           ; Switch to the shadow registers.
 $F60E LD L,A        ; {#REGhl=the character code*#N$08.
 $F60F LD H,$00      ;
 $F611 ADD HL,HL     ;
 $F612 ADD HL,HL     ;
 $F613 ADD HL,HL     ; }
 $F614 LD DE,($5C36) ; {#REGhl=*#SKOOLKID$5C36(CHARS)+#REGhl.
 $F618 ADD HL,DE     ; }
 $F619 LD DE,($5C84) ; {Advance *#SKOOLKID$5C84(DF_CC) and leave #REGde on
 $F61D INC DE        ; the cell just claimed.
 $F61E LD ($5C84),DE ;
 $F622 DEC DE        ; }
; Copy the eight pixel rows into the screen buffer.
 $F623 LD B,$08      ; Set the pixel-row counter to #N$08.
@label=Print_Character_Target
*$F625 LD A,(HL)     ; {Copy one pixel row and move down one screen line.
 $F626 LD (DE),A     ;
 $F627 INC D         ;
 $F628 INC HL        ; }
 $F629 DJNZ $F625    ; Decrease the row counter and loop back to #R$F625
                     ; until all #N$08 rows are written.
; Write *#SKOOLKID$5C8F(ATTR_T) into the matching
; attribute cell.
 $F62B LD BC,($5C88) ; {Decrease the print column in *#SKOOLKID$5C88(S_POSN).
 $F62F DEC C         ;
 $F630 LD ($5C88),BC ; }
 $F634 EX DE,HL      ; {Point #REGhl at the matching attribute cell.
 $F635 DEC H         ;
 $F636 LD A,H        ;
 $F637 RRCA          ;
 $F638 RRCA          ;
 $F639 RRCA          ; }
 $F63A AND %00000011 ; Keep only bits 0-1 of the display-file high
                     ; byte.
 $F63C OR %01011000  ; Set the attribute-file bit.
 $F63E LD H,A        ; Merge the attribute-file high byte.
 $F63F LD A,($5C91)  ; {Jump to #R$F64E if *#SKOOLKID$5C91(MASK_T) is set.
 $F642 OR A          ;
 $F643 JR NZ,$F64E   ; }
 $F645 LD A,($5C8F)  ; {Write *#SKOOLKID$5C8F(ATTR_T) to that attribute
 $F648 LD (HL),A     ; cell.}
 $F649 EXX           ; Switch back.
 $F64A POP IX        ; {Restore #REGix and the character from the stack.
 $F64C POP AF        ; }
 $F64D RET           ; Return.
@label=Print_Character_Continue
*$F64E PUSH HL       ; {Merge the existing attribute through the mask.
 $F64F AND (HL)      ;
 $F650 LD (HL),A     ; }
 $F651 LD HL,$5C8F   ; {Keep the paper bits from *#SKOOLKID$5C8F(ATTR_T).
 $F654 LD A,($5C91)  ; }
 $F657 XOR %11111111 ; Invert the mask.
 $F659 AND (HL)      ; {Merge the ink bits and write the attribute.
 $F65A POP HL        ;
 $F65B OR (HL)       ;
 $F65C LD (HL),A     ; }
 $F65D EXX           ; Switch back.
 $F65E POP IX        ; {Restore #REGix and the character from the stack.
 $F660 POP AF        ; }
 $F661 RET           ; Return.
; View the equivalent code in #BOOTY$E6DC.

; Print Clipped
;
; Used by the routine at #R$F439.
; .
; Prints a clipped rectangular run of characters.
@label=Print_Clipped
c$F662 LD L,A        ; Keep the tile ID in #REGl.
 $F663 LD A,E        ; {Store the width in *#R$6416.
 $F664 LD ($6416),A  ; }
@label=Print_Clipped_Target
*$F667 LD A,($6416)  ; {Reload the remaining width from *#R$6416.
 $F66A LD E,A        ; }
 $F66B LD A,($6419)  ; {Jump to #R$F677 if this row is inside *#R$6419.
 $F66E CP B          ;
 $F66F JR NC,$F677   ; }
@label=Print_Clipped_Continue
*$F671 DEC D         ; {Skip down until the row is inside the clip window.
 $F672 RET Z         ;
 $F673 DEC B         ;
 $F674 CP B          ;
 $F675 JR NZ,$F671   ; }
@label=Print_Clipped_Branch
*$F677 LD A,($641A)  ; {Return if this row is below *#R$641A.
 $F67A CP B          ;
 $F67B RET NC        ; }
 $F67C LD A,($641C)  ; {Return if this column is past *#R$641C.
 $F67F CP C          ;
 $F680 RET NC        ; }
 $F681 PUSH BC       ; Stash the position on the stack.
 $F682 LD A,($641B)  ; {Jump to #R$F68F if this column is inside
 $F685 CP C          ; *#R$641B.
 $F686 JR NC,$F68F   ; }
@label=Print_Clipped_Branch2
*$F688 DEC E         ; {Skip left until the column is inside the clip
 $F689 JR Z,$F6A4    ; window.
 $F68B DEC C         ;
 $F68C CP C          ;
 $F68D JR C,$F688    ; }
@label=Print_Clipped_Branch3
*$F68F PUSH BC       ; {Copy #REGbc to the shadow registers (using the
 $F690 EXX           ; stack).
 $F691 POP BC        ; }
 $F692 CALL $F6AA    ; Call #R$F6AA.
 $F695 EXX           ; Switch back.
 $F696 LD A,L        ; #REGa=the tile ID.
 $F697 CALL $F6C6    ; Call #R$F6C6.
 $F69A DEC C         ; {Move left one column and loop back to #R$F68F
 $F69B LD A,($641C)  ; until the row is done.
 $F69E CP C          ;
 $F69F JR NC,$F6A4   ;
 $F6A1 DEC E         ;
 $F6A2 JR NZ,$F68F   ; }
@label=Print_Clipped_Skip
*$F6A4 POP BC        ; Restore the position from the stack.
 $F6A5 DEC D         ; {Return if the remaining height is zero.
 $F6A6 RET Z         ; }
 $F6A7 DEC B         ; Move up one row.
 $F6A8 JR $F667      ; Jump to #R$F667.

; Convert Coordinate
;
; Used by the routines at #R$F43C, #R$F662 and #R$FB2F.
; .
; Converts a column/row pair into an offset.
@label=Convert_Coordinate
c$F6AA XOR A         ; {Clear #REGa, #REGd and #REGl.
 $F6AB LD D,A        ;
 $F6AC LD L,A        ; }
 $F6AD LD A,$18      ; {#REGa=#N$18-#REGb.
 $F6AF SUB B         ; }
 $F6B0 SRL A         ; {Multiply the row by #N$20 into #REGhl.
 $F6B2 RR L          ;
 $F6B4 SRL A         ;
 $F6B6 RR L          ;
 $F6B8 SRL A         ;
 $F6BA RR L          ;
 $F6BC LD H,A        ; }
 $F6BD LD A,$21      ; {#REGe=#N$21-#REGc.
 $F6BF SUB C         ;
 $F6C0 LD E,A        ; }
 $F6C1 ADD HL,DE     ; {Add the column and write *#R$6412.
 $F6C2 LD ($6412),HL ; }
 $F6C5 RET           ; Return.
; View the equivalent code in #BOOTY$A86E.

; Write Tile
;
; Used by the routines at #R$F43F, #R$F48B, #R$F662 and #R$F7AA.
; .
; Writes one tile and its attribute into the room buffers.
@label=Write_Tile
c$F6C6 PUSH AF       ; {Stash the tile, #REGde and #REGhl on the stack.
 $F6C7 PUSH DE       ;
 $F6C8 PUSH HL       ; }
 $F6C9 LD HL,($6412) ; {Increase *#R$6412 by one.
 $F6CC INC HL        ;
 $F6CD LD ($6412),HL ; }
 $F6D0 LD DE,$5DCD   ; {Point #REGhl at that #R$5DCE cell.
 $F6D3 ADD HL,DE     ;
 $F6D4 LD (HL),A     ; }
 $F6D5 LD DE,$0320   ; {Point #REGhl at the matching #R$60EE cell.
 $F6D8 ADD HL,DE     ; }
 $F6D9 LD A,($5C8F)  ; {Write *#SKOOLKID$5C8F(ATTR_T) there.
 $F6DC LD (HL),A     ; }
 $F6DD POP HL        ; {Restore the stashed registers from the stack.
 $F6DE POP DE        ;
 $F6DF POP AF        ; }
 $F6E0 RET           ; Return.

; Move Entity
;
; Used by the routine at #R$F442.
; .
; Moves an entity and erases the vacated cells.
@label=Move_Entity
c$F6E1 XOR A         ; {Write #N$00 to *#R$643D.
 $F6E2 LD ($643D),A  ; }
 $F6E5 LD A,C        ; {Jump to #R$F6F7 if the column matches *#REGix+#N$0A.
 $F6E6 SUB (IX+$0A)  ;
 $F6E9 JR Z,$F6F7    ; }
 $F6EB CP $80        ; {Call #R$F71C when the column moved left.
 $F6ED PUSH AF       ;
 $F6EE CALL NC,$F71C ;
 $F6F1 POP AF        ; }
 $F6F2 CALL C,$F73C  ; {Call #R$F73C when the column moved right and jump
 $F6F5 JR $F702      ; to #R$F702.}
@label=Move_Entity_Skip
*$F6F7 LD A,E        ; {Jump to #R$F702 if the fine-X matches *#REGix+#N$0C.
 $F6F8 CP (IX+$0C)   ;
 $F6FB JR Z,$F702    ; }
 $F6FD CP $07        ; {Call #R$F73C when the fine-X wrapped to #N$07.
 $F6FF CALL Z,$F73C  ; }
@label=Move_Entity_Skip2
*$F702 LD A,B        ; {Jump to #R$F712 if the row matches *#REGix+#N$0B.
 $F703 SUB (IX+$0B)  ;
 $F706 JR Z,$F712    ; }
 $F708 CP $80        ; {Call #R$F788 when the row moved up.
 $F70A PUSH AF       ;
 $F70B CALL NC,$F788 ;
 $F70E POP AF        ; }
 $F70F JR C,$F761    ; {Jump to #R$F761 if the row moved down, else return.
 $F711 RET           ; }
@label=Move_Entity_Skip3
*$F712 LD A,D        ; {Return if the fine-Y matches *#REGix+#N$0D.
 $F713 CP (IX+$0D)   ;
 $F716 RET Z         ; }
 $F717 CP $07        ; {Jump to #R$F761 when the fine-Y wrapped to #N$07,
 $F719 JR Z,$F761    ; else return.
 $F71B RET           ; }
; Erase the left-hand column that has just been vacated.
@label=Move_Entity_Target
*$F71C PUSH BC       ; {Stash the new position and size.
 $F71D PUSH DE       ; }
 $F71E LD A,$FF      ; {Write #N$FF to *#R$643D.
 $F720 LD ($643D),A  ; }
 $F723 LD C,(IX+$0A) ; {Fill a one-column strip at the old column and row.
 $F726 LD B,(IX+$0B) ;
 $F729 LD D,(IX+$05) ;
 $F72C LD E,$01      ; }
 $F72E LD A,(IX+$0D) ; {Increase the height when the old fine-Y is not
 $F731 CP $07        ; #N$07.
 $F733 JR Z,$F736    ;
 $F735 INC D         ; }
@label=Move_Entity_Skip4
*$F736 CALL $FA9E    ; Call #R$FA9E.
 $F739 POP DE        ; {Restore the registers from the stack.
 $F73A POP BC        ; }
 $F73B RET           ; Return.
; Erase the right-hand column that has just been vacated.
@label=Move_Entity_Target2
*$F73C LD A,$01      ; {Write #N$01 to *#R$643D.
 $F73E LD ($643D),A  ; }
 $F741 PUSH BC       ; {Stash the new position and size.
 $F742 PUSH DE       ; }
 $F743 LD A,(IX+$0A) ; {Fill a one-column strip at the old right-hand edge.
 $F746 LD C,(IX+$04) ;
 $F749 SUB C         ;
 $F74A LD C,A        ;
 $F74B LD B,(IX+$0B) ;
 $F74E LD D,(IX+$05) ;
 $F751 LD E,$01      ; }
 $F753 LD A,(IX+$0D) ; {Increase the height when the old fine-Y is not
 $F756 CP $07        ; #N$07.
 $F758 JR Z,$F75B    ;
 $F75A INC D         ; }
@label=Move_Entity_Skip5
*$F75B CALL $FA9E    ; Call #R$FA9E.
 $F75E POP DE        ; {Restore the registers from the stack.
 $F75F POP BC        ; }
 $F760 RET           ; Return.
; Erase the bottom row that has just been vacated.
@label=Move_Entity_Branch
*$F761 PUSH BC       ; {Stash the new position and size.
 $F762 PUSH DE       ; }
 $F763 LD A,(IX+$0B) ; {Fill a one-row strip at the old bottom edge.
 $F766 LD D,(IX+$05) ;
 $F769 SUB D         ;
 $F76A LD B,A        ;
 $F76B LD E,(IX+$04) ;
 $F76E LD C,(IX+$0A) ;
 $F771 LD D,$01      ; }
 $F773 LD A,(IX+$02) ; {Increase the width when the fine-X is not #N$07.
 $F776 CP $07        ;
 $F778 JR Z,$F77B    ;
 $F77A INC E         ; }
@label=Move_Entity_Skip6
*$F77B LD A,($643D)  ; {Increase the width again when *#R$643D is set.
 $F77E OR A          ;
 $F77F JR Z,$F782    ;
 $F781 INC E         ; }
@label=Move_Entity_Skip7
*$F782 CALL $FA9E    ; Call #R$FA9E.
 $F785 POP DE        ; {Restore the registers from the stack.
 $F786 POP BC        ; }
 $F787 RET           ; Return.
; Erase the top row that has just been vacated.
@label=Move_Entity_Target3
*$F788 PUSH BC       ; {Stash the new position and size.
 $F789 PUSH DE       ; }
 $F78A LD C,(IX+$0A) ; {Fill a one-row strip at the old column and row.
 $F78D LD B,(IX+$0B) ;
 $F790 LD D,$01      ;
 $F792 LD E,(IX+$04) ; }
 $F795 LD A,(IX+$0C) ; {Increase the width when the old fine-X is not
 $F798 CP $07        ; #N$07.
 $F79A JR Z,$F79D    ;
 $F79C INC E         ; }
@label=Move_Entity_Skip8
*$F79D LD A,($643D)  ; {Increase the width again when *#R$643D is set.
 $F7A0 OR A          ;
 $F7A1 JR Z,$F7A4    ;
 $F7A3 INC E         ; }
@label=Move_Entity_Skip9
*$F7A4 CALL $FA9E    ; Call #R$FA9E.
 $F7A7 POP DE        ; {Restore the registers from the stack.
 $F7A8 POP BC        ; }
 $F7A9 RET           ; Return.

; Print Sprite
;
; Used by the routine at #R$F445.
; .
; Prints a sprite of width #REGe and height #REGd.
;
; A Sprite ID
; B Vertical co-ordinate
; C Horizontal co-ordinate
; D Height (in character blocks)
; E Width (in character blocks)
@label=Print_Sprite
c$F7AA LD L,A        ; {Keep the sprite ID minus one in #REGl.
 $F7AB DEC L         ; }
 $F7AC LD A,E        ; {Store the width in *#R$6416.
 $F7AD LD ($6416),A  ; }
@label=Print_Sprite_Target
*$F7B0 LD A,($6416)  ; {Reload the remaining width from *#R$6416.
 $F7B3 LD E,A        ; }
 $F7B4 LD A,($6419)  ; {Jump to #R$F7C8 if this row is inside *#R$6419.
 $F7B7 CP B          ;
 $F7B8 JR NC,$F7C8   ; }
@label=Print_Sprite_Continue
*$F7BA LD A,($6416)  ; {Skip down until the row is inside the clip window.
 $F7BD ADD A,L       ;
 $F7BE LD L,A        ;
 $F7BF DEC D         ;
 $F7C0 RET Z         ;
 $F7C1 DEC B         ;
 $F7C2 LD A,($6419)  ;
 $F7C5 CP B          ;
 $F7C6 JR NZ,$F7BA   ; }
@label=Print_Sprite_Branch
*$F7C8 LD A,($641A)  ; {Return if this row is below *#R$641A.
 $F7CB CP B          ;
 $F7CC RET NC        ; }
 $F7CD LD A,($641C)  ; {Return if this column is past *#R$641C.
 $F7D0 CP C          ;
 $F7D1 RET NC        ; }
 $F7D2 PUSH BC       ; {Jump to #R$F7E1 if this column is inside
 $F7D3 LD A,($641B)  ; *#R$641B.
 $F7D6 CP C          ;
 $F7D7 JR NC,$F7E1   ; }
@label=Print_Sprite_Branch2
*$F7D9 INC L         ; {Skip left until the column is inside the clip
 $F7DA DEC E         ; window.
 $F7DB JR Z,$F7F6    ;
 $F7DD DEC C         ;
 $F7DE CP C          ;
 $F7DF JR C,$F7D9    ; }
@label=Print_Sprite_Branch3
*$F7E1 CALL $F5C4    ; Call #R$F5C4.
 $F7E4 INC L         ; {Call #R$F60A with the next glyph.
 $F7E5 LD A,L        ;
 $F7E6 CALL $F60A    ; }
 $F7E9 CALL $F6C6    ; Call #R$F6C6.
 $F7EC DEC C         ; {Move left one column and loop back to #R$F7E1
 $F7ED LD A,($641C)  ; until the row is done.
 $F7F0 CP C          ;
 $F7F1 JR NC,$F7FC   ;
 $F7F3 DEC E         ;
 $F7F4 JR NZ,$F7E1   ; }
@label=Print_Sprite_Skip
*$F7F6 POP BC        ; Restore the position from the stack.
 $F7F7 DEC D         ; {Return if the remaining height is zero.
 $F7F8 RET Z         ; }
 $F7F9 DEC B         ; Move up one row.
 $F7FA JR $F7B0      ; Jump to #R$F7B0.
@label=Print_Sprite_Branch4
*$F7FC DEC E         ; {Jump to #R$F7F6 if the remaining width is zero.
 $F7FD JR Z,$F7F6    ; }
 $F7FF LD A,L        ; {Advance the glyph past the clipped cells.
 $F800 ADD A,E       ;
 $F801 LD L,A        ; }
 $F802 JR $F7F6      ; Jump to #R$F7F6.
; View the equivalent code in #BOOTY$EA93.

; Advance Entity
;
; Used by the routine at #R$F448.
; .
; Advances an entity by its stored deltas.
;
;   IX Entity data
; O:B Updated row
; O:C Updated column
; O:D Updated fine-Y
; O:E Updated fine-X
@label=Advance_Entity
c$F804 LD C,(IX+$00)  ; {#REGc=the column and #REGb=the row.
 $F807 LD B,(IX+$01)  ; }
 $F80A LD A,(IX+$08)  ; {Add *#REGix+#N$08 to the fine-X.
 $F80D ADD A,(IX+$02) ; }
 $F810 CP $08         ; {Jump to #R$F81D if the fine-X is still in range.
 $F812 JR C,$F81D     ; }
 $F814 CP $80         ; {Jump to #R$F81A if the entity moved left.
 $F816 JR NC,$F81A    ; }
 $F818 INC C          ; {Step the column two right, then...
 $F819 INC C          ; }
@label=Advance_Entity_Branch
*$F81A DEC C          ; ...one left.
 $F81B AND %00000111  ; Keep only bits 0-2.
@label=Advance_Entity_Branch2
*$F81D LD E,A         ; Store the fine-X.
 $F81E LD A,(IX+$09)  ; {Add *#REGix+#N$09 to the fine-Y.
 $F821 ADD A,(IX+$03) ; }
 $F824 CP $08         ; {Jump to #R$F831 if the fine-Y is still in range.
 $F826 JR C,$F831     ; }
 $F828 CP $80         ; {Jump to #R$F82E if the entity moved up.
 $F82A JR NC,$F82E    ; }
 $F82C INC B          ; {Step the row two down, then...
 $F82D INC B          ; }
@label=Advance_Entity_Branch3
*$F82E DEC B          ; ...one up.
 $F82F AND %00000111  ; Keep only bits 0-2.
@label=Advance_Entity_Branch4
*$F831 LD D,A         ; Store the fine-Y.
 $F832 RET            ; Return.
; View the equivalent code in #BOOTY$EEA6.

; Shift Sprite Left
;
; Used by the routine at #R$F8B4.
; .
; Draws a left-facing entity by shifting each tile left.
@label=Advance_Entity_Target
c$F833 AND %01111111  ; Keep only bits 0-6.
 $F835 LD ($5C8F),A   ; Write the colour to *#SKOOLKID$5C8F(ATTR_T).
 $F838 LD A,($F917)   ; {Add #N$08 to the shift count at #R$F916(#N$F917)
 $F83B ADD A,$08      ; and write it to #R$F86F(#N$F870).
 $F83D LD ($F870),A   ; }
 $F840 LD DE,($5C36)  ; #REGde=*#SKOOLKID$5C36(CHARS).
 $F844 LD HL,($F936)  ; {Copy the stored stride from #R$F935(#N$F936) into
 $F847 LD ($F88E),HL  ; the add at #R$F88D(#N$F88E).}
 $F84A XOR A          ; {Clear the self-modified OR at #R$F881.
 $F84B LD H,A         ;
 $F84C LD ($F881),A   ; }
 $F84F LD A,(IX+$06)  ; {Point #REGhl at the last source tile of this
 $F852 ADD A,(IX+$04) ; frame.
 $F855 DEC A          ;
 $F856 LD L,A         ;
 $F857 ADD HL,HL      ;
 $F858 ADD HL,HL      ;
 $F859 ADD HL,HL      ;
 $F85A ADD HL,DE      ; }
 $F85B LD E,(IX+$04)  ; {#REGde=the sprite width and height.
 $F85E LD D,(IX+$05)  ; }
 $F861 PUSH HL        ; {Copy #REGhl to #REGix (using the stack).
 $F862 POP IX         ; }
 $F864 LD HL,$5CBE    ; #REGhl=#N$5CBE.
@label=Advance_Entity_Continue
*$F867 PUSH IX        ; {Stash the source pointer and remaining size.
 $F869 PUSH DE        ; }
@label=Advance_Entity_Continue2
*$F86A PUSH IX        ; Stash the source pointer on the stack.
 $F86C LD B,$08       ; #REGb=#N$08.
@label=Advance_Entity_Target2
*$F86E PUSH BC        ; Stash the row count.
@label=Advance_Entity_ShiftCount
 $F86F LD B,$FF       ; #REGb=the shift count (self-modified).
 $F871 LD C,(IX+$00)  ; {Load the next source byte.
 $F874 XOR A          ;
 $F875 LD E,A         ; }
@label=Advance_Entity_Target3
*$F876 SLA C          ; {Shift one source bit into the overflow bytes.
 $F878 RR A           ;
 $F87A RR E           ;
 $F87C DJNZ $F876     ; }
 $F87E LD (IY+$00),E  ; Write the overflow bits to the next column.
@label=Advance_Entity_Merge
 $F881 NOP            ; Self-modified: NOP or OR (HL).
 $F882 LD (HL),A      ; Write the rotated byte.
 $F883 INC HL         ; {Advance the destination and source pointers.
 $F884 INC IX         ;
 $F886 INC IY         ; }
 $F888 POP BC         ; Restore the row count from the stack.
 $F889 DJNZ $F86E     ; Decrease the count and loop back to #R$F86E.
 $F88B POP IX         ; Restore the source pointer from the stack.
@label=Advance_Entity_Stride
 $F88D LD BC,$0000    ; #REGbc=the stored stride (self-modified).
 $F890 ADD IX,BC      ; {Advance to the next source column and loop back
 $F892 DEC D          ; to #R$F86A.
 $F893 JR NZ,$F86A    ; }
 $F895 LD A,$B6       ; {Write OR (HL) into *#R$F881.
 $F897 LD ($F881),A   ; }
 $F89A XOR A          ; #REGa=#N$00.
 $F89B LD B,$08       ; #REGb=#N$08.
@label=Advance_Entity_Target4
*$F89D LD (HL),A      ; {Clear one overflow byte and loop back to #R$F89D.
 $F89E LD (IY+$00),A  ;
 $F8A1 INC HL         ;
 $F8A2 INC IY         ;
 $F8A4 DJNZ $F89D     ; }
 $F8A6 POP DE         ; {Step back one source character and loop back to
 $F8A7 POP IX         ; #R$F867, then jump to #R$F959.
 $F8A9 LD BC,$FFF8    ;
 $F8AC ADD IX,BC      ;
 $F8AE DEC E          ;
 $F8AF JR NZ,$F867    ;
 $F8B1 JP $F959       ; }

; Draw Entity
;
; Used by the routine at #R$F44B.
; .
; Draws the entity pointed to by #REGix.
;
; IX Entity data
@label=Draw_Entity
c$F8B4 XOR A         ; {Clear the self-modified OR at #R$F929.
 $F8B5 LD ($F929),A  ; }
 $F8B8 LD H,A        ; {Stash *#SKOOLKID$5C36(CHARS) on the stack.
 $F8B9 LD DE,($5C36) ;
 $F8BD PUSH DE       ; }
 $F8BE PUSH IY       ; {Stash #REGiy and #REGix on the stack.
 $F8C0 PUSH IX       ; }
 $F8C2 LD A,$07      ; {Write #N$07-*#REGix+#N$02 to the shift count at
 $F8C4 SUB (IX+$02)  ; #R$F916(#N$F917).
 $F8C7 LD ($F917),A  ; }
 $F8CA LD E,(IX+$04) ; {#REGde=the sprite width and height.
 $F8CD LD D,(IX+$05) ; }
 $F8D0 LD C,D        ; {#REGiy=#N$5CBE+(height+#N$01)*#N$08.
 $F8D1 INC C         ;
 $F8D2 SLA C         ;
 $F8D4 SLA C         ;
 $F8D6 SLA C         ;
 $F8D8 LD B,$00      ;
 $F8DA LD IY,$5CBE   ;
 $F8DE ADD IY,BC     ; }
 $F8E0 LD A,E        ; {Write the width*#N$08 to the stride at
 $F8E1 SLA A         ; #R$F935(#N$F936).
 $F8E3 SLA A         ;
 $F8E5 SLA A         ;
 $F8E7 LD ($F936),A  ; }
 $F8EA LD A,(IX+$07) ; {Jump to #R$F833 if bit 7 of the colour is set.
 $F8ED BIT 7,A       ;
 $F8EF JP NZ,$F833   ; }
 $F8F2 LD ($5C8F),A  ; Write the colour to *#SKOOLKID$5C8F(ATTR_T).
 $F8F5 LD DE,($5C36) ; #REGde=*#SKOOLKID$5C36(CHARS).
 $F8F9 LD L,(IX+$06) ; {Point #REGhl at this frame's source UDGs.
 $F8FC LD H,$00      ;
 $F8FE ADD HL,HL     ;
 $F8FF ADD HL,HL     ;
 $F900 ADD HL,HL     ;
 $F901 ADD HL,DE     ; }
 $F902 LD D,(IX+$05) ; {#REGde=the sprite width and height.
 $F905 LD E,(IX+$04) ; }
 $F908 PUSH HL       ; {Copy #REGhl to #REGix (using the stack).
 $F909 POP IX        ; }
 $F90B LD HL,$5CBE   ; #REGhl=#N$5CBE.
@label=Draw_Entity_Continue
*$F90E PUSH IX       ; {Stash the source pointer and remaining size.
 $F910 PUSH DE       ; }
@label=Draw_Entity_Continue2
*$F911 PUSH IX       ; Stash the source pointer on the stack.
 $F913 LD B,$08      ; #REGb=#N$08.
@label=Draw_Entity_Target
*$F915 PUSH BC       ; Stash the row count.
@label=Draw_Entity_ShiftCount
 $F916 LD B,$FF      ; #REGb=the shift count (self-modified).
 $F918 XOR A         ; #REGa=#N$00.
 $F919 CP B          ; Test the shift count.
 $F91A LD C,A        ; #REGc=#N$00.
 $F91B LD A,(IX+$00) ; #REGa=the next source byte.
 $F91E JR Z,$F926    ; Jump to #R$F926 if the shift count is zero.
@label=Draw_Entity_Target2
*$F920 SRL A         ; {Shift one source bit into the overflow byte.
 $F922 RR C          ;
 $F924 DJNZ $F920    ; }
@label=Draw_Entity_Skip
*$F926 LD (IY+$00),C ; Write the overflow bits to the next column.
@label=Draw_Entity_Merge
 $F929 NOP           ; Self-modified: NOP or OR (HL).
 $F92A LD (HL),A     ; Write the rotated byte.
 $F92B INC HL        ; {Advance the destination and source pointers.
 $F92C INC IX        ;
 $F92E INC IY        ; }
 $F930 POP BC        ; Restore the row count from the stack.
 $F931 DJNZ $F915    ; Decrease the count and loop back to #R$F915.
 $F933 POP IX        ; Restore the source pointer from the stack.
@label=Draw_Entity_Stride
 $F935 LD BC,$0000   ; #REGbc=the stored stride (self-modified).
 $F938 ADD IX,BC     ; {Advance to the next source column and loop back
 $F93A DEC D         ; to #R$F911.
 $F93B JR NZ,$F911   ; }
 $F93D LD A,$B6      ; {Write OR (HL) into *#R$F929.
 $F93F LD ($F929),A  ; }
 $F942 XOR A         ; #REGa=#N$00.
 $F943 LD B,$08      ; #REGb=#N$08.
@label=Draw_Entity_Target3
*$F945 LD (HL),A     ; {Clear one overflow byte and loop back to #R$F945.
 $F946 LD (IY+$00),A ;
 $F949 INC HL        ;
 $F94A INC IY        ;
 $F94C DJNZ $F945    ; }
 $F94E POP DE        ; {Step to the next source character and loop back
 $F94F POP IX        ; to #R$F90E.
 $F951 LD BC,$0008   ;
 $F954 ADD IX,BC     ;
 $F956 DEC E         ;
 $F957 JR NZ,$F90E   ; }
; This entry point is used by the routine at #R$F833.
@label=Draw_Entity_Target4
*$F959 LD HL,$5BB6   ; {Point *#SKOOLKID$5C36(CHARS) at the shifted
 $F95C POP IX        ; workspace plus the fine-Y.
 $F95E LD E,(IX+$03) ;
 $F961 INC E         ;
 $F962 LD D,A        ;
 $F963 ADD HL,DE     ;
 $F964 LD ($5C36),HL ; }
 $F967 LD D,(IX+$05) ; {Increase the printed width when the fine-X is not
 $F96A LD A,(IX+$02) ; #N$07.
 $F96D CP $07        ;
 $F96F LD E,(IX+$04) ;
 $F972 JR Z,$F975    ;
 $F974 INC E         ; }
@label=Draw_Entity_Skip2
*$F975 INC D         ; {Store the printed height in *#R$6414.
 $F976 LD A,D        ;
 $F977 LD ($6414),A  ; }
 $F97A LD A,$07      ; {Decrease the height when the fine-Y is #N$07.
 $F97C CP (IX+$03)   ;
 $F97F JR NZ,$F982   ;
 $F981 DEC D         ; }
@label=Draw_Entity_Continue3
*$F982 LD B,(IX+$01) ; {Call #R$F992 at the entity column and row.
 $F985 LD C,(IX+$00) ;
 $F988 POP IY        ;
 $F98A CALL $F992    ; }
 $F98D POP HL        ; Restore *#SKOOLKID$5C36(CHARS) from the stack.
 $F98E LD ($5C36),HL ; Write it back to *#SKOOLKID$5C36(CHARS).
 $F991 RET           ; Return.
; Print the shifted sprite inside the clip window.
@label=Draw_Entity_Target5
*$F992 LD L,$1F      ; {Write the remaining width into the load at
 $F994 LD A,E        ; #R$F999(#N$F99A).
 $F995 LD ($F99A),A  ; }
@label=Draw_Entity_Target6
*$F998 INC L         ; Advance the glyph base.
@label=Draw_Entity_Width
 $F999 LD E,$00      ; #REGe=the remaining width (self-modified).
 $F99B LD A,($6419)  ; {Jump to #R$F9AA if this row is inside *#R$6419.
 $F99E CP B          ;
 $F99F JR NC,$F9AA   ; }
@label=Draw_Entity_Target7
*$F9A1 DEC D         ; {Skip down until the row is inside the clip window.
 $F9A2 RET Z         ;
 $F9A3 INC L         ;
 $F9A4 DEC B         ;
 $F9A5 CP B          ;
 $F9A6 JR NC,$F9AA   ;
 $F9A8 JR $F9A1      ; }
@label=Draw_Entity_Branch
*$F9AA LD A,($641C)  ; {Return if this column is past *#R$641C.
 $F9AD CP C          ;
 $F9AE RET NC        ; }
 $F9AF LD A,($641A)  ; {Return if this row is below *#R$641A.
 $F9B2 CP B          ;
 $F9B3 RET NC        ; }
 $F9B4 PUSH BC       ; {Jump to #R$F9D1 if this column is inside
 $F9B5 LD A,($641B)  ; *#R$641B.
 $F9B8 CP C          ;
 $F9B9 JR NC,$F9D1   ; }
 $F9BB LD H,L        ; Copy the glyph base into #REGh.
@label=Draw_Entity_Branch2
*$F9BC DEC E         ; {Jump to #R$F9E8 if the remaining width is zero.
 $F9BD JR Z,$F9E8    ; }
 $F9BF LD A,($6414)  ; {Skip left until the column is inside the clip
 $F9C2 ADD A,H       ; window.
 $F9C3 LD H,A        ;
 $F9C4 DEC C         ;
 $F9C5 LD A,($641B)  ;
 $F9C8 CP C          ;
 $F9C9 JR C,$F9BC    ; }
 $F9CB CALL $F5C4    ; Call #R$F5C4.
 $F9CE LD A,H        ; #REGa=the clipped glyph.
 $F9CF JR $F9D5      ; Jump to #R$F9D5.
@label=Draw_Entity_Branch3
*$F9D1 CALL $F5C4    ; {Call #R$F5C4 with the unclipped glyph.
 $F9D4 LD A,L        ; }
@label=Draw_Entity_Continue4
*$F9D5 CALL $F60A    ; {Call #R$F60A and keep the glyph in #REGh.
 $F9D8 LD H,A        ; }
 $F9D9 DEC C         ; {Jump to #R$F9E8 if this column is past *#R$641C.
 $F9DA LD A,($641C)  ;
 $F9DD CP C          ;
 $F9DE JP NC,$F9E8   ; }
 $F9E1 LD A,($6414)  ; {Advance the glyph and loop back to #R$F9D5.
 $F9E4 ADD A,H       ;
 $F9E5 DEC E         ;
 $F9E6 JR NZ,$F9D5   ; }
@label=Draw_Entity_Skip3
*$F9E8 POP BC        ; Restore the position from the stack.
 $F9E9 DEC D         ; {Return if the remaining height is zero.
 $F9EA RET Z         ; }
 $F9EB DEC B         ; Move up one row.
 $F9EC JR $F998      ; Jump to #R$F998.
; View the equivalent code in #BOOTY$EED7.

; Erase Entity
;
; Used by the routine at #R$F44E.
; .
; Tests whether the entity overlaps the player.
@label=Erase_Entity
c$F9EE LD A,($6411)   ; {Return if *#R$6411 is already set.
 $F9F1 OR A           ;
 $F9F2 RET NZ         ; }
 $F9F3 LD C,(IX+$00)  ; {Fetch the column, row, width and height.
 $F9F6 LD B,(IX+$01)  ;
 $F9F9 LD E,(IX+$04)  ;
 $F9FC LD D,(IX+$05)  ; }
 $F9FF CALL $FA6A     ; Call #R$FA6A.
 $FA02 XOR A          ; {Return if the clipped width or height is zero.
 $FA03 CP E           ;
 $FA04 RET Z          ;
 $FA05 CP D           ;
 $FA06 RET Z          ; }
 $FA07 LD L,E         ; {Write the width*#N$08+#N$10 into the compare at
 $FA08 LD H,D         ; #R$FA34(#N$FA35).
 $FA09 ADD HL,HL      ;
 $FA0A ADD HL,HL      ;
 $FA0B ADD HL,HL      ;
 $FA0C LD A,$10       ;
 $FA0E ADD A,L        ;
 $FA0F LD ($FA35),A   ; }
 $FA12 LD A,$18       ; {Write the height*#N$08+#N$18 into the compare at
 $FA14 ADD A,H        ; #R$FA4E(#N$FA4F).
 $FA15 LD ($FA4F),A   ; }
 $FA18 PUSH IY        ; {Point #REGiy at the player at #R$64A4.
 $FA1A LD IY,$64A4    ; }
 $FA1E LD A,C         ; {Jump to #R$FA57 unless the entity overlaps the
 $FA1F ADD A,A        ; player horizontally.
 $FA20 ADD A,A        ;
 $FA21 ADD A,A        ;
 $FA22 ADD A,(IX+$02) ;
 $FA25 LD C,A         ;
 $FA26 LD A,(IY+$00)  ;
 $FA29 ADD A,A        ;
 $FA2A ADD A,A        ;
 $FA2B ADD A,A        ;
 $FA2C ADD A,(IY+$02) ;
 $FA2F CP C           ;
 $FA30 SBC A,$00      ;
 $FA32 ADD A,L        ;
 $FA33 SUB C          ; }
@label=Erase_Entity_WidthCompare
 $FA34 CP $00         ; {Compare against the stored width and jump to
 $FA36 JR NC,$FA57    ; #R$FA57 if there is no overlap.}
 $FA38 LD A,B         ; {Jump to #R$FA57 unless the entity overlaps the
 $FA39 ADD A,A        ; player vertically.
 $FA3A ADD A,A        ;
 $FA3B ADD A,A        ;
 $FA3C ADD A,(IX+$03) ;
 $FA3F LD C,A         ;
 $FA40 LD A,(IY+$01)  ;
 $FA43 ADD A,A        ;
 $FA44 ADD A,A        ;
 $FA45 ADD A,A        ;
 $FA46 ADD A,(IY+$03) ;
 $FA49 CP C           ;
 $FA4A SBC A,$00      ;
 $FA4C ADD A,H        ;
 $FA4D SUB C          ; }
@label=Erase_Entity_HeightCompare
 $FA4E CP $00         ; {Compare against the stored height and jump to
 $FA50 JR NC,$FA57    ; #R$FA57 if there is no overlap.}
 $FA52 LD A,$01       ; {Write #N$01 to *#R$6411.
 $FA54 LD ($6411),A   ; }
@label=Erase_Entity_Branch
*$FA57 POP IY         ; Restore #REGiy from the stack.
 $FA59 RET            ; Return.

; Fill Attributes
;
; Used by the routines at #R$F454 and #R$FB2F.
; .
; Fills attributes starting at #REGhl.
;
; A Attribute to write
; HL Attribute-file address
; B Height
; C Width
@label=Fill_Attributes
c$FA5A PUSH BC       ; {Stash #REGbc and #REGhl and copy the width into
 $FA5B PUSH HL       ; #REGb.
 $FA5C LD B,C        ; }
@label=Fill_Attributes_Target
*$FA5D LD (HL),A     ; {Write #REGa across this attribute row.
 $FA5E INC HL        ;
 $FA5F DJNZ $FA5D    ; }
 $FA61 POP HL        ; {Move #REGhl down one attribute row and loop back
 $FA62 LD DE,$0020   ; to #R$FA5A.
 $FA65 ADD HL,DE     ;
 $FA66 POP BC        ;
 $FA67 DJNZ $FA5A    ; }
 $FA69 RET           ; Return.

; Clip Rectangle
;
; Used by the routines at #R$F48B, #R$F9EE, #R$FA9E and #R$FB2F.
; .
; Clips the print rectangle against *#R$6419.
@label=Next_PrintCell
c$FA6A LD A,($6419)  ; {Jump to #R$FA76 if this row is inside *#R$6419.
 $FA6D CP B          ;
 $FA6E JR NC,$FA76   ; }
@label=Next_PrintCell_Continue
*$FA70 DEC D         ; {Skip down until the row is inside the clip window.
 $FA71 RET Z         ;
 $FA72 DEC B         ;
 $FA73 CP B          ;
 $FA74 JR NZ,$FA70   ; }
@label=Next_PrintCell_Branch
*$FA76 LD A,B        ; {#REGl=the bottom row of this rectangle.
 $FA77 SUB D         ;
 $FA78 INC A         ;
 $FA79 LD L,A        ;
 $FA7A LD A,($641A)  ; }
@label=Next_PrintCell_Target
*$FA7D CP L          ; {Shrink the height until the bottom is inside
 $FA7E JR C,$FA85    ; *#R$641A.
 $FA80 INC L         ;
 $FA81 DEC D         ;
 $FA82 RET Z         ;
 $FA83 JR $FA7D      ; }
@label=Next_PrintCell_Branch2
*$FA85 LD A,($641B)  ; #REGa=*#R$641B.
@label=Next_PrintCell_Target2
*$FA88 CP C          ; {Skip left until the column is inside *#R$641B.
 $FA89 JR NC,$FA90   ;
 $FA8B DEC E         ;
 $FA8C RET Z         ;
 $FA8D DEC C         ;
 $FA8E JR $FA88      ; }
@label=Next_PrintCell_Branch3
*$FA90 LD A,C        ; {#REGl=the right-hand column of this rectangle.
 $FA91 SUB E         ;
 $FA92 INC A         ;
 $FA93 LD L,A        ;
 $FA94 LD A,($641C)  ; }
@label=Next_PrintCell_Target3
*$FA97 CP L          ; {Shrink the width until the right edge is inside
 $FA98 RET C         ; *#R$641C.
 $FA99 INC L         ;
 $FA9A DEC E         ;
 $FA9B RET Z         ;
 $FA9C JR $FA97      ; }

; Fill Tiles
;
; Used by the routines at #R$F451 and #R$F6E1.
; .
; Fills a rectangle of tiles from the room buffers.
@label=Fill_Tiles
c$FA9E PUSH AF       ; {Stash #REGaf, #REGbc, #REGde and #REGhl.
 $FA9F PUSH BC       ;
 $FAA0 PUSH DE       ;
 $FAA1 PUSH HL       ; }
 $FAA2 LD HL,($5C36) ; {Switch *#SKOOLKID$5C36(CHARS) to *#R$640E.
 $FAA5 PUSH HL       ;
 $FAA6 LD HL,($640E) ;
 $FAA9 LD ($5C36),HL ; }
; Clip the fill rectangle.
 $FAAC LD A,E        ; {Store the width in *#R$6416.
 $FAAD LD ($6416),A  ; }
 $FAB0 CALL $FA6A    ; Call #R$FA6A.
 $FAB3 XOR A         ; {Jump to #R$FAF5 if the clipped size is zero.
 $FAB4 CP E          ;
 $FAB5 JP Z,$FAF5    ;
 $FAB8 CP D          ;
 $FAB9 JP Z,$FAF5    ; }
 $FABC LD A,C        ; {Store the starting column in *#R$6414(#N$6415).
 $FABD LD ($6415),A  ; }
@label=Fill_Tiles_Target
*$FAC0 LD A,($6416)  ; {#REGe=*#R$6416.
 $FAC3 LD E,A        ; }
 $FAC4 LD A,($6415)  ; {#REGc=*#R$6414(#N$6415).
 $FAC7 LD C,A        ; }
 $FAC8 CALL $F5C4    ; Call #R$F5C4.
@label=Fill_Tiles_Continue
*$FACB PUSH BC       ; {Advance *#R$6412 and point #REGhl at that
 $FACC LD HL,($6412) ; #R$5DCE tile.
 $FACF INC HL        ;
 $FAD0 LD ($6412),HL ;
 $FAD3 LD BC,$5DCD   ;
 $FAD6 ADD HL,BC     ;
 $FAD7 LD A,(HL)     ; }
 $FAD8 CALL $F60A    ; Call #R$F60A with the stored tile.
 $FADB LD BC,$0320   ; {Copy the matching #R$60EE attribute to the
 $FADE ADD HL,BC     ; screen.
 $FADF LD A,(HL)     ;
 $FAE0 LD BC,$57FF   ;
 $FAE3 LD HL,($6412) ;
 $FAE6 ADD HL,BC     ;
 $FAE7 LD (HL),A     ; }
 $FAE8 POP BC        ; {Move left one column and loop back to #R$FACB.
 $FAE9 DEC C         ;
 $FAEA DEC E         ;
 $FAEB JR NZ,$FACB   ; }
 $FAED DEC D         ; Decrease the remaining height.
 $FAEE JR Z,$FAF5    ; Jump to #R$FAF5 if it is zero.
 $FAF0 PUSH DE       ; {Copy #REGde to #REGde (using the stack).
 $FAF1 POP DE        ; }
 $FAF2 DEC B         ; Move up one row.
 $FAF3 JR $FAC0      ; Jump to #R$FAC0.
@label=Fill_Tiles_Skip
*$FAF5 POP HL        ; Restore *#SKOOLKID$5C36(CHARS) from the stack.
 $FAF6 LD ($5C36),HL ; Write it back to *#SKOOLKID$5C36(CHARS).
 $FAF9 POP HL        ; {Restore the stashed registers from the stack.
 $FAFA POP DE        ;
 $FAFB POP BC        ;
 $FAFC POP AF        ; }
 $FAFD RET           ; Return.

; Spawn Entity
;
; Used by the routine at #R$F457.
; .
; Spawns or resets the entity at #REGix.
;
; IX Entity data
; B Row
; C Column
; D Height
; E Width
; A Sprite ID
; L Colour
@label=Spawn_Entity
c$FAFE LD (IX+$00),C   ; {Write the column and row into the current and
 $FB01 LD (IX+$01),B   ; stored slots.
 $FB04 LD (IX+$0A),C   ;
 $FB07 LD (IX+$0B),B   ; }
 $FB0A LD (IX+$04),E   ; {Write the width, height and sprite ID.
 $FB0D LD (IX+$05),D   ;
 $FB10 LD (IX+$06),A   ; }
 $FB13 LD (IX+$07),L   ; Write the colour.
 $FB16 LD (IX+$02),$07 ; {Write #N$07 as both fine offsets.
 $FB1A LD (IX+$03),$07 ;
 $FB1E LD (IX+$0C),$07 ;
 $FB22 LD (IX+$0D),$07 ; }
 $FB26 LD (IX+$08),$00 ; {Clear the movement deltas.
 $FB2A LD (IX+$09),$00 ; }
 $FB2E RET             ; Return.

; Draw Actor
;
; Used by the routine at #R$F45A.
; .
; Draws the actor pointed to by #REGix.
;
; IX Actor data
@label=Draw_Actor
c$FB2F LD A,$FF      ; {Write #N$FF to the mask at #R$FBC4(#N$FBC5).
 $FB31 LD ($FBC5),A  ; }
 $FB34 LD C,(IX+$00) ; {Fetch the column, row and width; height #N$01.
 $FB37 LD B,(IX+$01) ;
 $FB3A LD E,(IX+$04) ;
 $FB3D LD D,$01      ; }
 $FB3F LD A,(IX+$02) ; {Increase the width when the fine-X is not #N$07.
 $FB42 CP $07        ;
 $FB44 JR Z,$FB47    ;
 $FB46 INC E         ; }
@label=Draw_Actor_Skip
*$FB47 LD A,(IX+$03) ; {Increase the height when the fine-Y is below
 $FB4A CP $03        ; #N$03.
 $FB4C JR NC,$FB4F   ;
 $FB4E INC D         ; }
@label=Draw_Actor_Branch
*$FB4F CALL $FA6A    ; Call #R$FA6A.
 $FB52 XOR A         ; {Jump to #R$FB68 if the clipped size is zero.
 $FB53 CP E          ;
 $FB54 JR Z,$FB68    ;
 $FB56 CP D          ;
 $FB57 JR Z,$FB68    ; }
 $FB59 PUSH DE       ; {Call #R$FA5A with the actor colour at that
 $FB5A CALL $F6AA    ; attribute cell.
 $FB5D LD DE,$5800   ;
 $FB60 ADD HL,DE     ;
 $FB61 LD A,(IX+$07) ;
 $FB64 POP BC        ;
 $FB65 CALL $FA5A    ; }
@label=Draw_Actor_Skip2
*$FB68 LD HL,$6440   ; {Fill #R$6440 with #N$FF for the actor width.
 $FB6B LD DE,$6441   ;
 $FB6E LD (HL),$FF   ;
 $FB70 LD C,(IX+$04) ;
 $FB73 LD B,$00      ;
 $FB75 LDIR          ; }
 $FB77 XOR A         ; {Write #N$00 after the mask and load the fine-X.
 $FB78 LD (HL),A     ;
 $FB79 LD B,(IX+$02) ;
 $FB7C INC B         ; }
@label=Draw_Actor_Target
*$FB7D SCF           ; {Build a left-hand mask of (fine-X+#N$01) bits.
 $FB7E RLA           ;
 $FB7F DJNZ $FB7D    ; }
; Write the mask to both ends of #R$6440.
 $FB81 LD DE,$6440   ; {Write the mask to *#R$6440.
 $FB84 LD (DE),A     ; }
 $FB85 LD L,(IX+$04) ; {Point #REGhl at the other end of #R$6440.
 $FB88 LD H,$00      ;
 $FB8A ADD HL,DE     ; }
 $FB8B XOR %11111111 ; Invert the mask.
 $FB8D LD (HL),A     ; Write it.
 $FB8E JR $FB94      ; Jump to #R$FB94.

; Update Actor
;
; Used by the routine at #R$F45D.
; .
; Stamps the actor mask onto the display file.
;
; IX Actor data
@label=Update_Actor
c$FB90 XOR A          ; {Write #N$00 to the mask at #R$FBC4(#N$FBC5).
 $FB91 LD ($FBC5),A   ; }
; This entry point is used by the routine at #R$FB2F.
@label=Update_Actor_Target
*$FB94 LD A,$21       ; {Convert the actor column and row into a pixel
 $FB96 SUB (IX+$00)   ; address.
 $FB99 ADD A,A        ;
 $FB9A ADD A,A        ;
 $FB9B ADD A,A        ;
 $FB9C LD C,A         ;
 $FB9D LD A,(IX+$01)  ;
 $FBA0 SUB $03        ;
 $FBA2 ADD A,A        ;
 $FBA3 ADD A,A        ;
 $FBA4 ADD A,A        ;
 $FBA5 ADD A,(IX+$03) ;
 $FBA8 LD B,A         ; }
 $FBA9 LD E,$04       ; #REGe=#N$04.
@label=Update_Actor_Continue
*$FBAB PUSH BC        ; {Jump to #R$FBCB if this pixel row is off-screen.
 $FBAC PUSH DE        ;
 $FBAD LD A,B         ;
 $FBAE CP $B0         ;
 $FBB0 JR NC,$FBCB    ; }
 $FBB2 CALL $22AA     ; Call #SKOOLKID$22AA(PIXEL_ADD).
 $FBB5 LD B,(IX+$04)  ; {Increase the copy width when the fine-X is not
 $FBB8 LD A,(IX+$02)  ; #N$07.
 $FBBB CP $07         ;
 $FBBD JR Z,$FBC0     ;
 $FBBF INC B          ; }
@label=Update_Actor_Skip
*$FBC0 LD DE,$6440    ; #REGde=#R$6440.
@label=Update_Actor_Target2
*$FBC3 LD A,(DE)      ; #REGa=*#REGde.
@label=Update_Actor_Mask
 $FBC4 AND $FF        ; Merge the mask (self-modified AND).
 $FBC6 LD (HL),A      ; {Write the byte and loop back to #R$FBC3.
 $FBC7 INC HL         ;
 $FBC8 INC DE         ;
 $FBC9 DJNZ $FBC3     ; }
@label=Update_Actor_Branch
*$FBCB POP DE         ; {Move up one pixel row and loop back to #R$FBAB.
 $FBCC POP BC         ;
 $FBCD DEC B          ;
 $FBCE DEC E          ;
 $FBCF JR NZ,$FBAB    ;
 $FBD1 RET            ; }

; Unused
